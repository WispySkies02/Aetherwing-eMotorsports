---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import FaithSignature from '../../components/FaithSignature.astro';
import { wins, milestones, results } from '../../lib/site-content.mjs';
import '../../styles/records.css';
import { eventSlug } from '../../lib/schedule-events.mjs';
const compactEntries=(race)=>{const entries=race?.entries||[],featured=entries.filter(e=>e.featuredDriver);return (race.coverage==='team-only'?entries:featured.length?featured:entries).slice(0,3);};
---
<Base title="Team History" description="Aetherwing wins, milestones, and official results through the years."><PageIntro eyebrow="The record book" title="History" description="Every win has a place. Explore results, milestones, and the road from BellSouth to Aetherwing."/><section class="section"><div class="wrap story-grid"><article class="story-panel"><p class="eyebrow">Roots since 2015</p><h3>One lineage, several chapters</h3><p>Our racing roots reach back to the NASCAR 15 era and Silph Co. Motorsports, followed by BellSouth Racing in the NASCAR Heat era. The modern BellSouth eMotorsports NR2003 program began in late 2023. RoRacing and iRacing expansion followed in 2024, and the organization became Aetherwing eMotorsports in 2026.</p><a href="/news/aetherwing-launch-new-era/">Read the organization’s history →</a></article></div></section><section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">The latest</p><h2 class="section-title">Race Results</h2></div></div><div class="results-list" data-live-region="results" data-results-list>{results.map(r=><article><span>{r.date} · {r.leagueName}</span><h3>{r.title}</h3><p>{r.track}</p>{r.coverage==='team-only'&&<p class="mono muted">Official team result · team entries only</p>}{compactEntries(r).map(e=><strong>{e.number?`#${e.number} `:''}{e.driver} · {e.finish?`P${e.finish}`:'DNS'}</strong>)}<a href={`/event/${eventSlug(r)}/`}>Race result →</a>{r.sourceUrl&&<a href={r.sourceUrl}>Official recap →</a>}</article>)}</div></div></section><section class="section history-wins"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Checkered flags</p><h2 class="section-title">Win List</h2></div><strong>{wins.length} VERIFIED WINS</strong></div><div class="history-win-grid">{wins.map((w,i)=><div><b>{String(i+1).padStart(2,'0')}</b><span>{w.league}</span><strong>{w.driver}</strong><small>{w.track} · {w.date}</small></div>)}</div></div></section><section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Defining moments</p><h2 class="section-title">Milestones</h2></div></div><div class="story-grid">{milestones.map(m=><article class="story-panel"><small>{m.date}</small><h3>{m.title}</h3><p>{m.description}</p></article>)}</div></div></section><FaithSignature field="faithHistoryLine" label="Through every season" variant="closing"/></Base>
<script>
  import { eventSlug } from '../../lib/schedule-events.mjs';
  const applyLiveResults=(d)=>{if(!Array.isArray(d?.results))return;const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c]));const compact=(race)=>{const all=race?.entries||[],featured=all.filter(e=>e.featuredDriver);return (race.coverage==='team-only'?all:featured.length?featured:all).slice(0,3);};const root=document.querySelector('[data-results-list]');if(!root)return;root.innerHTML=[...d.results].sort((a,b)=>String(b.date||'').localeCompare(String(a.date||''))).map(r=>`<article><span>${esc(r.date)} · ${esc(r.leagueName)}</span><h3>${esc(r.title)}</h3><p>${esc(r.track)}</p>${r.coverage==='team-only'?'<p class="mono muted">Official team result · team entries only</p>':''}${compact(r).map(e=>`<strong>${e.number?`#${esc(e.number)} `:''}${esc(e.driver)} · ${e.finish?`P${esc(e.finish)}`:'DNS'}</strong>`).join('')}<a href="/event/${eventSlug(r)}/">Race result →</a>${r.sourceUrl?`<a href="${esc(r.sourceUrl)}">Official recap →</a>`:''}</article>`).join('');};
  window.addEventListener('aetherwing:content',({detail})=>applyLiveResults(detail));
  if(window.__AETHERWING_CONTENT__)applyLiveResults(window.__AETHERWING_CONTENT__);
</script>
