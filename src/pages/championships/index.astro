---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { standings, results } from '../../lib/site-content.mjs';
import '../../styles/records.css';

const manufacturerByNumber={
  nrrs:{
    '1':'Chevrolet','01':'Chevrolet','3':'Chevrolet','6':'Ford','7':'Chevrolet','07':'Chevrolet','8':'Chevrolet','9':'Cadillac','10':'Chevrolet','11':'Ford','13':'Toyota','14':'Ford','15':'Honda','16':'Chevrolet','17':'Ford','18':'Toyota','20':'Chevrolet','21':'Chevrolet','22':'Ford','27':'Ford','32':'Toyota','33':'Chevrolet','41':'Honda','43':'Toyota','45':'Ford','58':'Ford','60':'Ford','61':'Chevrolet','62':'Toyota','67':'Ford','71':'Chevrolet','77':'Chevrolet','94':'Chevrolet','99':'Ford'
  },
  kmart:{
    '0':'Chevrolet','05':'Chevrolet','1':'Chevrolet','5':'Chevrolet','9':'Chevrolet','10':'Chevrolet','13':'Toyota','15':'Dodge','16':'Chevrolet','18':'Toyota','20':'Toyota','21':'Chevrolet','24':'Dodge','26':'Chevrolet','29':'Dodge','34':'Dodge','45':'Chevrolet','48':'Chevrolet','50':'Toyota','51':'Toyota','54':'Toyota','55':'Toyota','56':'Toyota','61':'Chevrolet','88':'Chevrolet','91':'Chevrolet','97':'Chevrolet'
  }
};
const manufacturerIconPaths={
  chevrolet:'/images/manufacturers/chevrolet.png',ford:'/images/manufacturers/ford.png',toyota:'/images/manufacturers/toyota.png',
  'dodge-kmart':'/images/manufacturers/dodge-kmart.png','ram-sunoco':'/images/manufacturers/ram-sunoco.png',cadillac:'/images/manufacturers/cadillac.png',honda:'/images/manufacturers/honda.png'
};
const publicTeamHighlights={
  nrrs:new Set(['hailey','plarker']),
  kmart:new Set(['will','jaxon','wispy','eazy','clutch','matty']),
  sunoco:new Set(['wispy','clutch','will','eazy']),
  uarl:new Set(['rocky','wispy','burgertown','gk3r']),
  'uarl-d1':new Set(['rocky','wispy','burgertown','gk3r']),
  'uarl-open':new Set(['rocky','wispy','burgertown','gk3r'])
};
const normalizeDriver=(value='',league='')=>{
  let raw=String(value||'').toLowerCase().replace(/^@/,'').replace(/[^a-z0-9]/g,'');
  const aliases={aokikoto:'wispy',willsracingdesigns:'will',deadmansrisin27:'eazy',gostclutch24:'clutch',mattycampbell:'matty',arcticblitzzzz:'jaxon',burgerTown2good:'burgertown',uhhbzb:'burgertown',sealsntags:'gk3r'};
  raw=aliases[raw]||raw;
  if(['kmart','sunoco','uarl','uarl-d1','uarl-open'].includes(league)&&raw==='hailey')return 'wispy';
  if(league==='nrrs'&&raw==='wispy')return 'hailey';
  if(raw.startsWith('burgertown'))return 'burgertown';
  if(raw==='gk3r')return 'gk3r';
  return raw;
};
const isPublicTeamDriver=(board,row)=>publicTeamHighlights[board?.league]||publicTeamHighlights[board?.id]
  ? (publicTeamHighlights[board?.league]||publicTeamHighlights[board?.id]).has(normalizeDriver(row?.driver||row?.displayName||'',board?.league||board?.id||''))
  : false;
const leaguesMatch=(resultLeague,boardLeague)=>resultLeague===boardLeague||(boardLeague==='uarl'&&resultLeague==='uarl-d1');
const latestResultEntry=(board,row)=>{
  const league=board?.league||board?.id||'', key=normalizeDriver(row?.driver||row?.displayName||'',league);if(!key)return null;
  for(const race of [...results].filter(r=>leaguesMatch(r?.league,league)).sort((a,b)=>String(b?.date||'').localeCompare(String(a?.date||'')))){
    const entry=(race.entries||[]).find(candidate=>normalizeDriver(candidate?.driver||candidate?.displayName||'',league)===key);if(entry)return entry;
  }
  return null;
};
const manufacturerFor=(board,row,fallbackNumber='')=>{
  const latest=latestResultEntry(board,row);if(String(latest?.manufacturer||'').trim())return String(latest.manufacturer).trim();
  const map=manufacturerByNumber[board?.league]||manufacturerByNumber[board?.id]||{}, latestNumber=String(latest?.number||'').trim();
  if(latestNumber&&map[latestNumber])return map[latestNumber];if(String(row?.manufacturer||'').trim())return String(row.manufacturer).trim();
  return map[String(row?.number||fallbackNumber||'').trim()]||'';
};
const manufacturerKey=(board,value='')=>{const v=String(value||'').toLowerCase();if(v.includes('chev'))return'chevrolet';if(v.includes('ford'))return'ford';if(v.includes('toyota'))return'toyota';if(v.includes('cadillac'))return'cadillac';if(v.includes('honda'))return'honda';if(v.includes('ram')||v.includes('dodge'))return (board?.league||board?.id)==='sunoco'?'ram-sunoco':'dodge-kmart';return'';};
const manufacturerIcon=(board,row,fallbackNumber='')=>manufacturerIconPaths[manufacturerKey(board,manufacturerFor(board,row,fallbackNumber))]||'';
---
<Base title="Championship Battles" description="Current standings and title fights across Aetherwing programs.">
  <PageIntro eyebrow="The points picture" title="Championship Battles" description="Where the team stands and what remains on the line."/>
  <section class="section"><div class="wrap" data-standings-root>
    {standings.map(board=><article class="standings-board" data-board={board.id}>
      <header><span>{board.status||board.league}</span><h2>{board.title}</h2><p>{board.subtitle}</p>{board.pointsContext&&<p class="standings-context">{board.pointsContext}</p>}</header>
      <div class="standings-board__rows">
        {(board.rows||[]).length ? board.rows.map((row,index)=>{
          const icon=manufacturerIcon(board,row);
          return <>
            {board.cutoffAfter===index&&<div class="standings-cutoff">{board.cutoffLabel||'Chase cutoff'}</div>}
            <div class:list={['standing-row',{'is-team':isPublicTeamDriver(board,row),'is-unranked':row.unranked}]}> 
              <b>{row.position}</b><strong>{row.number?`#${row.number} · `:''}{row.driver}{row.note&&<em>{row.note}</em>}</strong>
              <span>{Number(row.points||0).toLocaleString('en-US')} PTS</span>
              <small>{row.delta||'—'}{row.positionChange&&row.positionChange!=='—'?` · ${row.positionChange}`:''}</small>
              <span class="standing-row__make">{icon&&<img src={icon} alt={manufacturerFor(board,row)} loading="lazy" />}</span>
            </div>
          </>;
        }) : <p class="no-records">{board.emptyMessage||'Standings will appear after official results are published.'}</p>}
      </div>
      {board.ptEntry?.drivers?.length>0&&<div class="standings-pt"><h3>{board.ptEntry.title||'Part-time drivers'}</h3><p>{board.ptEntry.status||'NOT CHASE ELIGIBLE'}</p><div>{board.ptEntry.drivers.map(entry=>{
        const icon=manufacturerIcon(board,entry,board.ptEntry.number);
        return <span class:list={['standings-pt__driver',{'is-team':isPublicTeamDriver(board,entry)}]}>{entry.driver} · {Number(entry.points||0).toLocaleString('en-US')} PTS{icon&&<img src={icon} alt={manufacturerFor(board,entry,board.ptEntry.number)} loading="lazy" />}</span>;
      })}</div></div>}
    </article>)}
  </div></section>
</Base>
<script>
  const manufacturerByNumber={
    nrrs:{'1':'Chevrolet','01':'Chevrolet','3':'Chevrolet','6':'Ford','7':'Chevrolet','07':'Chevrolet','8':'Chevrolet','9':'Cadillac','10':'Chevrolet','11':'Ford','13':'Toyota','14':'Ford','15':'Honda','16':'Chevrolet','17':'Ford','18':'Toyota','20':'Chevrolet','21':'Chevrolet','22':'Ford','27':'Ford','32':'Toyota','33':'Chevrolet','41':'Honda','43':'Toyota','45':'Ford','58':'Ford','60':'Ford','61':'Chevrolet','62':'Toyota','67':'Ford','71':'Chevrolet','77':'Chevrolet','94':'Chevrolet','99':'Ford'},
    kmart:{'0':'Chevrolet','05':'Chevrolet','1':'Chevrolet','5':'Chevrolet','9':'Chevrolet','10':'Chevrolet','13':'Toyota','15':'Dodge','16':'Chevrolet','18':'Toyota','20':'Toyota','21':'Chevrolet','24':'Dodge','26':'Chevrolet','29':'Dodge','34':'Dodge','45':'Chevrolet','48':'Chevrolet','50':'Toyota','51':'Toyota','54':'Toyota','55':'Toyota','56':'Toyota','61':'Chevrolet','88':'Chevrolet','91':'Chevrolet','97':'Chevrolet'}
  };
  const manufacturerIconPaths={chevrolet:'/images/manufacturers/chevrolet.png',ford:'/images/manufacturers/ford.png',toyota:'/images/manufacturers/toyota.png','dodge-kmart':'/images/manufacturers/dodge-kmart.png','ram-sunoco':'/images/manufacturers/ram-sunoco.png',cadillac:'/images/manufacturers/cadillac.png',honda:'/images/manufacturers/honda.png'};
  const publicTeamHighlights={nrrs:['hailey','plarker'],kmart:['will','jaxon','wispy','eazy','clutch','matty'],sunoco:['wispy','clutch','will','eazy'],uarl:['rocky','wispy','burgertown','gk3r'],'uarl-d1':['rocky','wispy','burgertown','gk3r'],'uarl-open':['rocky','wispy','burgertown','gk3r']};
  const norm=(value='',league='')=>{let raw=String(value||'').toLowerCase().replace(/^@/,'').replace(/[^a-z0-9]/g,'');const aliases={aokikoto:'wispy',willsracingdesigns:'will',deadmansrisin27:'eazy',gostclutch24:'clutch',mattycampbell:'matty',arcticblitzzzz:'jaxon',uhhbzb:'burgertown',sealsntags:'gk3r'};raw=aliases[raw]||raw;if(['kmart','sunoco','uarl','uarl-d1','uarl-open'].includes(league)&&raw==='hailey')return'wispy';if(league==='nrrs'&&raw==='wispy')return'hailey';if(raw.startsWith('burgertown'))return'burgertown';return raw;};
  const teamDriver=(board,row)=>{const league=board?.league||board?.id||'',set=publicTeamHighlights[league]||[];return set.includes(norm(row?.driver||row?.displayName||'',league));};
  const leagueMatch=(resultLeague,boardLeague)=>resultLeague===boardLeague||(boardLeague==='uarl'&&resultLeague==='uarl-d1');
  const latestEntry=(results,board,row)=>{const league=board?.league||board?.id||'',key=norm(row?.driver||row?.displayName||'',league);for(const race of [...(results||[])].filter(r=>leagueMatch(r?.league,league)).sort((a,b)=>String(b?.date||'').localeCompare(String(a?.date||'')))){const entry=(race.entries||[]).find(c=>norm(c?.driver||c?.displayName||'',league)===key);if(entry)return entry;}return null;};
  const makeFor=(results,board,row,fallbackNumber='')=>{const latest=latestEntry(results,board,row);if(String(latest?.manufacturer||'').trim())return String(latest.manufacturer).trim();const map=manufacturerByNumber[board?.league]||manufacturerByNumber[board?.id]||{},latestNumber=String(latest?.number||'').trim();if(latestNumber&&map[latestNumber])return map[latestNumber];if(String(row?.manufacturer||'').trim())return String(row.manufacturer).trim();return map[String(row?.number||fallbackNumber||'').trim()]||'';};
  const makeKey=(board,value='')=>{const v=String(value||'').toLowerCase();if(v.includes('chev'))return'chevrolet';if(v.includes('ford'))return'ford';if(v.includes('toyota'))return'toyota';if(v.includes('cadillac'))return'cadillac';if(v.includes('honda'))return'honda';if(v.includes('ram')||v.includes('dodge'))return (board?.league||board?.id)==='sunoco'?'ram-sunoco':'dodge-kmart';return'';};
  const makeIcon=(results,board,row,fallbackNumber='')=>{const make=makeFor(results,board,row,fallbackNumber),src=manufacturerIconPaths[makeKey(board,make)]||'';return src?`<span class="standing-row__make"><img src="${src}" alt="${esc(make)}" loading="lazy"></span>`:'<span class="standing-row__make"></span>';};
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  window.addEventListener('aetherwing:content',({detail:d})=>{
    if(!Array.isArray(d.standings))return;
    const root=document.querySelector('[data-standings-root]');if(!root)return;
    root.innerHTML=d.standings.map(board=>`<article class="standings-board" data-board="${esc(board.id)}">
      <header><span>${esc(board.status||board.league)}</span><h2>${esc(board.title)}</h2><p>${esc(board.subtitle)}</p>${board.pointsContext?`<p class="standings-context">${esc(board.pointsContext)}</p>`:''}</header>
      <div class="standings-board__rows">${(board.rows||[]).length?board.rows.map((row,index)=>`
        ${board.cutoffAfter===index?`<div class="standings-cutoff">${esc(board.cutoffLabel||'Chase cutoff')}</div>`:''}
        <div class="standing-row ${teamDriver(board,row)?'is-team':''} ${row.unranked?'is-unranked':''}"><b>${esc(row.position)}</b><strong>${row.number?'#'+esc(row.number)+' · ':''}${esc(row.driver)}${row.note?`<em>${esc(row.note)}</em>`:''}</strong><span>${Number(row.points||0).toLocaleString('en-US')} PTS</span><small>${esc(row.delta||'—')}${row.positionChange&&row.positionChange!=='—'?` · ${esc(row.positionChange)}`:''}</small>${makeIcon(d.results||[],board,row)}</div>`).join(''):`<p class="no-records">${esc(board.emptyMessage||'Standings will appear after official results are published.')}</p>`}</div>
      ${board.ptEntry?.drivers?.length?`<div class="standings-pt"><h3>${esc(board.ptEntry.title||'Part-time drivers')}</h3><p>${esc(board.ptEntry.status||'NOT CHASE ELIGIBLE')}</p><div>${board.ptEntry.drivers.map(entry=>{const make=makeFor(d.results||[],board,entry,board.ptEntry.number),src=manufacturerIconPaths[makeKey(board,make)]||'';return `<span class="standings-pt__driver ${teamDriver(board,entry)?'is-team':''}">${esc(entry.driver)} · ${Number(entry.points||0).toLocaleString('en-US')} PTS${src?`<img src="${src}" alt="${esc(make)}" loading="lazy">`:''}</span>`;}).join('')}</div></div>`:''}
    </article>`).join('');
  });
</script>
