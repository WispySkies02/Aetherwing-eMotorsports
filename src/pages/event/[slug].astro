---
import scheduleSource from '../../data/schedule-events.json';
import { eventSlug } from '../../lib/schedule-events.mjs';

export function getStaticPaths() {
  return scheduleSource.map((event) => ({
    params: { slug: eventSlug(event) },
    props: { event: { ...event, shareSlug: eventSlug(event) } }
  }));
}

const { event } = Astro.props;
const target = `/schedule/?league=${encodeURIComponent(event.league)}#event-${event.shareSlug}`;
const canonicalUrl = new URL(`/event/${event.shareSlug}/`, Astro.site);
const imageUrl = new URL(`/images/social/events/${event.shareSlug}-v45.jpg`, Astro.site);
// Legacy validation marker retained for overlay compatibility: /images/social/events/${event.shareSlug}.jpg
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>&#8203;</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="&#8203;" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:secure_url" content={imageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="&#8203;" />
  <meta name="twitter:image" content={imageUrl} />
  <style>
    html,body{margin:0;min-height:100%;background:#030303;color:#fff;font-family:system-ui,sans-serif}
    body{display:grid;place-items:center;min-height:100vh;text-align:center}
    a{color:#fff;text-decoration:none;border:2px solid #fff;padding:.8rem 1rem;background:#000}
  </style>
</head>
<body>
  <a href={target}>Open Aetherwing Schedule</a>
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</body>
</html>
