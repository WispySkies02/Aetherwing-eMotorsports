---
import Base from '../../layouts/Base.astro';
import { news } from '../../lib/site-content.mjs';
import '../../styles/records.css';
export function getStaticPaths(){return news.map(story=>({params:{slug:story.slug},props:{story}}));}
const {story}=Astro.props;
---
<Base title={story.title} description={story.summary}>
  <article class="news-article" data-news-story-root data-story-slug={story.slug}>
    <div class="wrap">
      <header class="news-article__hero">
        <a class="news-article__back" href="/news/">← Team Newsroom</a>
        <div class="news-article__meta">
          <p class="eyebrow">{story.category} · {story.date}</p>
          <span>{story.context}</span>
          <span>{story.byline || 'Aetherwing eMotorsports'}</span>
        </div>

        <div class:list={['news-article__hero-grid',{'has-mark':story.headlineMark?.value || story.heroGhost}]}>
          <div class="news-article__headline">
            <p class="news-article__kicker">{story.kicker}</p>
            <h1>{story.title}</h1>
            <p class="news-article__summary">{story.summary}</p>
          </div>

          {story.headlineMark?.value ? (
            <aside class="news-headline-mark" aria-label="Story headline marker">
              <small>{story.headlineMark.eyebrow || story.kicker}</small>
              <strong>{story.headlineMark.value}</strong>
              <span>{story.headlineMark.detail}</span>
            </aside>
          ) : story.heroGhost ? (
            <aside class="news-headline-ghost" aria-hidden="true">{story.heroGhost}</aside>
          ) : null}
        </div>

        {story.tags?.length>0 && (
          <div class="news-article__tags" aria-label="Story tags">
            {story.tags.map(tag=><span>{tag}</span>)}
          </div>
        )}
      </header>

      <div class="news-article__body">
        {story.metrics?.length>0&&(
          <section class="news-metrics" aria-label="Story quick facts">
            {story.metrics.map(m=><div><b class:list={['news-metric__value',{'is-long':String(m.value || '').length > 8}]}>{m.value}</b><small>{m.label}</small></div>)}
          </section>
        )}

        {story.programBreakdown?.length>0&&(
          <section class="news-programs" aria-label="Season 4 program breakdown">
            <header><span>SEASON 4 PROGRAMS</span><h2>How the NRRS Lineup Splits</h2></header>
            <div class="news-programs__grid">
              {story.programBreakdown.map(program=><article>
                <small>{program.eyebrow}</small>
                <div class="news-programs__number">{program.number}</div>
                <h3>{program.title}</h3>
                <p>{program.detail}</p>
                {program.items?.length>0&&<ul>{program.items.map(item=><li>{item}</li>)}</ul>}
              </article>)}
            </div>
          </section>
        )}

        {story.quote?.text&&(
          <blockquote class="news-pullquote">
            “{story.quote.text}”
            <cite>{story.quote.attribution}</cite>
          </blockquote>
        )}

        {story.timeline?.length>0&&(
          <section class="news-timeline" aria-label="Story timeline">
            <header><span>THE TIMELINE</span><h2>How We Got Here</h2></header>
            <div class="news-timeline__rail">
              {story.timeline.map((item,index)=><article>
                <b>{String(index+1).padStart(2,'0')}</b>
                <div>
                  <small>{item.series}{item.season?` · ${item.season}`:''}</small>
                  <h3>{item.title}</h3>
                  <p>{item.method}</p>
                  <time>{item.date}</time>
                </div>
              </article>)}
            </div>
          </section>
        )}

        <div class="news-article__sections">
          {story.sections?.map((section,index)=><section>
            <div class="news-section-index" aria-hidden="true">{String(index+1).padStart(2,'0')}</div>
            <div>
              <h2>{section.heading}</h2>
              {section.paragraphs?.map(paragraph=><p>{paragraph}</p>)}
            </div>
          </section>)}
        </div>

        {story.callout?.title&&(
          <aside class="news-callout">
            <small>{story.callout.label || 'Team Wire'}</small>
            <h2>{story.callout.title}</h2>
            <p>{story.callout.text}</p>
          </aside>
        )}
      </div>
    </div>
  </article>
</Base>

<script>
  (()=>{
    const root=document.querySelector('[data-news-story-root]');
    if(!root)return;
    const slug=root.dataset.storySlug||'';
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const storyHtml=(s)=>{
      const mark=s.headlineMark?.value
        ? `<aside class="news-headline-mark" aria-label="Story headline marker"><small>${esc(s.headlineMark.eyebrow||s.kicker)}</small><strong>${esc(s.headlineMark.value)}</strong><span>${esc(s.headlineMark.detail)}</span></aside>`
        : s.heroGhost ? `<aside class="news-headline-ghost" aria-hidden="true">${esc(s.heroGhost)}</aside>` : '';
      const tags=(s.tags||[]).length?`<div class="news-article__tags" aria-label="Story tags">${s.tags.map(tag=>`<span>${esc(tag)}</span>`).join('')}</div>`:'';
      const metrics=(s.metrics||[]).length?`<section class="news-metrics" aria-label="Story quick facts">${s.metrics.map(m=>`<div><b class="news-metric__value ${String(m.value||'').length>8?'is-long':''}">${esc(m.value)}</b><small>${esc(m.label)}</small></div>`).join('')}</section>`:'';
      const programs=(s.programBreakdown||[]).length?`<section class="news-programs" aria-label="Season 4 program breakdown"><header><span>SEASON 4 PROGRAMS</span><h2>How the NRRS Lineup Splits</h2></header><div class="news-programs__grid">${s.programBreakdown.map(program=>`<article><small>${esc(program.eyebrow)}</small><div class="news-programs__number">${esc(program.number)}</div><h3>${esc(program.title)}</h3><p>${esc(program.detail)}</p>${(program.items||[]).length?`<ul>${program.items.map(item=>`<li>${esc(item)}</li>`).join('')}</ul>`:''}</article>`).join('')}</div></section>`:'';
      const quote=s.quote?.text?`<blockquote class="news-pullquote">“${esc(s.quote.text)}”<cite>${esc(s.quote.attribution)}</cite></blockquote>`:'';
      const timeline=(s.timeline||[]).length?`<section class="news-timeline" aria-label="Story timeline"><header><span>THE TIMELINE</span><h2>How We Got Here</h2></header><div class="news-timeline__rail">${s.timeline.map((item,index)=>`<article><b>${String(index+1).padStart(2,'0')}</b><div><small>${esc(item.series)}${item.season?` · ${esc(item.season)}`:''}</small><h3>${esc(item.title)}</h3><p>${esc(item.method)}</p><time>${esc(item.date)}</time></div></article>`).join('')}</div></section>`:'';
      const sections=`<div class="news-article__sections">${(s.sections||[]).map((section,index)=>`<section><div class="news-section-index" aria-hidden="true">${String(index+1).padStart(2,'0')}</div><div><h2>${esc(section.heading)}</h2>${(section.paragraphs||[]).map(paragraph=>`<p>${esc(paragraph)}</p>`).join('')}</div></section>`).join('')}</div>`;
      const callout=s.callout?.title?`<aside class="news-callout"><small>${esc(s.callout.label||'Team Wire')}</small><h2>${esc(s.callout.title)}</h2><p>${esc(s.callout.text)}</p></aside>`:'';
      return `<div class="wrap"><header class="news-article__hero"><a class="news-article__back" href="/news/">← Team Newsroom</a><div class="news-article__meta"><p class="eyebrow">${esc(s.category)} · ${esc(s.date)}</p><span>${esc(s.context)}</span><span>${esc(s.byline||'Aetherwing eMotorsports')}</span></div><div class="news-article__hero-grid ${(s.headlineMark?.value||s.heroGhost)?'has-mark':''}"><div class="news-article__headline"><p class="news-article__kicker">${esc(s.kicker)}</p><h1>${esc(s.title)}</h1><p class="news-article__summary">${esc(s.summary)}</p></div>${mark}</div>${tags}</header><div class="news-article__body">${metrics}${programs}${quote}${timeline}${sections}${callout}</div></div>`;
    };
    const apply=(datasets)=>{
      const live=(datasets?.news||[]).find((item)=>item?.slug===slug);
      if(!live)return;
      root.innerHTML=storyHtml(live);
      document.title=`${live.title} | Aetherwing eMotorsports`;
      const description=document.querySelector('meta[name="description"]'); if(description)description.setAttribute('content',live.summary||'');
      const ogTitle=document.querySelector('meta[property="og:title"]'); if(ogTitle)ogTitle.setAttribute('content',document.title);
      const ogDescription=document.querySelector('meta[property="og:description"]'); if(ogDescription)ogDescription.setAttribute('content',live.summary||'');
    };
    window.addEventListener('aetherwing:content',(event)=>apply(event.detail));
    if(window.__AETHERWING_CONTENT__)apply(window.__AETHERWING_CONTENT__);
  })();
</script>
