---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Paint Booth Moved"
  description="The Aetherwing Paint Booth now lives at paint.aetherwing.net."
  canonical="https://paint.aetherwing.net/"
  noindex={true}
>
  <section class="section">
    <div class="shell">
      <p class="eyebrow">Paint Facility Routing</p>
      <h1 class="section-title">THE PAINT BOOTH HAS ITS OWN FACILITY.</h1>
      <p class="lede">You’re being sent to the full interactive Paint Booth at <strong>paint.aetherwing.net</strong>.</p>
      <p><a class="button button-primary" href="https://paint.aetherwing.net/">OPEN THE PAINT BOOTH</a></p>
    </div>
  </section>
</BaseLayout>
<script is:inline>
(() => {
  const prefix = '#paint-';
  let target = 'https://paint.aetherwing.net/';
  if (location.hash.startsWith(prefix)) {
    const slug = decodeURIComponent(location.hash.slice(prefix.length));
    if (/^[a-z0-9-]+$/i.test(slug)) target += `${encodeURIComponent(slug)}/`;
  }
  location.replace(target);
})();
</script>
