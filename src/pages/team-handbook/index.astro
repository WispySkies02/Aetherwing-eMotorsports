---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import leadership from '../../data/leadership.json';
import competitions from '../../data/competitions.json';
import '../../styles/pages/editorial-pages.css';
const standards=[
 ['01','Communicate Early','Availability, paint needs, roster issues, league changes, and conflicts should be brought up before race day whenever possible.'],
 ['02','Race With Respect','Hard racing is expected. Careless driving, repeated avoidable incidents, and unnecessary drama are not.'],
 ['03','Protect the Brand','Graphics, cars, posts, and public wording should feel intentional and consistent.'],
 ['04','Own Your Results','Good race or bad race, handle it cleanly. Learn from mistakes and move forward without dragging the team into chaos.'],
 ['05','Keep Assets Clean','Numbers, sponsors, logos, screenshots, and liveries should be readable, properly placed, and finished.'],
 ['06','Team First','Drivers, designers, coordinators, and leadership should pull in the same direction.']
];
const raceWeek=[
 ['Step 01 / Before Race Week','Confirm lineup and availability.','Know who is full-time, part-time, unavailable, or waiting on approval.'],
 ['Step 02 / Paint & Graphics','Lock the scheme direction early.','Handle sponsor, number, base design, and special-event ideas before race night.'],
 ['Step 03 / Pre-Race','Show up ready.','Correct car, number, sponsor look, and league information should already be set.'],
 ['Step 04 / During Race','Race smart and keep comms useful.','Keep communication focused on useful information instead of turning race channels into frustration dumps.'],
 ['Step 05 / Post-Race','Send results and notes.','Share finishing position, points, screenshots, and anything needed for stats or web updates.'],
 ['Step 06 / Review','Fix the process, then move on.','Review mistakes without dragging them forever. Better execution next race is the goal.']
];
---
<BaseLayout title="Team Handbook" description="The working standard for Aetherwing race weeks, team communication, driver expectations, brand presentation, and competition relationships.">
  <PageHero eyebrow="2026 Current Handbook" title="Team Handbook" description="Standards. Operations. Identity. The working standard for how Aetherwing operates across race weeks, team communication, visual branding, driver expectations, Aetherwing programs, and alliance-series competition." ghost="STANDARD" />
  <section class="section section--tight aw-editorial-page"><div class="shell">
    <div class="stat-rail"><div class="stat"><strong>05</strong><span>Aetherwing Programs</span></div><div class="stat"><strong>02</strong><span>Alliance Series</span></div><div class="stat"><strong>07</strong><span>Competition Relationships</span></div><div class="stat"><strong>2026</strong><span>Current Handbook</span></div></div>
    <nav class="aw-handbook-nav" aria-label="Handbook sections"><a href="#read-first">Read First</a><a href="#standards">Core Standards</a><a href="#drivers">Driver Rules</a><a href="#race-week">Race Week</a><a href="#competition">Competition</a><a href="#brand">Brand Rules</a><a href="#contact-chain">Contact Chain</a></nav>

    <section id="read-first" class="aw-handbook-section aw-read-first"><span class="aw-paper-label">Start Here</span><h2>Represent the team like the car has your name on it.</h2><p>Aetherwing is built around competition, branding, and team presence. Race with awareness, communicate clearly, respect the series, and help keep the public identity sharp.</p><div class="aw-priority-strip"><div><span>Priority One</span><strong>Do not make the team harder to manage on race day.</strong></div><div><span>Priority Two</span><strong>Keep sponsor, number, and team visuals clean.</strong></div><div><span>Priority Three</span><strong>Bring issues up early, not after they explode.</strong></div></div></section>

    <section id="standards" class="aw-handbook-section"><div class="section-head"><div><p class="eyebrow">Team Code</p><h2 class="section-title">Core Standards</h2></div><p class="lede">These standards apply everywhere: Roblox RoRacing, iRacing, graphics, public posts, and team communication.</p></div><div class="aw-rule-list">{standards.map((rule,index)=><details open={index<2}><summary><span>{rule[0]}</span><h3>{rule[1]}</h3></summary><p>{rule[2]}</p></details>)}</div></section>

    <section id="drivers" class="aw-handbook-section"><div class="section-head"><div><p class="eyebrow">Driver Expectations</p><h2 class="section-title">Driver Rules</h2></div></div><div class="aw-brand-rules"><article class="aw-brand-rule"><h3>Race hard, not reckless.</h3><p>Aggressive racing is fine when it is controlled. Repeated careless moves, avoidable wrecks, and retaliation hurt the whole team.</p></article><article class="aw-brand-rule"><h3>Say something early.</h3><p>Missed races, late arrivals, paint issues, disputes, and uncertainty should be communicated before they become race-night problems.</p></article><article class="aw-brand-rule"><h3>Confirm your status.</h3><p>Make it clear whether you are racing, part-time, unavailable, or waiting on confirmation.</p></article><article class="aw-brand-rule"><h3>Keep public behavior clean.</h3><p>Keep unnecessary arguments and league conflict away from team-branded spaces.</p></article><article class="aw-brand-rule"><h3>Use the assigned assets.</h3><p>Entries should match the correct car, number, sponsor direction, and program unless leadership approves a change.</p></article><article class="aw-brand-rule"><h3>Send results when needed.</h3><p>Finishing positions, screenshots, points, and race notes help keep stats and the website accurate.</p></article></div></section>

    <section id="race-week" class="aw-handbook-section"><div class="section-head"><div><p class="eyebrow">Operations</p><h2 class="section-title">Race Week Protocol</h2></div><p class="lede">Race weeks should feel planned, not improvised.</p></div><div class="aw-race-week">{raceWeek.map((step)=><article class="aw-race-step"><span>{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></article>)}</div></section>

    <section id="competition" class="aw-handbook-section"><div class="section-head"><div><p class="eyebrow">Competition Relationships</p><h2 class="section-title">Competition Standards</h2></div><p class="lede">Keep manufacturer labels, driver assignments, and banners accurate—especially where StarClutch Racing is the competing organization.</p></div><div class="aw-competition-accordion">{competitions.map((competition)=><details class:list={[{'is-alliance':competition.type==='alliance'}]}><summary><strong>{competition.name}</strong><span>{competition.label}</span></summary><div><p><b>{competition.machine}</b> · {competition.platform}</p><p>{competition.type==='alliance'?'Keep StarClutch Racing identity and alliance attribution clear on entries, results, and paint records.':'Keep current driver numbers, entry status, race information, and program-specific data accurate.'}</p></div></details>)}</div></section>

    <section id="brand" class="aw-handbook-section"><div class="section-head"><div><p class="eyebrow">Visual Identity</p><h2 class="section-title">Brand Rules</h2></div><p class="lede">The team should feel consistent whether it appears on the website, a car, a race graphic, or an announcement.</p></div><div class="aw-brand-rules"><article class="aw-brand-rule"><h3>Website Style</h3><p>Editorial-grunge racing system: black/charcoal foundations, distressed paper texture, red, blue, gold, off-white accents, Edo-inspired display type, and readable body copy.</p><ul><li>No rounded glass-style card soup.</li><li>Use torn-paper, tape, paint, halftone, and photocopy details with purpose.</li><li>Aggressive display type never gets to kill readability.</li></ul></article><article class="aw-brand-rule"><h3>Sponsor & Partner Use</h3><p>Logos should be readable, accurately labeled, and treated like real brand assets.</p><ul><li>Do not stretch logos.</li><li>Do not present livery-only brands as Partner Network companies.</li><li>Keep StarClutch competition alliances separate from the Partner Network.</li></ul></article><article class="aw-brand-rule"><h3>Records</h3><p>Only confirmed stats, wins, and history should be shown publicly.</p><ul><li>Aetherwing-banner wins go on Wins & History.</li><li>StarClutch alliance results stay attributed to StarClutch.</li><li>Vague history stays private until it is cleaned up.</li></ul></article></div></section>

    <section id="contact-chain" class="aw-handbook-section"><div class="section-head"><div><p class="eyebrow">Communication</p><h2 class="section-title">Contact Chain</h2></div><p class="lede">Use the right person for the right issue so problems do not bounce around aimlessly.</p></div><div class="aw-contact-chain">{leadership.map((person)=><article class="panel aw-contact-person"><h3>{person.name}</h3><b>{person.roles.join(' / ')}</b><p>{person.name==='Wispy'?'Major team direction, website content, brand presentation, RoRacing, sim racing, and high-level roster questions.':person.name==='Callornot'?'Team operations, competitive structure, general logistics, and sim-racing coordination.':person.name==='Will'?'Liveries, design assets, graphic direction, and Aetherwing creative presentation.':'Race photography, media assets, production support, and race-week storytelling.'}</p></article>)}</div></section>
  </div></section>
</BaseLayout>
