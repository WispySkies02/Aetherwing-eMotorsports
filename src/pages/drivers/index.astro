---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { rosterProfiles as roster } from "../../lib/site-content.mjs";
import { iracingGarage as iracing } from "../../lib/site-content.mjs";
import { driverProfiles as profiles } from "../../lib/site-content.mjs";
import { drivers as driverEntries } from "../../lib/site-content.mjs";
import { charters as charters } from "../../lib/site-content.mjs";
import '../../styles/pages/drivers.css';
const selected=roster[0];
const wispyStats=profiles[0].stats;
const numberParts=(value)=>String(value||'').split('/').map((part)=>part.trim().replace(/^#/, '')).filter(Boolean);
const formatNumbers=(value)=>numberParts(value).map((part)=>`#${part}`).join(' / ');
const rosterDisplay=roster.map((driver)=>({...driver,numberParts:numberParts(driver.numbers)}));
---
<BaseLayout title="Drivers" description="Current Aetherwing drivers, iRacing Factory entries, and StarClutch Racing alliance participants.">
  <PageHero eyebrow="2026 Season Roster" title="Aetherwing Drivers" description="Current Aetherwing drivers, iRacing Factory entries, and StarClutch Racing alliance participants. Pick a driver and the profile stage updates in place." ghost="ROSTER" />
  <section class="section section--tight aw-driver-hub">
    <div class="shell">
      <div class="aw-roster-stats stat-rail">
        <div class="stat"><strong>{roster.length}</strong><span>Active RoRacing Drivers</span></div>
        <div class="stat"><strong>6</strong><span>Competition Relationships</span></div>
        <div class="stat"><strong>{iracing.factoryDrivers}</strong><span>iRacing Factory Entries</span></div>
        <div class="stat"><strong>{roster.filter((d)=>d.affiliation==='aetherwing').length} / {roster.filter((d)=>d.affiliation==='alliance').length}</strong><span>Aetherwing / Alliance-Only</span></div>
      </div>
      <section class="aw-charter-board" aria-labelledby="charter-board-title">
        <div class="aw-charter-board__head">
          <div><span class="eyebrow">2026 Charter Allocation</span><h2 id="charter-board-title">Aetherwing Charter Board</h2></div>
          <p>Current allocations are shown by program. Full-time seats and flexible Open Charters are maintained from Aetherwing Admin. An Open Charter is one actual charter slot even when it has multiple possible number identities or uses.</p>
        </div>
        <div class="aw-charter-grid">
          {charters.map((group)=><article class="aw-charter-card" data-charter-group={group.id}>
            <div class="aw-charter-card__title"><span>{group.seriesNote}</span><h3>{group.label}</h3></div>
            <div class="aw-charter-slots" aria-label={`${group.label} charter slots`}>
              {group.fullTime.map((entry,index)=><div class:list={["aw-charter-slot","aw-charter-slot--ft",{"is-open":entry.driver==="Open"}]} data-charter-slot>
                <span class="aw-charter-slot__index">FT {String(index+1).padStart(2,'0')}</span>
                <b>#{entry.number}</b>
                <small>{entry.driver}</small>
              </div>)}
              {(group.openCharters ?? []).filter((charter)=>charter.active !== false).map((charter,charterIndex)=>{
                const uses=(charter.uses ?? []).filter((use)=>use.active !== false);
                const first=uses[0];
                if(!first)return null;
                return <div class="aw-open-charter" data-open-charter data-charter-slot data-active-mode="0">
                  <div class="aw-open-charter__head">
                    <div><span class="aw-charter-slot__index">{charter.slotLabel || `OPEN ${String(charterIndex+1).padStart(2,'0')}`}</span><strong>{charter.label || 'Open Charter'}</strong></div>
                    <small>One charter slot · {uses.length} {uses.length===1?'use':'uses'}</small>
                  </div>
                  <div class="aw-open-charter__tabs" role="tablist" aria-label={`${group.label} ${charter.label || 'Open Charter'} use`} style={`--use-count:${uses.length};--active-index:0`}>
                    {uses.map((use,useIndex)=><button type="button" role="tab" aria-selected={useIndex===0?'true':'false'} tabindex={useIndex===0?'0':'-1'} data-charter-mode={String(useIndex)} data-number={use.number} data-role={use.label} data-description={use.description}>
                      <span>#{use.number}</span><small>{use.label}</small>
                    </button>)}
                    <i class="aw-open-charter__switch-line" aria-hidden="true"></i>
                  </div>
                  <div class="aw-open-charter__panel" role="tabpanel" tabindex="0" data-charter-panel>
                    <b data-charter-number>#{first.number}</b>
                    <div><strong data-charter-role>{first.label}</strong><p data-charter-description>{first.description}</p></div>
                  </div>
                </div>;
              })}            </div>
          </article>)}
        </div>
      </section>
      <div class="aw-driver-toolbar" data-driver-toolbar>
        <div><span>Roster View</span><strong data-driver-count>{roster.length} shown</strong></div>
        <div class="aw-driver-filters" role="group" aria-label="Filter drivers">
          <button type="button" class="is-active" data-filter="all">All</button>
          <button type="button" data-filter="aetherwing">Aetherwing</button>
          <button type="button" data-filter="NRRS">NRRS</button>
          <button type="button" data-filter="UARL D1">UARL D1</button>
          <button type="button" data-filter="UARL Open">UARL Open</button>
          <button type="button" class="is-alliance" data-filter="Kmart">Kmart</button>
          <button type="button" class="is-alliance" data-filter="Sunoco">Sunoco</button>
        </div>
      </div>

      <div class="aw-driver-browser" data-driver-browser>
        <div class="aw-driver-cards" role="listbox" aria-label="Driver roster">
          {rosterDisplay.map((driver,index)=>(
            <button type="button" role="option" aria-selected={index===0?'true':'false'}
              class:list={['aw-flip-card',{'is-alliance':driver.affiliation==='alliance','is-selected':index===0}]}
              data-slug={driver.slug} data-affiliation={driver.affiliation} data-programs={driver.programs.join('|')}>
              <div class="aw-flip-inner">
                <div class="aw-flip-front" data-ghost-num={driver.numberParts[0]??''}>
                  <div class:list={['aw-driver-num',{'is-multi':driver.numberParts.length>1}]}>
                    {driver.numberParts.map(num=><b>#{num}</b>)}
                  </div>
                  <strong class="aw-flip-name">{driver.name}</strong>
                  <small class="aw-flip-role">{driver.role}</small>
                  <span class="aw-flip-hint">Tap to flip</span>
                </div>
                <div class="aw-flip-back">
                  <p class="aw-flip-bio">{driver.bio}</p>
                  <div class="aw-flip-programs">{driver.programs.map(p=><span>{p}</span>)}</div>
                  {driver.handle && <small class="aw-flip-handle">{driver.handle}</small>}
                  <span class="aw-flip-hint">Tap for detail →</span>
                </div>
              </div>
            </button>
          ))}
        </div>
        <article class="aw-driver-stage panel" data-driver-stage>
          <div class="aw-driver-stage__ghost" aria-hidden="true">{formatNumbers(selected.numbers)}</div>
          <div class="aw-driver-stage__meta"><span class="tag">{selected.role}</span><span class="tag tag--gold">{selected.feature}</span></div>
          <h2>{selected.name}</h2>
          <p class="aw-driver-handle">{selected.handle}</p>
          <p>{selected.bio}</p>
          <div class="aw-driver-programs">{selected.programs.map((program)=><span>{program}</span>)}</div>
          <div class="aw-driver-stage__footer"><span>Active numbers</span><strong>{formatNumbers(selected.numbers)}</strong></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section aw-wispy-stats" data-brush="FACTORY DATA">
    <div class="shell shell--standard">
      <div class="section-head"><div><p class="eyebrow">Hailey Bell</p><h2 class="section-title">iRacing Career Snapshot</h2></div><p class="lede">Current iRacing identity: Hailey Bell. Historical results originally recorded under Nicholas Waggoner retain that historical attribution.</p></div>
      <div class="aw-iracing-stat-grid">{wispyStats.map((stat)=><div><span>{stat.label}</span><strong>{stat.value}</strong></div>)}</div>
      <p class="aw-formula-note"><b>{wispyStats.find((stat)=>stat.label==='Formula Win Rate')?.value ?? '—'} Formula win rate</b> refers specifically to Formula-category iRacing competition.</p>
    </div>
  </section>

  <section class="section aw-factory-roster">
    <div class="shell shell--standard">
      <div class="section-head"><div><p class="eyebrow">iRacing Factory Program</p><h2 class="section-title">{String(iracing.factoryDrivers).padStart(2,'0')} Factory Entries</h2></div><p class="lede">The garage uses Hailey Bell for current iRacing presentation. Historical results recorded under Nicholas Waggoner remain attributed to that historical name.</p></div>
      <div class="aw-factory-grid">
        {iracing.entries.filter((entry)=>entry.driver!=='Aetherwing Endurance Team').map((entry)=><article class="panel"><span>#{entry.number}</span><h3>{entry.driver}</h3><p>Aetherwing Factory Program</p></article>)}
      </div>
    </div>
  </section>
</BaseLayout>
<script define:vars={{ roster, driverEntries }}>
  document.querySelectorAll('[data-open-charter]').forEach((module)=>{
    if(!(module instanceof HTMLElement))return;
    const tabs=Array.from(module.querySelectorAll('[role="tab"]'));
    const number=module.querySelector('[data-charter-number]');
    const role=module.querySelector('[data-charter-role]');
    const description=module.querySelector('[data-charter-description]');
    const select=(tab,focus=false)=>{
      if(!(tab instanceof HTMLButtonElement))return;
      tabs.forEach((item)=>{if(item instanceof HTMLButtonElement){const active=item===tab;item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;}});
      module.dataset.activeMode=tab.dataset.charterMode||'0';
      const tabsNode=module.querySelector('.aw-open-charter__tabs');
      if(tabsNode instanceof HTMLElement)tabsNode.style.setProperty('--active-index',String(Math.max(0,tabs.indexOf(tab))));
      if(number)number.textContent=`#${tab.dataset.number||''}`;
      if(role)role.textContent=tab.dataset.role||'';
      if(description)description.textContent=tab.dataset.description||'';
      if(focus)tab.focus();
    };
    tabs.forEach((tab,index)=>{
      if(!(tab instanceof HTMLButtonElement))return;
      tab.addEventListener('click',()=>select(tab));
      tab.addEventListener('keydown',(event)=>{
        let next=index;
        if(event.key==='ArrowRight'||event.key==='ArrowDown')next=(index+1)%tabs.length;
        else if(event.key==='ArrowLeft'||event.key==='ArrowUp')next=(index-1+tabs.length)%tabs.length;
        else if(event.key==='Home')next=0;
        else if(event.key==='End')next=tabs.length-1;
        else return;
        event.preventDefault();
        select(tabs[next],true);
      });
    });
  });

  const browser=document.querySelector('[data-driver-browser]');
  const toolbar=document.querySelector('[data-driver-toolbar]');
  const count=document.querySelector('[data-driver-count]');
  if(browser){
    const list=browser.querySelector('.aw-driver-cards');
    const stage=browser.querySelector('[data-driver-stage]');
    const options=Array.from(browser.querySelectorAll('[role="option"]'));
    const formatNumbers=(value)=>String(value||'').split('/').map(part=>part.trim()).filter(Boolean).map(part=>`#${part.replace(/^#/, '')}`).join(' / ');
    const competitionIdByFilter={'NRRS':'nrrs','UARL D1':'uarl-d1','UARL Open':'uarl-open','Kmart':'kmart','Sunoco':'sunoco'};
    let activeRosterFilter='all';
    const numbersFor=(driver,filter=activeRosterFilter)=>{const competitionId=competitionIdByFilter[filter];if(competitionId){const entry=driverEntries.find(item=>item.profile===driver.slug&&item.competitionId===competitionId);if(entry?.number)return `#${entry.number}`;}return formatNumbers(driver.numbers);};
    const renderOptionNumber=(option,driver)=>{const node=option.querySelector('.aw-driver-num');if(!(node instanceof HTMLElement)||!driver)return;const parts=numbersFor(driver).split(' / ').filter(Boolean);node.classList.toggle('is-multi',parts.length>1);node.innerHTML=parts.map(part=>`<b>${part}</b>`).join('');};
    const render=(driver)=>{if(!(stage instanceof HTMLElement)||!driver)return;const alliance=driver.affiliation==='alliance';const numbers=numbersFor(driver);stage.classList.toggle('panel--alliance',alliance);stage.innerHTML=`<div class="aw-driver-stage__ghost" aria-hidden="true">${numbers}</div><div class="aw-driver-stage__meta"><span class="tag ${alliance?'tag--alliance':''}">${driver.role}</span><span class="tag tag--gold">${driver.feature}</span></div><h2>${driver.name}</h2><p class="aw-driver-handle">${driver.handle||''}</p><p>${driver.bio}</p><div class="aw-driver-programs">${driver.programs.map(p=>`<span>${p}</span>`).join('')}</div><div class="aw-driver-stage__footer"><span>${competitionIdByFilter[activeRosterFilter]?'Series number':'Active numbers'}</span><strong>${numbers}</strong></div>`;};
    options.forEach(option=>option.addEventListener('click',()=>{
      const wasSelected=option.getAttribute('aria-selected')==='true';
      options.forEach(o=>{o.setAttribute('aria-selected','false');o.classList.remove('is-selected','is-flipped');});
      option.setAttribute('aria-selected','true');
      option.classList.add('is-selected');
      // Flip: first tap flips, second tap (already selected) re-flips back
      if(!wasSelected){option.classList.add('is-flipped');}
      render(roster.find(d=>d.slug===option.dataset.slug));
    }));
    toolbar?.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{
      if(!(button instanceof HTMLButtonElement))return;toolbar.querySelectorAll('[data-filter]').forEach(b=>b.classList.remove('is-active'));button.classList.add('is-active');const filter=button.dataset.filter||'all';activeRosterFilter=filter;let shown=0;let first=null;options.forEach(option=>{const programs=(option.dataset.programs||'').split('|');const driver=roster.find(d=>d.slug===option.dataset.slug);const show=filter==='all'||option.dataset.affiliation===filter||programs.includes(filter);option.hidden=!show;renderOptionNumber(option,driver);if(show){shown++;if(!first)first=option;}});if(count)count.textContent=`${shown} shown`;if(first instanceof HTMLButtonElement){options.forEach(o=>o.setAttribute('aria-selected','false'));first.setAttribute('aria-selected','true');render(roster.find(d=>d.slug===first.dataset.slug));}options.forEach(o=>o.classList.remove('is-flipped'));if(list instanceof HTMLElement)list.scrollTo({top:0,behavior:'smooth'});
    }));
  }
</script>
