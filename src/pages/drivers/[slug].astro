---
import Base from '../../layouts/Base.astro';
import { rosterProfiles, driverProfiles, drivers, driverPortfolios, wins, milestones } from '../../lib/site-content.mjs';
import '../../styles/records.css';
export function getStaticPaths(){return rosterProfiles.map(person=>({params:{slug:person.slug},props:{person}}));}
const {person}=Astro.props;
const assignments=drivers.filter(d=>d.profile===person.slug);
const profile=driverProfiles.find(p=>p.slug===person.slug);
const portfolio=driverPortfolios.find(p=>p.profile===person.slug);
const orderedBrands=[...(portfolio?.brands||[])].sort((a,b)=>(a.order||0)-(b.order||0));
const achievements=milestones.filter(m=>m.assignmentId&&assignments.some(a=>a.id===m.assignmentId));
const victories=wins.filter(w=>assignments.some(a=>a.id===w.assignmentId));
---
<Base title={person.name} description={person.bio}>
  <section class="profile-hero" data-profile-page data-profile-slug={person.slug}><div class="wrap"><a href="/drivers/">← Driver lineup</a><span>{person.affiliation==='alliance'?'ALLIANCE DRIVER':'AETHERWING DRIVER'}</span><div class="profile-hero__body"><div><h1 data-profile-name>{person.name}</h1><p data-profile-identity>{person.handle} · {person.role}</p><p data-profile-bio>{person.bio}</p></div><div class="profile-hero__number" data-profile-number>{assignments[0]?.numberImage?<img src={assignments[0].numberImage} alt={`Number ${assignments[0].number}`} />:`#${assignments[0]?.number||person.numbers.split(' / ')[0]}`}</div></div></div></section>
  <section class="section"><div class="wrap profile-grid"><article class="story-panel"><p class="eyebrow">Current campaign</p><h3>Racing programs</h3><div data-profile-assignments>{assignments.map(a=><div class="profile-assignment"><span>{a.competition}</span><strong>#{a.number}</strong><small>{a.status}{a.affiliation==='alliance'?' · STARCLUTCH RACING':''}</small></div>)}</div></article><article class="story-panel"><p class="eyebrow">Career</p><h3>Record</h3><div data-profile-stats>{profile?.stats?.length?profile.stats.map(s=><div class="profile-stat"><span>{s.label}</span><strong>{s.value}</strong></div>):<p>Career statistics will be added as official records become available.</p>}</div>{victories.length>0&&<p>{victories.length} verified wins in the Aetherwing record book.</p>}</article></div></section>
  <section class="section" data-profile-partners-section hidden={orderedBrands.length===0}><div class="wrap"><div class="section-head"><div><p class="eyebrow">Driver identity</p><h2 class="section-title">Personal Partners</h2></div><a href="/partners/">All partners ↗</a></div><div class="profile-partners" data-profile-partners>{orderedBrands.map(b=><div>{b.logo?<img src={b.logo} alt={b.name} loading="lazy"/>:<strong>{b.name}</strong>}</div>)}</div></div></section>
  {achievements.length>0&&<section class="section"><div class="wrap"><p class="eyebrow">Career moments</p><h2 class="section-title">Milestones</h2><div class="story-grid">{achievements.map(m=><article class="story-panel"><small>{m.date}</small><h3>{m.title}</h3><p>{m.description}</p></article>)}</div></div></section>}
</Base>
<script>
(() => {
  const page=document.querySelector('[data-profile-page]');if(!page)return;
  const slug=page.dataset.profileSlug;
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const showNumber=(entry)=>{const el=document.querySelector('[data-profile-number]');if(!el||!entry)return;el.textContent=`#${entry.number}`;if(entry.numberImage){const img=document.createElement('img');img.alt=`Number ${entry.number}`;img.src=entry.numberImage;img.addEventListener('error',()=>{el.textContent=`#${entry.number}`;},{once:true});el.replaceChildren(img);}};
  const renderAssignments=(rows)=>{const mine=(rows||[]).filter(item=>item.profile===slug);if(!mine.length)return;showNumber(mine[0]);const box=document.querySelector('[data-profile-assignments]');if(box)box.innerHTML=mine.map(a=>`<div class="profile-assignment"><span>${esc(a.competition)}</span><strong>#${esc(a.number)}</strong><small>${esc(a.status)}${a.affiliation==='alliance'?' · STARCLUTCH RACING':''}</small></div>`).join('');};
  const renderPartners=(portfolios)=>{const section=document.querySelector('[data-profile-partners-section]'),box=document.querySelector('[data-profile-partners]');if(!section||!box)return;const portfolio=(portfolios||[]).find(p=>p.profile===slug),brands=[...(portfolio?.brands||[])].sort((a,b)=>(a.order||0)-(b.order||0));section.hidden=!brands.length;box.innerHTML=brands.map(b=>`<div>${b.logo?`<img src="${esc(b.logo)}" alt="${esc(b.name)}" loading="lazy">`:`<strong>${esc(b.name)}</strong>`}</div>`).join('');};
  const renderIdentity=(people,profiles)=>{const person=(people||[]).find(p=>p.slug===slug),detail=(profiles||[]).find(p=>p.slug===slug);if(person){const name=document.querySelector('[data-profile-name]'),identity=document.querySelector('[data-profile-identity]'),bio=document.querySelector('[data-profile-bio]');if(name)name.textContent=person.name||detail?.displayName||name.textContent;if(identity)identity.textContent=[person.handle,person.role].filter(Boolean).join(' · ');if(bio)bio.textContent=person.bio||detail?.intro||'';}const stats=document.querySelector('[data-profile-stats]');if(stats&&detail){stats.innerHTML=(detail.stats||[]).length?(detail.stats||[]).map(item=>`<div class="profile-stat"><span>${esc(item.label)}</span><strong>${esc(item.value)}</strong></div>`).join(''):'<p>Career statistics will be added as official records become available.</p>';}};
  window.addEventListener('aetherwing:content',({detail:d})=>{if(Array.isArray(d.drivers))renderAssignments(d.drivers);if(Array.isArray(d['driver-portfolios']))renderPartners(d['driver-portfolios']);if(Array.isArray(d['roster-profiles'])||Array.isArray(d['driver-profiles']))renderIdentity(d['roster-profiles'],d['driver-profiles']);});
})();
</script>
