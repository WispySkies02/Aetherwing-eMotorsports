---
import Base from '../../layouts/Base.astro';
import { rosterProfiles, driverProfiles, drivers, driverPortfolios, wins, milestones } from '../../lib/site-content.mjs';
import '../../styles/records.css';
export function getStaticPaths(){return rosterProfiles.map(person=>({params:{slug:person.slug},props:{person}}));}
const {person}=Astro.props;
const assignments=drivers.filter(d=>d.profile===person.slug);
const profile=driverProfiles.find(p=>p.slug===person.slug);
const portfolio=driverPortfolios.find(p=>p.profile===person.slug);
const achievements=milestones.filter(m=>m.assignmentId&&assignments.some(a=>a.id===m.assignmentId));
const victories=wins.filter(w=>assignments.some(a=>a.id===w.assignmentId));
---
<Base title={person.name} description={person.bio}>
  <section class="profile-hero"><div class="wrap"><a href="/drivers/">← Driver lineup</a><span>{person.affiliation==='alliance'?'ALLIANCE DRIVER':'AETHERWING DRIVER'}</span><div class="profile-hero__body"><div><h1>{person.name}</h1><p>{person.handle} · {person.role}</p><p>{person.bio}</p></div><div class="profile-hero__number" data-profile-number data-profile-slug={person.slug}>{assignments[0]?.numberImage?<img src={assignments[0].numberImage} alt={`Number ${assignments[0].number}`} />:`#${assignments[0]?.number||person.numbers.split(' / ')[0]}`}</div></div></div></section>
  <section class="section"><div class="wrap profile-grid"><article class="story-panel"><p class="eyebrow">Current campaign</p><h3>Racing programs</h3>{assignments.map(a=><div class="profile-assignment"><span>{a.competition}</span><strong>#{a.number}</strong><small>{a.status}</small></div>)}</article><article class="story-panel"><p class="eyebrow">Career</p><h3>Record</h3>{profile?.stats?.length?profile.stats.map(s=><div class="profile-stat"><span>{s.label}</span><strong>{s.value}</strong></div>):<p>Career statistics will be added as official records become available.</p>}{victories.length>0&&<p>{victories.length} verified wins in the Aetherwing record book.</p>}</article></div></section>
  {(portfolio?.brands?.length||0)>0&&<section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Driver identity</p><h2 class="section-title">Personal Partners</h2></div><a href="/partners/">All partners ↗</a></div><div class="profile-partners">{portfolio.brands.map(b=><div>{b.logo?<img src={b.logo} alt={b.name} loading="lazy"/>:<strong>{b.name}</strong>}</div>)}</div></div></section>}
  {achievements.length>0&&<section class="section"><div class="wrap"><p class="eyebrow">Career moments</p><h2 class="section-title">Milestones</h2><div class="story-grid">{achievements.map(m=><article class="story-panel"><small>{m.date}</small><h3>{m.title}</h3><p>{m.description}</p></article>)}</div></div></section>}
</Base>
<script>
  window.addEventListener('aetherwing:content',({detail:d})=>{if(!Array.isArray(d.drivers))return;const el=document.querySelector('[data-profile-number]');if(!el)return;const entry=d.drivers.find(item=>item.profile===el.dataset.profileSlug);if(!entry)return;el.textContent=`#${entry.number}`;if(entry.numberImage){const img=document.createElement('img');img.alt=`Number ${entry.number}`;img.src=entry.numberImage;img.addEventListener('error',()=>{el.textContent=`#${entry.number}`;},{once:true});el.replaceChildren(img);}});
</script>
