---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { wins as wins } from "../../lib/site-content.mjs";
import { results as results } from "../../lib/site-content.mjs";
import { standings as standings } from "../../lib/site-content.mjs";
import { scheduleEvents as scheduleEvents } from "../../lib/site-content.mjs";
import { milestones as milestoneRecords } from '../../lib/site-content.mjs';
import { drivers as driverAssignments } from '../../lib/site-content.mjs';
import '../../styles/pages/content.css';
import '../../styles/pages/history.css';
const latestRace=results.find((race)=>race.featured) ?? results[0] ?? {entries:[]};
const latestEntry=latestRace.entries?.find((entry)=>entry.featuredDriver) ?? latestRace.entries?.[0] ?? {};
const latest={...latestRace,...latestEntry,series:latestRace.leagueName,stagePoints:Number(latestEntry.stage1Points||0)+Number(latestEntry.stage2Points||0)};
const latestAssignment=driverAssignments.find((assignment)=>assignment.id===latestEntry.assignmentId);
const latestDateLabel=latest.date?new Date(`${latest.date}T12:00:00Z`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'}):'Date TBD';
const standingId=['uarl-d1','open'].includes(latest.league)?'uarl':latest.league;
const latestStanding=standings.find((item)=>item.id===standingId||item.league===standingId);
const latestStandingRow=latestStanding?.rows?.find((row)=>row.driver===latest.driver||String(row.number)===String(latest.number));
const leagueBadge={nrrs:'NRRS',kmart:'KMART',sunoco:'SUNOCO','uarl-d1':'UARL D1',open:'UARL OPEN',iracing:'iRACING'}[latest.league]||String(latest.league||'RESULT').toUpperCase();
const gainedFromStart=latest.start-latest.finish;
const nextLeagueRace=scheduleEvents.filter((item)=>item.league===latest.league&&!item.offWeek&&item.date>latest.date).sort((a,b)=>a.date.localeCompare(b.date))[0];
const newest=wins.slice(-4).reverse();
const milestones=milestoneRecords;
const numberArtFor=(assignmentId)=>driverAssignments.find((item)=>item.id===assignmentId)?.numberImage;
---
<BaseLayout title="Wins & History" description="The official Aetherwing record book — verified team wins, major milestones, postseason achievements, and organization lineage.">
  <PageHero eyebrow="The Official Aetherwing Record Book" title="Wins & History" description="Verified team wins, major milestones, postseason achievements, and the lineage that built the modern organization." ghost="RECORD BOOK" />
  <section class="section section--tight aw-history" data-history>
    <div class="shell">
      <div class="stat-rail"><div class="stat"><strong data-live-win-total>{wins.length}</strong><span>Verified Team Wins</span></div><div class="stat"><strong>05</strong><span>Aetherwing Programs</span></div><div class="stat"><strong>02</strong><span>Alliance Series</span></div><div class="stat"><strong>2023</strong><span>Modern Team Era</span></div></div>
      <nav class="aw-history-jump" aria-label="Record book sections"><a href="#scope">Record Scope</a><a href="#latest-result">Latest Result</a><a href="#victory-lane">Victory Lane</a><a href="#win-list">Win Archive</a><a href="#milestones">Milestones</a><a href="#history-log">History Log</a></nav>

      <section id="scope" class="aw-record-scope"><div class="section-head"><div><p class="eyebrow">How the Record Book Works</p><h2 class="section-title">Record Scope</h2></div></div><div class="aw-scope-grid"><article class="panel"><span>Aetherwing Record</span><h3>What Counts As A Team Win</h3><p>The verified total counts results recorded under the BellSouth or Aetherwing team banner. The archive below is the source for that total.</p><b>{wins.length} Verified Team Wins</b></article><article class="panel"><span>Historical Record</span><h3>Kmart Results Stay Where They Belong</h3><p>Historic Kmart Cup wins remain preserved as Aetherwing/BellSouth-era results because that is how those races were recorded at the time.</p><b>Historical AEM Era</b></article><article class="panel panel--alliance"><span>Current Structure</span><h3>Alliance Results Are Separate</h3><p>Current Kmart and Sunoco entries compete under StarClutch Racing through the alliance. Current alliance results do not increase the Aetherwing team-win total.</p><b>5 AEM Programs · 2 Alliance Series</b></article></div></section>

      <section id="latest-result" class="aw-latest-result aw-broadcast-result"><div class="section-head"><div><p class="eyebrow">Post-Race // Broadcast Recap</p><h2 class="section-title">Latest Result</h2></div><p class="lede">Race result, progression, postseason context, and the next assignment — built like a post-race television graphic, not a standings table.</p></div>
        <article class="aw-tv-result" data-live-latest-result aria-label={`${latest.title} result for ${latest.driver}`}>
          <header class="aw-tv-result__topline">
            <div class="aw-tv-result__series"><span>{leagueBadge}</span><strong>{latest.series}</strong></div>
            <div class="aw-tv-result__status" aria-label="Event status">
              {latest.round && <span>{latest.round}</span>}
              <span class="is-checkered">CHECKERED</span>
              {latest.status && <b>{latest.status}</b>}
              {latest.specialTag && <b class="is-chase">{latest.specialTag}</b>}
            </div>
          </header>

          <div class="aw-tv-result__main">
            <div class="aw-tv-result__event" data-track={latest.track}>
              <div class="aw-tv-result__meta"><b>{latest.track}</b><em>{latestDateLabel}</em></div>
              <h3>{latest.title}</h3>
              <p class="aw-tv-result__headline">{latest.headline || `P${latest.finish} AT ${latest.track.toUpperCase()}`} <strong>{latest.headlineAccent || latest.specialTag}</strong></p>
              <div class="aw-tv-result__driver"><b>{latestAssignment?.numberImage?<img class="aw-inline-number-image" src={latestAssignment.numberImage} alt={`Number ${latest.number}`} />:`#${latest.number}`}</b><span><strong>{latest.driver}</strong><small>Aetherwing eMotorsports · {latest.series}</small></span></div>
            </div>
            <aside class="aw-tv-result__finish" aria-label={`Official finish P${latest.finish}`}>
              <span>OFFICIAL FINISH</span>
              <strong>P{latest.finish}</strong>
              <div><b>{latest.finish===1?'WINNER':latest.finish<=5?'TOP 5':latest.finish<=10?'TOP 10':'FINISH'}</b><em>{gainedFromStart>0?`+${gainedFromStart} FROM START`:`${gainedFromStart} FROM START`}</em></div>
            </aside>
          </div>

          <div class="aw-tv-result__stats" aria-label="Race at a glance">
            <div><span>START</span><strong>P{latest.start}</strong><small>Green flag</small></div>
            <div><span>STAGE POINTS</span><strong>{latest.stagePoints}</strong><small>{latest.stagePoints===0?'No stage points':'Stage points earned'}</small></div>
            <div class="is-finish"><span>FINISH</span><strong>P{latest.finish}</strong><small>Checkered flag</small></div>
            <div class="is-chase"><span>LEAGUE STANDING</span><strong>{latestStandingRow?.position || '—'}</strong><small>{latestStandingRow ? `${latestStandingRow.points.toLocaleString()} pts` : 'No snapshot'}<em>{latestStandingRow?.delta || ''}</em></small></div>
          </div>

          {latestRace.entries?.length>1 && <div class="aw-tv-result__field" aria-label="Aetherwing race results">
            <span>ALL AETHERWING RESULTS</span>
            <div>{latestRace.entries.map((entry)=>{const assignment=driverAssignments.find((item)=>item.id===entry.assignmentId);return <article><b>{assignment?.numberImage?<img class="aw-inline-number-image" src={assignment.numberImage} alt={`Number ${entry.number}`} />:`#${entry.number}`} · {entry.driver}</b><small>START P{entry.start} · FINISH P{entry.finish} · {Number(entry.stage1Points||0)+Number(entry.stage2Points||0)} STAGE PTS{entry.racePoints?` · ${entry.racePoints} RACE PTS`:''}</small></article>})}</div>
          </div>}

          <div class="aw-tv-result__lower">
            <div class="aw-tv-result__summary"><span>RACE SUMMARY</span><p>{latest.summary || `${latest.driver} started P${latest.start}, scored ${latest.stagePoints} stage points, and finished P${latest.finish} in ${latest.title} at ${latest.track}.`}</p></div>
            <div class="aw-tv-result__next"><span>UP NEXT</span><strong>{nextLeagueRace?.title || 'Schedule pending'}</strong><small>{nextLeagueRace?.track || ''} · {nextLeagueRace?.date || 'TBD'}</small></div>
          </div>
        </article>
      </section>

      <section id="victory-lane" data-live-victory-lane><div class="section-head"><div><p class="eyebrow">Victory Lane</p><h2 class="section-title">Latest Victories</h2></div></div><div class="aw-victory-grid">{newest.map((win)=><article class="panel"><span>🏆</span><small>{win.league}</small><h3>{win.track}</h3><p>{numberArtFor(win.assignmentId)&&<img class="aw-history-number-art" src={numberArtFor(win.assignmentId)} alt="" />}{win.driver}</p><b>{win.date}</b></article>)}</div></section>

      <section id="win-list" class="aw-win-archive" data-live-win-list><div class="section-head"><div><p class="eyebrow">Complete Record</p><h2 class="section-title">Win List</h2></div><p class="lede">Historical results stay under the series and team relationship that existed when each race was run.</p></div><div class="aw-win-filters"><button class="is-active" type="button" data-win-filter="all">All</button><button type="button" data-win-filter="Kmart">Kmart · Historic AEM</button><button type="button" data-win-filter="NRRS">NRRS</button><button type="button" data-win-filter="UARL">UARL</button><button type="button" data-win-filter="iRacing">iRacing</button></div><div class="aw-win-table"><div class="aw-win-row aw-win-head"><span>League</span><span>Track / Event</span><span>Driver</span><span>Date</span></div>{wins.map((win)=><div class="aw-win-row" data-win-row data-league={win.league}><span>{win.league}</span><strong>{win.track}</strong><span>{numberArtFor(win.assignmentId)&&<img class="aw-history-number-art" src={numberArtFor(win.assignmentId)} alt="" />}{win.driver}</span><span>{win.date}</span></div>)}</div><p class="mono muted" data-win-count>Showing {wins.length} recorded wins.</p></section>

      <section id="milestones" class="aw-milestones" data-live-milestones><div class="section-head"><div><p class="eyebrow">Milestones</p><h2 class="section-title">Firsts & Records</h2></div></div><div class="timeline">{milestones.map((item)=><article class="timeline-item"><span class="tag">{item.date}</span><h3>{numberArtFor(item.assignmentId)&&<img class="aw-history-number-art" src={numberArtFor(item.assignmentId)} alt="" />}{item.title}</h3><p class="muted">{item.description}</p></article>)}</div></section>

      <section id="history-log" class="aw-history-log"><div class="section-head"><div><p class="eyebrow">Timeline</p><h2 class="section-title">History Log</h2></div><p class="lede">Organization lineage begins in 2015; the BellSouth eMotorsports chapter that becomes today’s Aetherwing begins in 2023.</p></div><div class="aw-history-cards"><article><span>2015</span><h3>Organization Lineage Begins</h3><p>The racing lineage that eventually leads to Aetherwing begins as Silph Co. Motorsports during the NASCAR 15 era.</p></article><article><span>Late 2023</span><h3>BellSouth eMotorsports Era</h3><p>The modern eMotorsports organization begins as the team enters NR2003 league competition.</p></article><article><span>2024</span><h3>RoRacing & iRacing Expansion</h3><p>Roblox RoRacing and iRacing programs begin, setting the foundation for the modern multi-series structure.</p></article><article><span>Jan 1, 2026</span><h3>Aetherwing Era Begins</h3><p>BellSouth eMotorsports becomes Aetherwing eMotorsports, carrying forward the verified modern competition record.</p></article><article><span>Aug 25, 2026</span><h3>Third Straight NRRS Chase</h3><p>Wispy’s Martinsville P4 clinches a fifth confirmed Chase appearance overall and a third straight NRRS postseason berth.</p></article></div></section>
    </div>
  </section>
</BaseLayout>
<script>
  const root=document.querySelector('[data-history]');
  function bindWinFilters(){if(!root)return;const rows=Array.from(root.querySelectorAll('[data-win-row]')),count=root.querySelector('[data-win-count]');root.querySelectorAll('[data-win-filter]').forEach(button=>button.addEventListener('click',()=>{if(!(button instanceof HTMLButtonElement))return;root.querySelectorAll('[data-win-filter]').forEach(b=>b.classList.remove('is-active'));button.classList.add('is-active');const filter=button.dataset.winFilter||'all';let shown=0;rows.forEach(row=>{const show=filter==='all'||(row.dataset.league||'').startsWith(filter);row.hidden=!show;if(show)shown++;});if(count)count.textContent=`Showing ${shown} recorded win${shown===1?'':'s'}.`;}));}
  bindWinFilters();
  const escResult=(value)=>String(value??'').replace(/[&<>'"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  const normalizeResultFeed=(value)=>Array.isArray(value)?value:Array.isArray(value?.races)?value.races:value?.latestResult?[{...value.latestResult,league:'nrrs',leagueName:value.latestResult.series||'NRRS',featured:true,entries:[{driver:value.latestResult.driver,number:value.latestResult.number,start:value.latestResult.start,stage1Points:0,stage2Points:value.latestResult.stagePoints||0,finish:value.latestResult.finish,racePoints:value.latestResult.pointsChange||0,featuredDriver:true}]}]:[];
  function renderLiveResult(datasets){
    const mount=document.querySelector('[data-live-latest-result]'),races=normalizeResultFeed(datasets.results),race=races.find((item)=>item.featured)||races[0],entry=race?.entries?.find((item)=>item.featuredDriver)||race?.entries?.[0];if(!(mount instanceof HTMLElement)||!race||!entry)return;
    const assignments=Array.isArray(datasets.drivers)?datasets.drivers:[],assignment=assignments.find((item)=>item.id===entry.assignmentId),stage=Number(entry.stage1Points||0)+Number(entry.stage2Points||0),finish=Number(entry.finish||0),start=Number(entry.start||0),gained=start-finish;
    const badge={nrrs:'NRRS',kmart:'KMART',sunoco:'SUNOCO','uarl-d1':'UARL D1',open:'UARL OPEN',iracing:'iRACING'}[race.league]||String(race.league||'RESULT').toUpperCase(),standingId=['uarl-d1','open'].includes(race.league)?'uarl':race.league;
    const standing=(datasets.standings||[]).find((item)=>item.id===standingId||item.league===standingId),standingRow=standing?.rows?.find((row)=>row.driver===entry.driver||String(row.number)===String(entry.number));
    const next=(datasets['schedule-events']||[]).filter((item)=>item.league===race.league&&!item.offWeek&&item.date>race.date).sort((a,b)=>String(a.date).localeCompare(String(b.date)))[0];
    const date=/^\d{4}-\d{2}-\d{2}$/.test(race.date||'')?new Date(`${race.date}T12:00:00Z`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'}):race.date||'Date TBD';
    const numberMark=(item)=>{const linked=assignments.find((candidate)=>candidate.id===item.assignmentId);return linked?.numberImage?`<img class="aw-inline-number-image" src="${escResult(linked.numberImage)}" alt="Number ${escResult(item.number)}">`:`#${escResult(item.number)}`;};
    const all=race.entries?.length>1?`<div class="aw-tv-result__field" aria-label="Aetherwing race results"><span>ALL AETHERWING RESULTS</span><div>${race.entries.map((item)=>`<article><b>${numberMark(item)} · ${escResult(item.driver)}</b><small>START P${escResult(item.start)} · FINISH P${escResult(item.finish)} · ${Number(item.stage1Points||0)+Number(item.stage2Points||0)} STAGE PTS${item.racePoints?` · ${escResult(item.racePoints)} RACE PTS`:''}</small></article>`).join('')}</div></div>`:'';
    mount.setAttribute('aria-label',`${race.title} result for ${entry.driver}`);
    mount.innerHTML=`<header class="aw-tv-result__topline"><div class="aw-tv-result__series"><span>${escResult(badge)}</span><strong>${escResult(race.leagueName||race.league)}</strong></div><div class="aw-tv-result__status" aria-label="Event status">${race.round?`<span>${escResult(race.round)}</span>`:''}<span class="is-checkered">CHECKERED</span>${race.status?`<b>${escResult(race.status)}</b>`:''}${race.specialTag?`<b class="is-chase">${escResult(race.specialTag)}</b>`:''}</div></header><div class="aw-tv-result__main"><div class="aw-tv-result__event" data-track="${escResult(race.track)}"><div class="aw-tv-result__meta"><b>${escResult(race.track)}</b><em>${escResult(date)}</em></div><h3>${escResult(race.title)}</h3><p class="aw-tv-result__headline">${escResult(race.headline||`P${finish} AT ${String(race.track||'').toUpperCase()}`)} <strong>${escResult(race.headlineAccent||race.specialTag||'OFFICIAL RESULT')}</strong></p><div class="aw-tv-result__driver"><b>${numberMark(entry)}</b><span><strong>${escResult(entry.driver)}</strong><small>Aetherwing eMotorsports · ${escResult(race.leagueName||race.league)}</small></span></div></div><aside class="aw-tv-result__finish" aria-label="Official finish P${finish}"><span>OFFICIAL FINISH</span><strong>P${finish}</strong><div><b>${finish===1?'WINNER':finish<=5?'TOP 5':finish<=10?'TOP 10':'FINISH'}</b><em>${gained>0?`+${gained}`:gained} FROM START</em></div></aside></div><div class="aw-tv-result__stats"><div><span>START</span><strong>P${start}</strong><small>Green flag</small></div><div><span>STAGE POINTS</span><strong>${stage}</strong><small>${stage===0?'No stage points':'Stage points earned'}</small></div><div class="is-finish"><span>FINISH</span><strong>P${finish}</strong><small>Checkered flag</small></div><div class="is-chase"><span>LEAGUE STANDING</span><strong>${escResult(standingRow?.position||'—')}</strong><small>${standingRow?`${Number(standingRow.points||0).toLocaleString()} pts`:'No snapshot'}<em>${escResult(standingRow?.delta||'')}</em></small></div></div>${all}<div class="aw-tv-result__lower"><div class="aw-tv-result__summary"><span>RACE SUMMARY</span><p>${escResult(race.summary||`${entry.driver} started P${start}, scored ${stage} stage points, and finished P${finish} in ${race.title} at ${race.track}.`)}</p></div><div class="aw-tv-result__next"><span>UP NEXT</span><strong>${escResult(next?.title||'Schedule pending')}</strong><small>${escResult(next?.track||'')} · ${escResult(next?.date||'TBD')}</small></div></div>`;
  }
  function renderLiveHistory(datasets){
    const wins=Array.isArray(datasets.wins)?datasets.wins:[],milestones=Array.isArray(datasets.milestones)?datasets.milestones:[],assignments=Array.isArray(datasets.drivers)?datasets.drivers:[];
    const numberMark=(assignmentId)=>{const assignment=assignments.find((item)=>item.id===assignmentId);return assignment?.numberImage?`<img class="aw-history-number-art" src="${escResult(assignment.numberImage)}" alt="">`:'';};
    const victory=document.querySelector('[data-live-victory-lane] .aw-victory-grid');if(victory)victory.innerHTML=wins.slice(-4).reverse().map((win)=>`<article class="panel"><span>🏆</span><small>${escResult(win.league)}</small><h3>${escResult(win.track)}</h3><p>${numberMark(win.assignmentId)}${escResult(win.driver)}</p><b>${escResult(win.date)}</b></article>`).join('');
    const list=document.querySelector('[data-live-win-list]');if(list){list.innerHTML=`<div class="section-head"><div><p class="eyebrow">Complete Record</p><h2 class="section-title">Win List</h2></div><p class="lede">Historical results stay under the series and team relationship that existed when each race was run.</p></div><div class="aw-win-filters"><button class="is-active" type="button" data-win-filter="all">All</button><button type="button" data-win-filter="Kmart">Kmart · Historic AEM</button><button type="button" data-win-filter="NRRS">NRRS</button><button type="button" data-win-filter="UARL">UARL</button><button type="button" data-win-filter="iRacing">iRacing</button></div><div class="aw-win-table"><div class="aw-win-row aw-win-head"><span>League</span><span>Track / Event</span><span>Driver</span><span>Date</span></div>${wins.map((win)=>`<div class="aw-win-row" data-win-row data-league="${escResult(win.league)}"><span>${escResult(win.league)}</span><strong>${escResult(win.track)}</strong><span>${numberMark(win.assignmentId)}${escResult(win.driver)}</span><span>${escResult(win.date)}</span></div>`).join('')}</div><p class="mono muted" data-win-count>Showing ${wins.length} recorded wins.</p>`;bindWinFilters();}
    const timeline=document.querySelector('[data-live-milestones] .timeline');if(timeline)timeline.innerHTML=milestones.map((item)=>`<article class="timeline-item"><span class="tag">${escResult(item.date)}</span><h3>${numberMark(item.assignmentId)}${escResult(item.title)}</h3><p class="muted">${escResult(item.description)}</p></article>`).join('');
    const total=document.querySelector('[data-live-win-total]');if(total)total.textContent=String(wins.length);
  }
  fetch(`/api/site-content?history=${Date.now()}`,{cache:'no-store',headers:{accept:'application/json'}}).then((response)=>response.ok?response.json():null).then((published)=>{if(published?.datasets){renderLiveResult(published.datasets);renderLiveHistory(published.datasets);}}).catch(()=>{});
</script>
