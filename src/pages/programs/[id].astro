---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { competitions, scheduleEvents, drivers, standings, results } from '../../lib/site-content.mjs';
import { eventSlug } from '../../lib/schedule-events.mjs';
import '../../styles/records.css';
export function getStaticPaths(){return competitions.map(program=>({params:{id:program.id},props:{program}}));}
const {program}=Astro.props;
const league=program.id==='uarl-open'?'open':program.id==='iracing-factory'?'iracing':program.id;
const schedule=scheduleEvents.filter(e=>e.league===league&&!e.offWeek&&e.date>='2026-09-23').sort((a,b)=>a.date.localeCompare(b.date));
const entries=drivers.filter(d=>d.competitionId===program.id);
const board=standings.find(s=>s.league===league||s.id===program.id);
const latest=results.find(r=>r.league===league);
---
<Base title={program.name} description={`${program.name} — Aetherwing racing program, team lineup, and schedule.`}><div data-program-page data-program-id={program.id}><PageIntro eyebrow={program.label} title={program.name} description={`${program.machine} · ${program.schedule}`}/><section class="section"><div class="wrap story-grid"><article class="story-panel" data-program-lineup><p class="eyebrow">The garage</p><h3>Lineup</h3>{entries.map(e=><div class="profile-assignment"><span>{e.displayName}</span><strong>#{e.number}</strong><small>{e.status}</small></div>)}<a href="/drivers/">Full driver lineup ↗</a></article><article class="story-panel" data-program-next><p class="eyebrow">Next green flag</p><h3>{schedule[0]?.track||'Season Complete'}</h3><p>{schedule[0]?`${schedule[0].title} · ${schedule[0].date} · ${schedule[0].time}`:'No upcoming event is currently listed.'}</p>{schedule[0]&&<a href={`/event/${eventSlug(schedule[0])}/`}>Race weekend ↗</a>}</article><article class="story-panel" data-program-standings><p class="eyebrow">The standings</p><h3>{board?.title||'Championship'}</h3><p>{board?.subtitle||'Official standings will appear here.'}</p><a href="/championships/">Championship battles ↗</a></article></div></section><section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Ahead in {program.name}</p><h2 class="section-title">Upcoming Races</h2></div><a href="/schedule/">Full calendar ↗</a></div><div class="results-list" data-program-schedule>{schedule.slice(0,6).map(e=><article><span>{e.date} · {e.round||e.status}</span><h3>{e.track}</h3><p>{e.title}</p><a href={`/event/${eventSlug(e)}/`}>Event details →</a></article>)}{schedule.length===0&&<p class="no-records">The program's season is complete.</p>}</div>{latest&&<p class="mono muted" data-program-latest>Latest result: {latest.title} · {latest.date}</p>}<p class="mono muted" data-program-latest hidden={!!latest}></p></div></section></div></Base>

<script>
(()=>{const page=document.querySelector('[data-program-page]');if(!page)return;const id=page.dataset.programId;const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const slugify=v=>String(v||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/&/g,' and ').replace(/[’']/g,'').replace(/[^a-zA-Z0-9]+/g,'-').replace(/^-+|-+$/g,'').toLowerCase();const route=e=>{const explicit=slugify(e?.routeId||e?.eventId||'');if(explicit)return explicit;const league=slugify(e?.league||'event')||'event',round=String(e?.round||'').match(/(\d+)/);return round?`${league}-round-${Number(round[1])}`:`${league}-${slugify(e?.date||'tbd')||'tbd'}`;};const leagueFor=p=>p?.id==='uarl-open'?'open':p?.id==='iracing-factory'?'iracing':p?.id;const apply=d=>{const p=(d?.competitions||[]).find(x=>x?.id===id);if(!p)return;const intro=page.querySelector('.page-intro');if(intro){const e=intro.querySelector('.eyebrow'),h=intro.querySelector('h1'),desc=intro.querySelector('h1 + p');if(e)e.textContent=p.label||'';if(h)h.textContent=p.name||'';if(desc)desc.textContent=`${p.machine||''} · ${p.schedule||''}`;}const entries=(d.drivers||[]).filter(x=>x?.competitionId===id),lineup=page.querySelector('[data-program-lineup]');if(lineup)lineup.innerHTML=`<p class="eyebrow">The garage</p><h3>Lineup</h3>${entries.map(e=>`<div class="profile-assignment"><span>${esc(e.displayName)}</span><strong>#${esc(e.number)}</strong><small>${esc(e.status)}</small></div>`).join('')}<a href="/drivers/">Full driver lineup ↗</a>`;const league=leagueFor(p),events=(d['schedule-events']||[]).filter(e=>e?.league===league&&!e?.offWeek&&String(e?.date||'')>='2026-09-23').sort((a,b)=>String(a.date).localeCompare(String(b.date))),next=events[0],nextBox=page.querySelector('[data-program-next]');if(nextBox)nextBox.innerHTML=`<p class="eyebrow">Next green flag</p><h3>${esc(next?.track||'Season Complete')}</h3><p>${next?`${esc(next.title)} · ${esc(next.date)} · ${esc(next.time)}`:'No upcoming event is currently listed.'}</p>${next?`<a href="/event/${route(next)}/">Race weekend ↗</a>`:''}`;const board=(d.standings||[]).find(s=>s?.league===league||s?.id===id),stand=page.querySelector('[data-program-standings]');if(stand)stand.innerHTML=`<p class="eyebrow">The standings</p><h3>${esc(board?.title||'Championship')}</h3><p>${esc(board?.subtitle||'Official standings will appear here.')}</p><a href="/championships/">Championship battles ↗</a>`;const list=page.querySelector('[data-program-schedule]');if(list)list.innerHTML=events.slice(0,6).map(e=>`<article><span>${esc(e.date)} · ${esc(e.round||e.status)}</span><h3>${esc(e.track)}</h3><p>${esc(e.title)}</p><a href="/event/${route(e)}/">Event details →</a></article>`).join('')||"<p class='no-records'>The program's season is complete.</p>";const latest=(d.results||[]).find(r=>r?.league===league),latestEl=page.querySelector('[data-program-latest]');if(latestEl){latestEl.hidden=!latest;latestEl.textContent=latest?`Latest result: ${latest.title} · ${latest.date}`:'';}};window.addEventListener('aetherwing:content',({detail})=>apply(detail));if(window.__AETHERWING_CONTENT__)apply(window.__AETHERWING_CONTENT__);})();
</script>
