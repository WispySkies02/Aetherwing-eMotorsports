---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { competitions, scheduleEvents, drivers, standings, results } from '../../lib/site-content.mjs';
import { eventSlug } from '../../lib/schedule-events.mjs';
import '../../styles/records.css';
export function getStaticPaths(){return competitions.map(program=>({params:{id:program.id},props:{program}}));}
const {program}=Astro.props;
const league=program.id==='uarl-open'?'open':program.id==='iracing-factory'?'iracing':program.id;
const schedule=scheduleEvents.filter(e=>e.league===league&&!e.offWeek&&e.date>='2026-09-23').sort((a,b)=>a.date.localeCompare(b.date));
const entries=drivers.filter(d=>d.competitionId===program.id);
const board=standings.find(s=>s.league===league||s.id===program.id);
const latest=results.find(r=>r.league===league);
---
<Base title={program.name} description={`${program.name} — Aetherwing racing program, team lineup, and schedule.`}><PageIntro eyebrow={program.label} title={program.name} description={`${program.machine} · ${program.schedule}`}/><section class="section"><div class="wrap story-grid"><article class="story-panel"><p class="eyebrow">The garage</p><h3>Lineup</h3>{entries.map(e=><div class="profile-assignment"><span>{e.displayName}</span><strong>#{e.number}</strong><small>{e.status}</small></div>)}<a href="/drivers/">Full driver lineup ↗</a></article><article class="story-panel"><p class="eyebrow">Next green flag</p><h3>{schedule[0]?.track||'Season Complete'}</h3><p>{schedule[0]?`${schedule[0].title} · ${schedule[0].date} · ${schedule[0].time}`:'No upcoming event is currently listed.'}</p>{schedule[0]&&<a href={`/event/${eventSlug(schedule[0])}/`}>Race weekend ↗</a>}</article><article class="story-panel"><p class="eyebrow">The standings</p><h3>{board?.title||'Championship'}</h3><p>{board?.subtitle||'Official standings will appear here.'}</p><a href="/championships/">Championship battles ↗</a></article></div></section><section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Ahead in {program.name}</p><h2 class="section-title">Upcoming Races</h2></div><a href="/schedule/">Full calendar ↗</a></div><div class="results-list">{schedule.slice(0,6).map(e=><article><span>{e.date} · {e.round||e.status}</span><h3>{e.track}</h3><p>{e.title}</p><a href={`/event/${eventSlug(e)}/`}>Event details →</a></article>)}{schedule.length===0&&<p class="no-records">The program's season is complete.</p>}</div>{latest&&<p class="mono muted">Latest result: {latest.title} · {latest.date}</p>}</div></section></Base>
