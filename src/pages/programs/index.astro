---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { competitions } from '../../lib/site-content.mjs';
const programLogo={nrrs:'/images/schedule-logos/nrrs.png','uarl-d1':'/images/schedule-logos/uarl-d1.png','uarl-open':'/images/schedule-logos/open.png','iracing-factory':'/images/schedule-logos/iracing.png',kmart:'/images/schedule-logos/kmart-regular.jpg',sunoco:'/images/schedule-logos/sunoco.png'};
---
<Base title="Racing Programs" description="Explore the Aetherwing racing programs and alliance series."><PageIntro eyebrow="Across every discipline" title="Programs" description="Each championship has its own garage, schedule and story."/><section class="section"><div class="wrap story-grid program-grid" data-program-grid>{competitions.map(c=><article class="story-panel program-card">{programLogo[c.id]&&<div class="program-card__logo"><img src={programLogo[c.id]} alt="" loading="lazy"/></div>}<p class="eyebrow">{c.label}</p><h3>{c.name}</h3><p>{c.machine} · {c.platform}</p><p>{c.schedule}</p><a href={`/programs/${c.id}/`}>Open program →</a></article>)}</div></section></Base>
<script>
  (()=>{const root=document.querySelector('[data-program-grid]');if(!root)return;const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const logos={nrrs:'/images/schedule-logos/nrrs.png','uarl-d1':'/images/schedule-logos/uarl-d1.png','uarl-open':'/images/schedule-logos/open.png','iracing-factory':'/images/schedule-logos/iracing.png',kmart:'/images/schedule-logos/kmart-regular.jpg',sunoco:'/images/schedule-logos/sunoco.png'};const render=d=>{if(!Array.isArray(d?.competitions))return;root.innerHTML=d.competitions.filter(c=>c?.id!=='uarl-d2').map(c=>`<article class="story-panel program-card">${logos[c.id]?`<div class="program-card__logo"><img src="${logos[c.id]}" alt="" loading="lazy"></div>`:''}<p class="eyebrow">${esc(c.label)}</p><h3>${esc(c.name)}</h3><p>${esc(c.machine)} · ${esc(c.platform)}</p><p>${esc(c.schedule)}</p><a href="/programs/${esc(c.id)}/">Open program →</a></article>`).join('');};window.addEventListener('aetherwing:content',({detail})=>render(detail));if(window.__AETHERWING_CONTENT__)render(window.__AETHERWING_CONTENT__);})();
</script>
