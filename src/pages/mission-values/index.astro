---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import leadership from '../../data/leadership.json';
import competitions from '../../data/competitions.json';
import '../../styles/pages/editorial-pages.css';
---
<BaseLayout title="Mission & Values" description="Aetherwing eMotorsports mission, values, competition identity, brand principles, and current leadership.">
  <PageHero eyebrow="Identity / Standards / Direction" title="Mission & Values" description="Aetherwing exists to build a sharp, competitive, brand-forward racing organization across NR2003, Roblox RoRacing, and iRacing — where execution, creativity, and team identity matter every race week." ghost="SOAR" />
  <section class="section section--tight aw-editorial-page"><div class="shell">
    <div class="aw-manifesto"><article class="aw-manifesto__statement"><span class="aw-paper-label">Born to Soar. Built to Fight.</span><h2>Build the most complete online racing team we can.</h2><p>Aetherwing eMotorsports is built around competitive growth, clean race execution, strong visual presentation, and a team culture that treats every league, livery, graphic, and race night like it matters.</p></article><aside class="panel aw-manifesto__note"><p class="eyebrow">Our Mission</p><strong>Competition with an identity.</strong><p class="muted">Why Aetherwing exists, how it competes, and what the brand is supposed to represent.</p></aside></div>

    <section class="section"><div class="section-head"><div><p class="eyebrow">Values</p><h2 class="section-title">The Operating Language</h2></div><p class="lede">These values should show up in the racing, graphics, roster, and every public-facing piece of the organization.</p></div><div class="aw-values-grid"><article class="aw-value-card"><span>01</span><h3>Competitive Discipline</h3><p>Race with purpose. Clean execution, patience, race IQ, and consistency matter just as much as raw speed.</p></article><article class="aw-value-card"><span>02</span><h3>Creative Identity</h3><p>Aetherwing should look like Aetherwing. Every scheme, page, graphic, and post should feel connected to the same world.</p></article><article class="aw-value-card"><span>03</span><h3>Team First</h3><p>Drivers, designers, coordinators, and leadership work best when they pull in the same direction.</p></article><article class="aw-value-card"><span>04</span><h3>Broadcast Ready</h3><p>The team should be easy to recognize on track, in screenshots, standings pages, and race-week media.</p></article><article class="aw-value-card"><span>05</span><h3>Legacy With Intent</h3><p>The roots matter, but the public record stays clean, confirmed, and built around details the team can stand behind.</p></article><article class="aw-value-card"><span>06</span><h3>Keep Improving</h3><p>Every race, page, livery, and roster update is a chance to make the team sharper than it was the week before.</p></article></div></section>

    <section class="section"><div class="section-head"><div><p class="eyebrow">Principles</p><h2 class="section-title">Preparation. Identity. Follow-Through.</h2></div></div><div class="aw-principles"><article><b>01</b><h3>Prepare the car.</h3><p>Make the scheme, number, sponsor placement, and visual details intentional before race day.</p></article><article><b>02</b><h3>Respect the race.</h3><p>Race hard, avoid careless moves, and understand that finishing smart is part of building a record.</p></article><article><b>03</b><h3>Track the data.</h3><p>Standings, starts, wins, averages, and history make the team real and organized.</p></article><article><b>04</b><h3>Protect the brand.</h3><p>Keep visuals consistent, wording clean, and every public page inside the same Aetherwing world.</p></article></div></section>

    <section class="section"><div class="section-head"><div><p class="eyebrow">Where We Race</p><h2 class="section-title">Seven Relationships</h2></div><p class="lede">Five Aetherwing programs and two StarClutch Racing alliance series.</p></div><div class="aw-competition-accordion">{competitions.map((competition,index)=><details class:list={[{'is-alliance':competition.type==='alliance'}]} open={index===0}><summary><strong>{competition.name}</strong><span>{competition.label} · {competition.schedule}</span></summary><div><p><b>{competition.machine}</b></p><p>{competition.platform}</p><p class="mono">{competition.roster.join(' · ')}</p></div></details>)}</div></section>

    <section class="section"><div class="section-head"><div><p class="eyebrow">Brand Palette</p><h2 class="section-title">Red. Gold. Black. Paper. Blue.</h2></div></div><div class="aw-palette"><span>Aetherwing Red</span><span>Feather Gold</span><span>Black</span><span>Paper</span><span>Race Blue</span></div></section>

    <section class="section"><div class="section-head"><div><p class="eyebrow">Leadership</p><h2 class="section-title">Current Team Direction</h2></div></div><div class="aw-leadership-line">{leadership.map((person)=><article><h3>{person.name}</h3><p>{person.roles.join(' · ')}</p></article>)}</div></section>
  </div></section>
</BaseLayout>
