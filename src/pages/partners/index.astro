---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { partners, driverPortfolios as portfolioSource } from '../../lib/site-content.mjs';
import '../../styles/pages/content.css';
const portfolios=[...portfolioSource]
  .sort((a,b)=>(a.order??0)-(b.order??0)||String(a.name).localeCompare(String(b.name)))
  .map((portfolio)=>({...portfolio,brands:[...(portfolio.brands??[])].sort((a,b)=>(a.order??0)-(b.order??0)||String(a.name).localeCompare(String(b.name)))}));
---
<BaseLayout title="Partners" description="Aetherwing Partner Network — featured public-facing relationships and separate driver livery-brand portfolios.">
  <PageHero eyebrow="Aetherwing eMotorsports" title="Aetherwing Partners" description="Aetherwing’s partner network brings together gaming and sim-racing relationships while individual livery-brand portfolios remain clearly separate from team partnerships." ghost="PARTNERS" />
  <section class="section section--tight aw-partner-page">
    <div class="shell">
      <div class="aw-partner-summary"><span><b>02</b> Featured Partners</span><span><b>GAME</b> Gaming Culture</span><span><b>SIM</b> Sim Racing</span><span><b>IR + RBX</b> Competition Footprint</span></div>
      <div class="section-head"><div><p class="eyebrow">Aetherwing Network</p><h2 class="section-title">Featured Brands & Affiliates</h2></div><p class="lede">Two current team-level relationships. No livery logo is promoted into this section just because it appears on a race car.</p></div>
      <div class="aw-featured-partners">
        {partners.map((partner,index)=><article class="aw-featured-partner panel">
          <div class="aw-featured-partner__logo"><img src={partner.logo} alt={partner.name} loading={index===0?'eager':'lazy'} /></div>
          <div class="aw-featured-partner__body"><div class="aw-featured-partner__badges"><span class="tag">{partner.role}</span><b>{index===0?'Gaming / Collectibles':'Sim Racing / Affiliate'}</b></div><small>{index===0?'Brand Profile':'Affiliate Profile'}</small><h3>{partner.name}</h3><p>{partner.description}</p><div class="aw-partner-tags">{partner.tags.map((tag)=><span>{tag}</span>)}</div><a class="btn" href={partner.url} target="_blank" rel="noopener noreferrer">Visit Website ↗</a></div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section aw-partnership-values" data-brush="PARTNERSHIP VALUES">
    <div class="shell shell--standard">
      <div class="section-head"><div><p class="eyebrow">How We Approach Partnerships</p><h2 class="section-title">Built for Fit, Not Clutter.</h2></div></div>
      <div class="aw-value-rail"><article><span>01 // Team</span><h3>Across the team.</h3><p>Featured relationships are presented where they naturally fit the Aetherwing organization and its public identity.</p></article><article><span>02 // Creative</span><h3>Part of the presentation.</h3><p>Brand treatment should feel integrated with racing and content instead of becoming a disconnected logo wall.</p></article><article><span>03 // Culture</span><h3>Racing + gaming.</h3><p>The network reflects both competitive motorsports and the broader gaming culture around the team.</p></article><article><span>04 // Clarity</span><h3>Relationships stay clear.</h3><p>Team partners, affiliate relationships, and driver livery portfolios are labeled as different things.</p></article></div>
    </div>
  </section>

  <section class="section aw-portfolios" data-portfolios>
    <div class="shell">
      <div class="section-head"><div><p class="eyebrow">Driver Brand Programs</p><h2 class="section-title">Livery & Brand Portfolios</h2></div><p class="lede">These brands appear in individual livery and creative programs. Inclusion here does not by itself mean team-level sponsorship or affiliation.</p></div>
      <div class="aw-portfolio-controls"><button type="button" data-expand>Expand All</button><button type="button" data-collapse>Collapse All</button></div>
      <div class="aw-portfolio-list">
        {portfolios.map((portfolio)=><details data-portfolio-id={portfolio.id}><summary><span><small>{portfolio.label||'Driver Brand / Livery Portfolio'}</small><strong>{portfolio.name} {portfolio.handle&&<em>({portfolio.handle})</em>}</strong></span><b>{portfolio.brands.length} {portfolio.brands.length===1?'Livery Brand':'Livery Brands'}</b></summary><div class:list={['aw-brand-grid',{'is-text':!portfolio.brands.some((brand)=>brand.logo)}]}>{portfolio.brands.map((brand)=><div class="aw-brand-tile">{brand.logo?<img src={brand.logo} alt={brand.name} loading="lazy" />:<strong>{brand.name}</strong>}<span>{String(brand.order).padStart(2,'0')}</span></div>)}</div></details>)}
      </div>
      <p class="aw-brand-note">Brand note: logos and names shown inside driver portfolios may represent livery identities, advertising, or creative programs. Their appearance there does not by itself indicate a separate team-level sponsorship or affiliate relationship.</p>
    </div>
  </section>
  <section class="section"><div class="shell shell--standard"><div class="aw-contact-cta"><span class="aw-paper-label">Build Something With Aetherwing</span><h2>Racing. Gaming. Content. Creative.</h2><p>Interested in working with Aetherwing? Open the communications channel through Contact HQ.</p><a class="btn" href="/contact/">Contact Us</a></div></div></section>
</BaseLayout>
<script>
  const root=document.querySelector('[data-portfolios]');
  root?.querySelector('[data-expand]')?.addEventListener('click',()=>root.querySelectorAll('details').forEach(d=>d.open=true));
  root?.querySelector('[data-collapse]')?.addEventListener('click',()=>root.querySelectorAll('details').forEach(d=>d.open=false));
  function updatePortfolios(datasets){
    const portfolios=datasets?.['driver-portfolios'];
    const list=root?.querySelector('.aw-portfolio-list');
    if(!list||!Array.isArray(portfolios)||!portfolios.length)return;
    const openIds=new Set([...list.querySelectorAll('details[open]')].map((details)=>details.dataset.portfolioId));
    const fragment=document.createDocumentFragment();
    for(const portfolio of [...portfolios].sort((a,b)=>Number(a.order||0)-Number(b.order||0)||String(a.name||'').localeCompare(String(b.name||'')))){
      const details=document.createElement('details');details.dataset.portfolioId=String(portfolio.id||'');details.open=openIds.has(details.dataset.portfolioId);
      const summary=document.createElement('summary'),heading=document.createElement('span'),label=document.createElement('small'),name=document.createElement('strong'),handle=document.createElement('em'),count=document.createElement('b'),grid=document.createElement('div');
      label.textContent=portfolio.label||'Driver Brand / Livery Portfolio';name.textContent=portfolio.name||'Driver';
      if(portfolio.handle){handle.textContent=` (${portfolio.handle})`;name.append(handle);}
      const brands=Array.isArray(portfolio.brands)?[...portfolio.brands].sort((a,b)=>Number(a.order||0)-Number(b.order||0)||String(a.name||'').localeCompare(String(b.name||''))):[];
      count.textContent=`${brands.length} ${brands.length===1?'Livery Brand':'Livery Brands'}`;
      heading.append(label,name);summary.append(heading,count);grid.className=`aw-brand-grid${brands.some((brand)=>brand.logo)?'':' is-text'}`;
      for(const brand of brands){
        const tile=document.createElement('div'),number=document.createElement('span');tile.className='aw-brand-tile';
        if(brand.logo){const image=document.createElement('img');image.src=brand.logo;image.alt=brand.name||'Brand logo';image.loading='lazy';image.addEventListener('error',()=>{const fallback=document.createElement('strong');fallback.textContent=brand.name||'Brand';image.replaceWith(fallback);},{once:true});tile.append(image);}
        else {const title=document.createElement('strong');title.textContent=brand.name||'Brand';tile.append(title);}
        number.textContent=String(brand.order||'').padStart(2,'0');tile.append(number);grid.append(tile);
      }
      details.append(summary,grid);fragment.append(details);
    }
    list.replaceChildren(fragment);
  }
  window.addEventListener('aetherwing:content',(event)=>updatePortfolios(event.detail));
  if(window.__AETHERWING_CONTENT__)updatePortfolios(window.__AETHERWING_CONTENT__);
</script>
