---
import Base from '../layouts/Base.astro';
import RaceCalendar from '../components/RaceCalendar.astro';
import { standings, results, news, rosterProfiles, drivers, partners, scheduleEvents } from '../lib/site-content.mjs';
import '../styles/home.css';
const chase=standings.find(s=>s.id==='nrrs');
const driver=chase?.rows?.find(r=>r.highlight);
const battleAssignment=drivers.find(d=>d.competitionId==='nrrs'&&d.number===driver?.number);
const leader=chase?.rows?.[0];
const latest=results.find(r=>r.featured)||results[0];
const leadNews=news.find(s=>s.featured)||news[0];
const upcoming=scheduleEvents.filter(e=>!e.offWeek&&e.date>='2026-09-23').sort((a,b)=>a.date.localeCompare(b.date))[0];
---
<Base>
  <section class="home-hero"><div class="wrap home-hero__inner"><div><p class="kicker">Aetherwing eMotorsports / 2026</p><h1>BUILT<br>TO <em>FIGHT.</em></h1><p class="home-hero__lead">One team. Multiple series. Every green flag is another chance to fly.</p><div class="home-hero__actions"><a class="btn" href="#race-calendar">Where we're racing ↓</a><a class="btn btn--ghost" href="/drivers/">Meet the lineup ↗</a></div></div><aside><span>THE GARAGE / 01</span><img src="/images/brand/aetherwing-logo.png" alt="Aetherwing emblem"/><strong>BORN TO SOAR.</strong><small>NRRS · UARL · iRacing · Alliance</small></aside></div></section>
  <RaceCalendar />
  <section class="section home-battle" id="championship-battle"><div class="wrap"><div class="section-head"><div><p class="eyebrow">What we're fighting for</p><h2 class="section-title">Championship Battle</h2></div><a class="btn btn--ghost" href="/championships/">Full standings ↗</a></div><div class="home-battle__grid"><div class="home-battle__number" data-battle-number>{battleAssignment?.numberImage?<img src={battleAssignment.numberImage} alt={`Number ${battleAssignment.number}`} />:`#${driver?.number||'32'}`}</div><div class="home-battle__copy"><span>{chase?.title||'NRRS Chase for the Cup'}</span><h3 data-battle-heading>{driver?`${driver.driver} · ${driver.position}`:'The championship fight'}</h3><p data-battle-context>{chase?.subtitle||'Season standings'} · {driver?.points?.toLocaleString('en-US')||'—'} PTS</p><div class="home-battle__markers"><div><b data-battle-gap>{driver?.delta||'—'}</b><small>TO LEADER</small></div><div><b data-battle-leader>{leader?.driver||'—'}</b><small>POINTS LEADER</small></div></div><a href="/championships/">Follow the battle ↗</a></div></div></div></section>
  <section class="section home-people"><div class="wrap"><div class="section-head"><div><p class="eyebrow">The people behind the numbers</p><h2 class="section-title">Garage Lineup</h2></div><p class="lede">Number art takes the spotlight until driver and car renders arrive.</p></div><div class="home-people__grid">{rosterProfiles.filter(d=>d.affiliation==='aetherwing').slice(0,4).map((person,index)=>{const number=person.numbers.split(' / ')[0],art=person.numberImages?.find(a=>a.number===number)?.image;return <a href="/drivers/" class="home-people__tile" data-profile={person.slug} data-number={number}><span>{String(index+1).padStart(2,'0')} / AETHERWING</span><b data-number-art>{art?<img src={art} alt={`Number ${number}`}/>:`#${number}`}</b><strong>{person.name}</strong><small>{person.programs.slice(0,2).join(' · ')}</small></a>})}</div><a class="home-people__more" href="/drivers/">Open the full garage →</a></div></section>
  <section class="section home-after"><div class="wrap"><div class="section-head"><div><p class="eyebrow">After the checkered flag</p><h2 class="section-title">Latest Result</h2></div><a href="/history/">Results archive ↗</a></div><article class="home-after__card"><div><span>{latest?.leagueName||'Aetherwing'} · {latest?.date||'LATEST'}</span><h3>{latest?.title||'Race results'}</h3><p>{latest?.track||''}</p></div><div>{latest?.entries?.map(e=><strong>#{e.number} {e.driver}<b>{e.finish?`P${e.finish}`:'DNS'}</b></strong>)}</div></article></div></section>
  <section class="section home-story"><div class="wrap"><div class="section-head"><div><p class="eyebrow">From the team wire</p><h2 class="section-title">The Newsroom</h2></div><a href="/news/">All stories ↗</a></div>{leadNews&&<a class="home-story__feature" href={`/news/${leadNews.slug}/`}><span>{leadNews.category} · {leadNews.date}</span><h3>{leadNews.title}</h3><p>{leadNews.summary}</p><b>Read story →</b></a>}</div></section>
  <section class="section home-sponsors"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Built together</p><h2 class="section-title">Team Partners</h2></div><a href="/partners/">Partner network ↗</a></div><div>{partners.map(partner=><a href={partner.url} target="_blank" rel="noopener noreferrer"><img src={partner.logo} alt={partner.name} loading="lazy"/><span>{partner.role}</span></a>)}</div></div></section>
</Base>
<script>
  window.addEventListener('aetherwing:content',({detail:d})=>{const board=d.standings?.find(s=>s.id==='nrrs'),row=board?.rows?.find(r=>r.highlight),lead=board?.rows?.[0];if(row){document.querySelector('[data-battle-heading]').textContent=`${row.driver} · ${row.position}`;document.querySelector('[data-battle-context]').textContent=`${board.subtitle} · ${Number(row.points||0).toLocaleString('en-US')} PTS`;document.querySelector('[data-battle-gap]').textContent=row.delta||'—';document.querySelector('[data-battle-leader]').textContent=lead?.driver||'—';}if(!Array.isArray(d.drivers))return;const show=(element,number,art)=>{if(!element)return;element.textContent=`#${number}`;if(art){const img=document.createElement('img');img.alt=`Number ${number}`;img.src=art;img.addEventListener('error',()=>{element.textContent=`#${number}`;},{once:true});element.replaceChildren(img);}};if(row){const assignment=d.drivers.find(a=>a.competitionId==='nrrs'&&String(a.number)===String(row.number));show(document.querySelector('[data-battle-number]'),row.number,assignment?.numberImage);}document.querySelectorAll('.home-people__tile[data-profile]').forEach(tile=>{const assignment=d.drivers.find(a=>a.profile===tile.dataset.profile&&String(a.number)===tile.dataset.number);show(tile.querySelector('[data-number-art]'),tile.dataset.number,assignment?.numberImage);});});
</script>
