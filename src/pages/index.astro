---
import { competitions as competitions } from "../lib/site-content.mjs";
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { rosterProfiles as roster } from "../lib/site-content.mjs";
import { scheduleEvents as events } from "../lib/site-content.mjs";
import { wins, partners } from '../lib/site-content.mjs';
import { results as result } from "../lib/site-content.mjs";
import { news as news } from "../lib/site-content.mjs";
import { standings as standings } from "../lib/site-content.mjs";
import '../styles/pages/home.css';
const initialTeam=roster.slice(0,4);
const initialCompetition=competitions[0];
const liveEvent=events.find((event)=>event.league==='uarl-d1' && /Daytona 500/i.test(event.title)) ?? events[0];
const latest=result.latestResult;
const featuredNews=news.find((story)=>story.featured) ?? news[0];
const nrrsChase=(standings as any[]).find((s:any)=>s.id==='nrrs');
const wispyRow=(nrrsChase?.rows??[]).find((row:any)=>row.highlight) ?? (nrrsChase?.rows??[]).find((row:any)=>row.driver==='Hailey') ?? (nrrsChase?.rows??[])[0];
const wispyPos=parseInt(String(wispyRow?.position??'P6').replace('P',''),10);
const wispyGap=Math.abs(parseInt(String(wispyRow?.delta??'-58'),10));
const nextNrrsChase=events.filter((event)=>event.league==='nrrs' && event.date>new Date(latest.date).toISOString().slice(0,10) && !event.offWeek).sort((a,b)=>a.date.localeCompare(b.date))[0];
const chaseField=Array.from({length:12},(_,i)=>{
  const pos=i+1;
  const row=(nrrsChase?.rows as any[]??[]).find((r:any)=>parseInt(String(r.position).replace('P',''),10)===pos);
  return{pos,driver:row?.driver??null,number:row?.number??null,isWispy:pos===wispyPos,eligible:row?.chaseEligible!==false&&row!=null};
});
---
<BaseLayout title="Aetherwing eMotorsports" description="Aetherwing eMotorsports — competition, drivers, schedule, Paint Booth, news, partners, and team history.">
  <section class="aw-home-hero">
    <div class="shell aw-home-hero__inner">
      <div class="aw-home-hero__copy">
        <span class="aw-home-kicker">2026 Competition Network</span>
        <div class="aw-home-mark">Aetherwing eMOTORSPORTS</div>
        <h1><span>Born to Soar.</span><b>Built to Fight.</b></h1>
        <h2>NR2003. Roblox. iRacing.</h2>
        <p>A multi-series online racing organization built around sharp identity, clean execution, sponsor-first presentation, and a growing 2026 competition footprint.</p>
        <div class="aw-home-actions"><a class="btn" href="/drivers/">View Drivers</a><a class="btn btn--ghost" href="/schedule/#next-operation">Next Race / Schedule</a></div>
      </div>
      <aside class="aw-glance panel">
        <span class="aw-paper-label">Aetherwing at a glance</span>
        <div class="aw-glance__story">
          <strong>{roster.length}</strong>
          <p>active RoRacing drivers carry Aetherwing and the StarClutch Racing Alliance across a six-series competition network.</p>
        </div>
        <div class="aw-glance__line"><span>04 Aetherwing programs</span><span>02 alliance series</span><span>03 racing worlds</span></div>
      </aside>
    </div>
  </section>

  <div class="aw-home-stats">
    <div class="shell aw-proof-strip">
      <strong>{wins.length}</strong>
      <p>verified Aetherwing wins anchor a record built across {site.estimatedStarts} estimated starts since {site.founded}.</p>
      <span>{site.competitionRelationships} current competition relationships</span>
    </div>
  </div>

  <section class="aw-chase-section">
    <div class="shell">
      <div class="aw-chase-story">
        <div>
          <p class="eyebrow">NRRS Chase for the Cup · {nrrsChase?.subtitle ?? 'After Chase Race 1 of 6'}</p>
          <h2>{wispyRow?.driver ?? latest.driver} is {wispyRow?.position ?? 'unranked'} in the Chase, {wispyGap} points off the lead heading to {nextNrrsChase?.track?.replace(' Raceway','') ?? 'Richmond'}.</h2>
          <p>The No. {wispyRow?.number ?? latest.number} carries {(wispyRow?.points ?? 0).toLocaleString('en-US')} points after {latest.title}, where {latest.driver} finished P{latest.finish} with {latest.stagePoints} stage points.</p>
        </div>
        <div class="aw-chase-position" aria-label={`Hailey is ${wispyRow?.position ?? 'P6'} in the NRRS Chase`}>
          <span>Chase position</span>
          <strong>{wispyRow?.position ?? 'P6'}</strong>
          <em>{wispyRow?.positionChange ?? '—'} · {nrrsChase?.subtitle}</em>
        </div>
      </div>

      <details class="aw-chase-details">
        <summary><span>Open the complete Chase field</span><small>Positions, drivers and cut-line context</small></summary>
        <div class="aw-chase-detail-body">
          <div class="aw-chase-zone-label">The Chase — 6 Eligible Drivers</div>
          <div class="aw-chase-field aw-chase-field--chase">
            {chaseField.filter(s=>s.eligible||s.pos<=6).map(({pos,driver,number,isWispy})=>{
              const zone=pos<=4?'safe':'bubble';
              return <div class:list={['aw-chase-slot',`is-${zone}`,{'is-wispy':isWispy}]} aria-label={driver?`P${pos} ${driver}`:`P${pos}`}>
                <span class="aw-chase-slot-pos">P{pos}</span>
                {driver && <strong>#{number}</strong>}
                {driver && <em>{driver}</em>}
              </div>;
            })}
          </div>

          <div class="aw-chase-zone-label aw-chase-zone-label--dim">Non-Chase Runners</div>
          <div class="aw-chase-field aw-chase-field--non-chase">
            {chaseField.filter(s=>!s.eligible&&s.pos>6).map(({pos,driver,number})=>(
              <div class="aw-chase-slot is-non-chase" aria-label={driver?`P${pos} ${driver}`:`P${pos}`}>
                <span class="aw-chase-slot-pos">P{pos}</span>
                {driver && <strong>#{number}</strong>}
                {driver && <em>{driver}</em>}
              </div>
            ))}
          </div>

          <div class="aw-chase-legend">
            <span class="is-safe">Locked In (P1–4)</span>
            <span class="is-bubble">On The Bubble (P5–6)</span>
            <span class="is-non-chase">Non-Chase (P7–12)</span>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="section aw-race-control" data-brush="RACE CONTROL" id="next-event">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Aetherwing Race Control</p><h2 class="section-title">Next Event</h2></div>
        <p class="lede">The next green flag across the Aetherwing schedule, with live-state treatment when an event window is active.</p>
      </div>
      <a class="aw-next-event panel" href="/schedule/#next-operation">
        <div class="aw-next-event__left">
          <span class="tag" data-home-event-state>UPCOMING</span>
          <small data-home-event-league>{liveEvent.leagueName} · {liveEvent.status}</small>
          <h3 data-home-event-title>{liveEvent.title}</h3>
          <p data-home-event-meta>{liveEvent.track} · {liveEvent.displayDate ?? liveEvent.date} · {liveEvent.time}</p>
        </div>
        <div class="aw-next-event__right">
          <span>Next Operation</span>
          <strong data-home-countdown>CALCULATING</strong>
          <small data-home-count-label>Race Control syncing…</small>
        </div>
      </a>
    </div>
  </section>

  <section class="section aw-team-section" data-brush="THE ROSTER">
    <div class="shell">
      <div class="section-head"><div><p class="eyebrow">Aetherwing Racing Team</p><h2 class="section-title">Meet the Team</h2></div><p class="lede">Hailey stays anchored. Three other current RoRacing drivers rotate on each visit so the homepage does not become the same static wall every time.</p></div>
      <div class="aw-team-browser" data-team-browser>
        <div class="aw-team-cards" data-team-cards>
          {initialTeam.map((driver,index)=><button class:list={['aw-team-card',{'is-selected':index===0}]} type="button" data-driver-slug={driver.slug}><small>{driver.role}</small><strong>#{driver.numbers}</strong><h3>{driver.name}</h3><span>{driver.feature}</span></button>)}
        </div>
        <article class="aw-team-detail panel" data-team-detail>
          <div><span class="tag">Founder / Driver</span><h3>Hailey</h3><p class="mono">@Aokikoto · #15 / #28 / #32 / #54</p><p>Aetherwing founder and multi-program driver across RoRacing and iRacing.</p></div>
          <a class="btn" href="/drivers/">Open Driver Hub</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section aw-programs" data-brush="WHERE WE COMPETE">
    <div class="shell">
      <div class="section-head"><div><p class="eyebrow">Aetherwing Competition Relationships</p><h2 class="section-title">Where We Compete</h2></div><p class="lede">Six current relationships: 4 active programs under the Aetherwing banner and 2 alliance series represented through StarClutch Racing. UARL D2 has closed operations.</p></div>
      <div class="aw-program-browser" data-program-browser>
        <div class="aw-program-tabs" role="tablist" aria-label="Competition relationships">
          {competitions.map((competition,index)=><button type="button" role="tab" aria-selected={index===0?'true':'false'} data-program={competition.id} class:list={[{'is-alliance':competition.type==='alliance'}]}><span>{String(index+1).padStart(2,'0')}</span>{competition.name}</button>)}
        </div>
        <article class="aw-program-detail panel" data-program-detail data-type={initialCompetition.type}>
          <div class="aw-program-detail__head"><span class="tag">{initialCompetition.label}</span><small>{initialCompetition.schedule}</small></div>
          <h3>{initialCompetition.name}</h3>
          <p class="aw-program-machine">{initialCompetition.machine}</p>
          <p class="mono muted">{initialCompetition.platform}</p>
          <div class="aw-program-roster">{initialCompetition.roster.map((entry)=><span>{entry}</span>)}</div>
        </article>
      </div>
    </div>
  </section>

  <section class="section aw-news-deck" data-brush="LATEST FROM THE GARAGE">
    <div class="shell">
      <div class="section-head"><div><p class="eyebrow">Aetherwing Racing News</p><h2 class="section-title">Latest Updates</h2></div><p class="lede">Race results, team updates, partner notes, and movement from across the garage.</p></div>
      <div class="aw-news-grid">
        <a class="aw-feature-story panel" href={`/news/${featuredNews.slug}/`}><span class="tag tag--gold">{featuredNews.category}</span><small>{featuredNews.date} · {featuredNews.context} · {featuredNews.kicker}</small><h3>{featuredNews.title}</h3><p>{featuredNews.summary}</p><b>Read the Story →</b></a>
        <article class="aw-result-card aw-result-ticket">
          <div class="aw-result-ticket__head"><span>CHECKERED // LATEST RESULT</span><b>{latest.specialTag}</b></div>
          <div class="aw-result-ticket__body"><div><small>{latest.series}</small><h3>{latest.title}</h3><p>{latest.track} · {latest.date}</p><strong>#{latest.number} {latest.driver}</strong></div><div class="aw-result-ticket__p4"><span>FINISH</span><b>P{latest.finish}</b><em>{latest.finish===1?'WINNER':latest.finish<=5?'TOP 5':latest.finish<=10?'TOP 10':'FINISH'}</em></div></div>
          <div class="aw-result-ticket__run"><span>P{latest.start}<small>START</small></span><i>→</i><span>{latest.stagePoints}<small>STAGE PTS</small></span><i>→</i><span class="is-final">P{latest.finish}<small>CHECKERED</small></span></div>
          <div class="aw-result-ticket__foot"><span>{latest.specialTag} · {latest.stagePoints} STAGE POINTS</span><a href="/wins-history/#latest-result">Open Post-Race Graphic →</a></div>
        </article>
        <div class="aw-quick-links">
          <a class="panel" href="/drivers/"><small>Roster Updated</small><strong>Driver Hub</strong><span>Current drivers, programs, and Factory entries →</span></a>
          <a class="panel" href="/team-handbook/"><small>Operations</small><strong>Team Handbook</strong><span>Standards, race-week rules, and communication →</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-partner-strip" data-brush="PARTNER NETWORK">
    <div class="shell">
      <div class="section-head"><div><p class="eyebrow">Aetherwing Partner Network</p><h2 class="section-title">Partner Network</h2></div><p class="lede">Two featured public-facing relationships. Driver livery brands remain a separate portfolio.</p></div>
      <div class="aw-partner-grid">
        {partners.map((partner)=><a class="aw-partner panel" href={partner.url} target="_blank" rel="noopener noreferrer"><div class="aw-partner-logo"><img loading="lazy" src={partner.logo} alt={partner.name} /></div><div><span class="tag">{partner.role}</span><h3>{partner.name}</h3><p>{partner.description}</p></div></a>)}
      </div>
    </div>
  </section>

  <section class="section aw-follow">
    <div class="shell">
      <div class="aw-follow__card">
        <span class="aw-paper-label">Follow the Flight</span><h2>Keep exploring the garage.</h2><p>Jump into the roster, Partner Network, schedule, record book, and team standards without losing the Aetherwing identity.</p><div><a class="btn" href="/drivers/">View Drivers</a><a class="btn btn--ghost" href="/partners/">View Partners</a><a class="btn btn--ghost" href="/wins-history/">Wins & History</a></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ roster, competitions, events }}>
  const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const countdown=document.querySelector('[data-home-countdown]');
  const homeLeague=document.querySelector('[data-home-event-league]');
  const homeTitle=document.querySelector('[data-home-event-title]');
  const homeMeta=document.querySelector('[data-home-event-meta]');
  const homeLabel=document.querySelector('[data-home-count-label]');
  const homeState=document.querySelector('[data-home-event-state]');
  const pad=(n)=>String(n).padStart(2,'0');
  const offsetFor=(dateKey)=>{const [y,m,d]=dateKey.split('-').map(Number);const noon=new Date(Date.UTC(y,m-1,d,12));const tz=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',timeZoneName:'shortOffset',hour:'2-digit'}).formatToParts(noon).find(p=>p.type==='timeZoneName')?.value||'GMT-4';const match=tz.match(/GMT([+-])(\d{1,2})(?::?(\d{2}))?/);return match?`${match[1]}${pad(match[2])}:${pad(match[3]||'00')}`:'-04:00';};
  const parseTime=(text)=>{if(!text||text==='Event Window'||text==='TBD'||text==='NO RACE')return{hour:12,minute:0};const match=text.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);if(!match)return{hour:20,minute:0};let hour=Number(match[1]);const minute=Number(match[2]);if(match[3].toUpperCase()==='PM'&&hour!==12)hour+=12;if(match[3].toUpperCase()==='AM'&&hour===12)hour=0;return{hour,minute};};
  const startOf=(event)=>{if(event.league==='iracing'||event.offWeek)return new Date(`${event.date}T00:00:00${offsetFor(event.date)}`);const t=parseTime(event.time);return new Date(`${event.date}T${pad(t.hour)}:${pad(t.minute)}:00${offsetFor(event.date)}`);};
  const endOf=(event)=>{if(event.league==='iracing'||event.offWeek||event.tbd){const key=event.endDate||event.date;return new Date(`${key}T23:59:59${offsetFor(key)}`);}return new Date(startOf(event).getTime()+((event.durationMinutes||90)*60000));};
  const displayDate=(event)=>{if(event.displayDate)return event.displayDate.toUpperCase();const [y,m,d]=event.date.split('-').map(Number);return new Date(Date.UTC(y,m-1,d,12)).toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'UTC'}).toUpperCase();};
  const selectPrimaryOperation=(items,now=new Date())=>{const candidates=items.filter(event=>!event.offWeek&&endOf(event)>=now);const fixed=candidates.filter(event=>event.league!=='iracing'&&!event.tbd);const live=fixed.filter(event=>now>=startOf(event)&&now<=endOf(event)).sort((a,b)=>startOf(a)-startOf(b));if(live.length)return live[0];const soonLimit=new Date(now.getTime()+36*60*60*1000);const soon=fixed.filter(event=>startOf(event)>now&&startOf(event)<=soonLimit).sort((a,b)=>startOf(a)-startOf(b));if(soon.length)return soon[0];const windows=candidates.filter(event=>event.league==='iracing'&&now>=startOf(event)&&now<=endOf(event)).sort((a,b)=>startOf(a)-startOf(b));if(windows.length)return windows[0];return candidates.filter(event=>startOf(event)>now).sort((a,b)=>startOf(a)-startOf(b))[0]||candidates[0];};
  const updateHomeEvent=()=>{const now=new Date();const event=selectPrimaryOperation(events,now);if(!event||!(countdown instanceof HTMLElement))return;homeLeague.textContent=`${event.leagueName} · ${event.status||'Scheduled'}`;homeTitle.textContent=event.title;homeMeta.textContent=`${event.track} · ${displayDate(event)} · ${event.time}`;const start=startOf(event),end=endOf(event);if(now>=start&&now<=end){countdown.textContent='LIVE';countdown.classList.add('is-live');if(homeState){homeState.textContent='LIVE';homeState.classList.add('tag--live');}homeLabel.textContent=event.league==='iracing'?'Current iRacing special-event window':'Event currently active';return;}countdown.classList.remove('is-live');if(homeState){homeState.textContent='UPCOMING';homeState.classList.remove('tag--live');}const diff=Math.max(0,start-now),d=Math.floor(diff/86400000),h=Math.floor(diff%86400000/3600000),m=Math.floor(diff%3600000/60000),s=Math.floor(diff%60000/1000);countdown.textContent=d>0?`${d}D ${pad(h)}H`:h>0?`${pad(h)}H ${pad(m)}M`:`${pad(m)}M ${pad(s)}S`;homeLabel.textContent=d>0||h>0?'Until next operation':'Green flag approaching';};
  updateHomeEvent();setInterval(updateHomeEvent,1000);
  const teamBrowser=document.querySelector('[data-team-browser]');
  if(teamBrowser){
    const cards=teamBrowser.querySelector('[data-team-cards]');
    const detail=teamBrowser.querySelector('[data-team-detail]');
    const anchor=roster.find(d=>d.slug==='wispy') ?? roster[0];
    const pool=roster.filter(d=>d.slug!==anchor.slug).sort(()=>Math.random()-.5).slice(0,3);
    const selected=[anchor,...pool].filter(Boolean);
    const renderDetail=(driver)=>{if(!(detail instanceof HTMLElement)||!driver)return;detail.innerHTML=`<div><span class="tag ${driver.affiliation==='alliance'?'tag--alliance':''}">${driver.role}</span><h3>${driver.name}</h3><p class="mono">${driver.handle||''}${driver.handle?' · ':''}#${driver.numbers}</p><p>${driver.bio}</p><p class="mono muted">${driver.programs.join(' · ')}</p></div><a class="btn" href="/drivers/">Open Driver Hub</a>`;};
    if(cards instanceof HTMLElement){cards.innerHTML=selected.map((driver,i)=>`<button class="aw-team-card ${i===0?'is-selected':''}" type="button" data-driver-slug="${driver.slug}"><small>${driver.role}</small><strong>#${driver.numbers}</strong><h3>${driver.name}</h3><span>${driver.feature}</span></button>`).join('');cards.querySelectorAll('button').forEach(btn=>btn.addEventListener('click',()=>{cards.querySelectorAll('button').forEach(b=>b.classList.remove('is-selected'));btn.classList.add('is-selected');renderDetail(roster.find(d=>d.slug===btn.dataset.driverSlug));}));}
  }
  const programBrowser=document.querySelector('[data-program-browser]');
  if(programBrowser){
    const tabs=programBrowser.querySelectorAll('[role="tab"]');
    const detail=programBrowser.querySelector('[data-program-detail]');
    const renderProgram=(program)=>{if(!(detail instanceof HTMLElement)||!program)return;detail.dataset.type=program.type;detail.classList.toggle('panel--alliance',program.type==='alliance');detail.innerHTML=`<div class="aw-program-detail__head"><span class="tag ${program.type==='alliance'?'tag--alliance':''}">${program.label}</span><small>${program.schedule}</small></div><h3>${program.name}</h3><p class="aw-program-machine">${program.machine}</p><p class="mono muted">${program.platform}</p><div class="aw-program-roster">${program.roster.map(entry=>`<span>${entry}</span>`).join('')}</div>`;};
    tabs.forEach(tab=>tab.addEventListener('click',()=>{tabs.forEach(t=>t.setAttribute('aria-selected','false'));tab.setAttribute('aria-selected','true');renderProgram(competitions.find(p=>p.id===tab.dataset.program));if(!reduceMotion&&detail instanceof HTMLElement)detail.animate([{opacity:.35,transform:'translateY(5px)'},{opacity:1,transform:'none'}],{duration:180,easing:'ease-out'});}));
  }

  // Count-up animation for stat numbers
  if(!reduceMotion){
    const animateNum=(el)=>{
      const raw=el.textContent.trim();
      const digits=raw.replace(/[^0-9]/g,'');
      const num=parseInt(digits,10);
      if(!Number.isFinite(num)||num===0)return;
      const prefix=raw.match(/^[^0-9]*/)?.[0]||'';
      const suffix=raw.match(/[^0-9]*$/)?.[0]||'';
      const zeroPad=raw.startsWith('0')&&digits.length>1;
      const dur=900,frames=54;
      let f=0;
      const tick=()=>{
        f++;
        const ease=1-Math.pow(1-(f/frames),3);
        const cur=Math.round(num*ease);
        el.textContent=prefix+(zeroPad?String(cur).padStart(digits.length,'0'):cur)+suffix;
        if(f<frames)requestAnimationFrame(tick);
        else el.textContent=raw;
      };
      requestAnimationFrame(tick);
    };
    const statsIO=new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        if(!entry.isIntersecting)return;
        statsIO.unobserve(entry.target);
        entry.target.querySelectorAll('strong').forEach(animateNum);
      });
    },{threshold:0.5});
    document.querySelectorAll('.aw-glance__grid,.stat-rail').forEach(el=>statsIO.observe(el));
  }
</script>
