---
import Base from '../layouts/Base.astro';
import { siteSettings, standings, results, news, rosterProfiles, drivers, partners, competitions } from '../lib/site-content.mjs';
import OnTrackNext from '../components/home/OnTrackNext.astro';
import TimingTower from '../components/home/TimingTower.astro';
import UpNext from '../components/home/UpNext.astro';
import '../styles/ux-home.css';
const teamStats=[[siteSettings.verifiedWins,'Verified wins','verifiedWins'],[siteSettings.estimatedStarts,'Race starts','estimatedStarts'],[siteSettings.competitionRelationships,'Programs','competitionRelationships'],[siteSettings.founded,'Founded','founded']].filter(([value])=>value!==undefined&&value!=='');
const chase=standings.find(s=>s.id==='nrrs');
const driver=chase?.rows?.find(r=>r.highlight);
const battleAssignment=drivers.find(d=>d.competitionId==='nrrs'&&d.number===driver?.number);
const leader=chase?.rows?.[0];
const latest=results.find(r=>r.featured)||[...results].sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')))[0];
const compactResultEntries=(race)=>{const entries=race?.entries||[],featured=entries.filter(e=>e.featuredDriver);return (featured.length?featured:entries).slice(0,3);};
const leadNews=news.find(s=>s.featured)||news[0];
const moreNews=news.filter(s=>s!==leadNews).slice(0,2);
const garageProgramOrder={nrrs:1,'uarl-d1':2,'uarl-open':3,kmart:4,sunoco:5};
const garageProgramShort={nrrs:'NRRS','uarl-d1':'UARL D1','uarl-open':'UARL OPEN',kmart:'KMART',sunoco:'SUNOCO'};
const garageRides=(person)=>drivers.filter(d=>d.profile===person.slug&&d.affiliation==='aetherwing').sort((a,b)=>(garageProgramOrder[a.competitionId]||99)-(garageProgramOrder[b.competitionId]||99));
const programLogo={
  nrrs:'/images/schedule-logos/nrrs.png',
  'uarl-d1':'/images/schedule-logos/uarl-d1.png',
  'uarl-open':'/images/schedule-logos/open.png',
  'iracing-factory':'/images/schedule-logos/iracing.png',
  kmart:'/images/schedule-logos/kmart-regular.jpg',
  sunoco:'/images/schedule-logos/sunoco.png'
};
---
<Base>
  <section class="hub-hero" aria-labelledby="hub-title">
    <div class="hub-hero__copy">
      <p class="ux-kicker"><b>AEM</b>Aetherwing eMotorsports · {new Date().getFullYear()}</p>
      <h1 id="hub-title" class="hub-hero__title">Born to <em>soar.</em><br/>Built to fight.</h1>
      <p class="ux-lede">Sim racing and RoRacing across {competitions.length} programs. Follow the next green flag, the championship fight and every story from the garage.</p>
      <div class="hub-hero__actions"><a class="ux-btn" href="/schedule/">Race schedule</a><a class="ux-btn ux-btn--ghost" href="/drivers/">Meet the drivers</a></div>
    </div>
    <OnTrackNext />
  </section>

  {teamStats.length>0&&<dl class="ux-stats hub-stats" aria-label="Aetherwing at a glance">{teamStats.map(([value,label,key])=><div><dt>{label}</dt><dd data-team-stat={key}>{value}</dd></div>)}</dl>}

  <div class="hub-grid">
    <section class="ux-section hub-battle" aria-labelledby="battle-title">
      <div class="ux-section__head"><div><p class="ux-tag"><b>●</b>{chase?.status||'Championship'}</p><h2 class="ux-h2" id="battle-title">The championship fight</h2></div><a class="ux-more" href="/championships/">Full standings</a></div>
      <div class="ux-card hub-battle__card">
        <div class="hub-battle__driver">
          <span class="hub-battle__number" data-battle-number>{(battleAssignment?.numberImageBackup||battleAssignment?.numberImage)?<img src={battleAssignment.numberImageBackup||battleAssignment.numberImage} alt={`Number ${battleAssignment.number}`} />:`#${driver?.number||'32'}`}</span>
          <div>
            <h3 data-battle-heading>{driver?`${driver.driver} · ${driver.position}`:'The championship fight'}</h3>
            <p data-battle-context>{chase?.subtitle||'Season standings'} · {driver?.points?.toLocaleString('en-US')||'—'} PTS</p>
          </div>
          <dl class="hub-battle__marks"><div><dt>To leader</dt><dd data-battle-gap>{driver?.delta||'—'}</dd></div><div><dt>Points leader</dt><dd data-battle-leader>{leader?.driver||'—'}</dd></div></dl>
        </div>
        <TimingTower />
      </div>
    </section>

    <section class="ux-section hub-next" aria-labelledby="next-title">
      <div class="ux-section__head"><div><p class="ux-tag">Race control</p><h2 class="ux-h2" id="next-title">Up next</h2></div><a class="ux-more" href="/schedule/">Schedule</a></div>
      <UpNext />
      <article class="ux-card ux-card--pad hub-result" data-latest-result>
        <p class="ux-tag" data-latest-meta>{latest?.leagueName||'Aetherwing'} · {latest?.date||'LATEST'}</p>
        <h3 data-latest-title>{latest?.title||'Race results'}</h3>
        <p data-latest-track>{latest?.track||''}</p>
        <div class="hub-result__entries" data-latest-entries>{compactResultEntries(latest).map(e=><strong>{e.number?`#${e.number} `:''}{e.driver}<b>{e.finish?`P${e.finish}`:'DNS'}</b></strong>)}</div>
        <a class="ux-more" href="/history/">Results archive</a>
      </article>
    </section>
  </div>

  <section class="ux-section" aria-labelledby="wire-title">
    <div class="ux-section__head"><div><p class="ux-tag">Team wire</p><h2 class="ux-h2" id="wire-title">Latest stories</h2></div><a class="ux-more" href="/news/">Newsroom</a></div>
    <div class="hub-wire">
      {leadNews&&<a class="ux-card hub-wire__lead" href={`/news/${leadNews.slug}/`}><span class="ux-tag"><b>{leadNews.category}</b>{leadNews.date}</span><h3>{leadNews.title}</h3><p>{leadNews.summary}</p><span class="ux-more">Read story</span></a>}
      {moreNews.map(story=><a class="ux-card ux-card--pad hub-wire__item" href={`/news/${story.slug}/`}><span class="ux-tag">{story.date}</span><h3>{story.title}</h3></a>)}
    </div>
  </section>

  <section class="ux-section" aria-labelledby="programs-title">
    <div class="ux-section__head"><div><p class="ux-tag">Where we race</p><h2 class="ux-h2" id="programs-title">Programs</h2></div><a class="ux-more" href="/programs/">All programs</a></div>
    <div class="home-programs__rail hub-rail">{competitions.map(program=><a href={`/programs/${program.id}/`} class:list={['ux-card','hub-program',{'is-alliance':program.label?.toLowerCase().includes('alliance')}]}><span class="hub-program__logo">{programLogo[program.id]?<img src={programLogo[program.id]} alt="" loading="lazy"/>:<b>{program.name}</b>}</span><small>{program.label}</small><strong>{program.name}</strong></a>)}</div>
  </section>

  <section class="ux-section" aria-labelledby="garage-title">
    <div class="ux-section__head"><div><p class="ux-tag">The garage</p><h2 class="ux-h2" id="garage-title">Drivers</h2></div><a class="ux-more" href="/drivers/">Full lineup</a></div>
    <div class="hub-rail hub-drivers">{rosterProfiles.filter(d=>d.affiliation==='aetherwing').slice(0,6).map((person)=>{const rides=garageRides(person),primary=rides[0],number=String(primary?.number||person.numbers.split(' / ')[0]||''),art=person.numberImages?.find(a=>String(a.number)===number)?.image,credentials=rides.slice(0,2).map(ride=>`#${ride.number} ${garageProgramShort[ride.competitionId]||ride.competition}`);return <a href={`/drivers/${person.slug}/`} class="ux-card ux-driver" data-profile={person.slug} data-number={number}><b class="ux-driver__number" data-number-art>{art ? <img src={art} alt={`Number ${number}`}/> : `#${number}`}</b><strong>{person.name}</strong><small data-program-numbers>{credentials.join(' / ')}</small></a>})}</div>
  </section>

  <section class="ux-section" aria-labelledby="partners-title">
    <div class="ux-section__head"><div><p class="ux-tag">Built together</p><h2 class="ux-h2" id="partners-title">Team partners</h2></div><a class="ux-more" href="/partners/">Partner network</a></div>
    <div class="hub-partners" data-home-partners>{partners.map(partner=><a href={partner.url} target="_blank" rel="noopener noreferrer"><img src={partner.logo} alt={partner.name} loading="lazy"/><span>{partner.role}</span></a>)}</div>
  </section>

  <section class="ux-section hub-faith" aria-labelledby="faith-heading">
    <p class="ux-tag" data-faith-eyebrow>{siteSettings.faithEyebrow||'Before every green flag'}</p>
    <h2 id="faith-heading" class="ux-h2" data-faith-title>{siteSettings.faithTitle||'To God Be the Glory.'}</h2>
    <p data-faith-statement>{siteSettings.faithStatement||'Every time we get behind the wheel, we thank God for the opportunity to compete. Through every win, every loss, and every challenge, we give Him the glory for bringing us this far.'}</p>
    <span data-faith-verse>{siteSettings.faithVerse||'Matthew 17:20'}</span>
  </section>
</Base>
<script>
  const applyLiveHome=(d)=>{const liveSite=d.site||{};const setText=(selector,value)=>{const el=document.querySelector(selector);if(el&&value)el.textContent=value;};const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));setText('[data-faith-eyebrow]',liveSite.faithEyebrow);setText('[data-faith-title]',liveSite.faithTitle);setText('[data-faith-statement]',liveSite.faithStatement);setText('[data-faith-verse]',liveSite.faithVerse);if(Array.isArray(d.partners)){const partnerRoot=document.querySelector('[data-home-partners]');if(partnerRoot){partnerRoot.innerHTML=d.partners.map(partner=>`<a href="${esc(/^https:\/\//i.test(String(partner.url||''))?partner.url:'#')}" target="_blank" rel="noopener noreferrer">${partner.logo?`<img src="${esc(partner.logo)}" alt="${esc(partner.name)}" loading="lazy">`:`<strong>${esc(partner.name)}</strong>`}<span>${esc(partner.role)}</span></a>`).join('');partnerFallback();}}document.querySelectorAll('[data-team-stat]').forEach(node=>{const value=liveSite[node.dataset.teamStat];if(value!==undefined&&value!=='')node.textContent=String(value);});if(Array.isArray(d.results)&&d.results.length){const liveLatest=d.results.find(r=>r.featured)||[...d.results].sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')))[0];if(liveLatest){setText('[data-latest-meta]',`${liveLatest.leagueName||'Aetherwing'} · ${liveLatest.date||'LATEST'}`);setText('[data-latest-title]',liveLatest.title||'Race results');setText('[data-latest-track]',liveLatest.track||'');const entries=document.querySelector('[data-latest-entries]');if(entries){const all=liveLatest.entries||[],featured=all.filter(e=>e.featuredDriver),compact=(featured.length?featured:all).slice(0,3);entries.innerHTML=compact.map(e=>`<strong>${e.number?`#${esc(e.number)} `:''}${esc(e.driver)}<b>${e.finish?`P${esc(e.finish)}`:'DNS'}</b></strong>`).join('');}}}const board=d.standings?.find(s=>s.id==='nrrs'),row=board?.rows?.find(r=>r.highlight),lead=board?.rows?.[0];if(row){document.querySelector('[data-battle-heading]').textContent=`${row.driver} · ${row.position}`;document.querySelector('[data-battle-context]').textContent=`${board.subtitle} · ${Number(row.points||0).toLocaleString('en-US')} PTS`;document.querySelector('[data-battle-gap]').textContent=row.delta||'—';document.querySelector('[data-battle-leader]').textContent=lead?.driver||'—';}if(!Array.isArray(d.drivers))return;const show=(element,number,art)=>{if(!element)return;element.textContent=`#${number}`;if(art){const img=document.createElement('img');img.alt=`Number ${number}`;img.src=art;img.addEventListener('error',()=>{element.textContent=`#${number}`;},{once:true});element.replaceChildren(img);}};if(row){const assignment=d.drivers.find(a=>a.competitionId==='nrrs'&&String(a.number)===String(row.number));show(document.querySelector('[data-battle-number]'),row.number,assignment?.numberImageBackup||assignment?.numberImage);}document.querySelectorAll('.ux-driver[data-profile]').forEach(tile=>{const rides=d.drivers.filter(a=>a.profile===tile.dataset.profile&&a.affiliation==='aetherwing').sort((a,b)=>({nrrs:1,'uarl-d1':2,'uarl-open':3,kmart:4,sunoco:5}[a.competitionId]||99)-({nrrs:1,'uarl-d1':2,'uarl-open':3,kmart:4,sunoco:5}[b.competitionId]||99));const assignment=rides[0]||d.drivers.find(a=>a.profile===tile.dataset.profile);if(assignment){tile.dataset.number=String(assignment.number||'');show(tile.querySelector('[data-number-art]'),assignment.number,assignment?.numberImageBackup||assignment?.numberImage);}const meta=tile.querySelector('[data-program-numbers]');if(meta)meta.textContent=rides.slice(0,2).map(a=>`#${a.number} ${{nrrs:'NRRS','uarl-d1':'UARL D1','uarl-open':'UARL OPEN',kmart:'KMART',sunoco:'SUNOCO'}[a.competitionId]||a.competition}`).join(' / ');});};
  // Hot-linked partner logos sometimes fail; show the partner name instead of an empty tile.
  function partnerFallback(){document.querySelectorAll('[data-home-partners] img').forEach(img=>{const swap=()=>{const name=document.createElement('strong');name.textContent=img.alt;img.replaceWith(name);};if(img.complete&&img.naturalWidth===0)swap();else img.addEventListener('error',swap,{once:true});});}
  partnerFallback();
  window.addEventListener('aetherwing:content',({detail})=>applyLiveHome(detail));
  if(window.__AETHERWING_CONTENT__)applyLiveHome(window.__AETHERWING_CONTENT__);
</script>
