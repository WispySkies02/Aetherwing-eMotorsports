---
import { siteSettings } from '../lib/site-content.mjs';
import SiteHeader from '../components/global/SiteHeader.astro';
import '../styles/site.css';
interface Props { title?:string; description?:string; image?:string; }
const { title='Aetherwing eMotorsports', description=siteSettings.description, image='/images/social/default-social.png' }=Astro.props;
const fullTitle=title==='Aetherwing eMotorsports'?title:`${title} | Aetherwing eMotorsports`;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#090a0c"/>
  <title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
  <meta property="og:type" content="website"/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(image,Astro.site).href}/>
  <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml"/>
  <link rel="stylesheet" href="/seasonal-effects.css"/>
  <script is:inline src="/seasonal-theme.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="preconnect" href="https://fonts.cdnfonts.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Saira+Condensed:ital,wght@0,500;0,600;0,700;0,800;0,900;1,500;1,600;1,700;1,800;1,900&family=Share+Tech+Mono&family=Tomorrow:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet"/>
</head><body>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />
  <div class="aw-season-banner" data-season-banner role="note" aria-label="Seasonal theme" hidden><i class="aw-season-banner__icon" data-season-icon aria-hidden="true"></i><span data-season-title></span><b data-season-subtitle></b></div>
  <main id="main"><slot/></main>
  <footer class="site-footer"><div class="wrap footer-grid"><div><strong>AETHERWING <em>eMOTORSPORTS</em></strong><p>Born to Soar. Built to Fight.</p></div><div><span>THE GARAGE</span><a href="/schedule/">Race calendar</a><a href="/drivers/">Driver lineup</a><a href="/paint-booth/">Paint Booth</a></div><div><span>THE TEAM</span><a href="/partners/">Partners</a><a href="/news/">Newsroom</a><a href="/history/">History</a></div><div><span>FOLLOW THE FLIGHT</span><a href={siteSettings.discordUrl}>Discord ↗</a><a href="https://paint.aetherwing.net/">Full scene viewer ↗</a><a href="/admin/">Team admin ↗</a></div></div><div class="wrap footnote"><span>© {new Date().getFullYear()} Aetherwing eMotorsports</span><strong>TO GOD BE THE GLORY · {siteSettings.faithVerse||'Matthew 17:20'}</strong></div></footer>
  <script is:inline>
    (()=>{const page=location.pathname.replace(/\/+$/,'/')||'/';const apply=(rules)=>{for(const rule of Array.isArray(rules)?rules:[]){if(rule.enabled===false||!['*',page].includes(rule.page)||rule.value===rule.original)continue;if(rule.type==='link')document.querySelectorAll('a[href]').forEach(a=>{if(a.getAttribute('href')===rule.original)a.setAttribute('href',rule.value);});else if(rule.type==='image')document.querySelectorAll('img[src]').forEach(img=>{if(img.getAttribute('src')===rule.original)img.setAttribute('src',rule.value);});else if(rule.type==='text'){const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let node;while((node=walker.nextNode())){if(['SCRIPT','STYLE','NOSCRIPT'].includes(node.parentElement?.tagName||''))continue;const raw=node.nodeValue||'';if(raw.trim().replace(/\s+/g,' ')===rule.original)node.nodeValue=raw.replace(rule.original,rule.value);}}}};fetch(`/api/site-content?v=${Date.now()}`,{cache:'no-store'}).then(r=>r.ok?r.json():null).then(data=>{if(data?.datasets){window.__AETHERWING_CONTENT__=data.datasets;apply(data.datasets['page-overrides']);window.dispatchEvent(new CustomEvent('aetherwing:content',{detail:data.datasets}));}}).catch(()=>{});})();
  </script>
</body></html>
