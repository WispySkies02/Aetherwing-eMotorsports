---
import { trackDetails, trackFacts } from '../../lib/track-details.mjs';
import { weatherProvider } from '../../lib/weather-provider.mjs';
import '../../styles/race-track-info.css';
const { track } = Astro.props;
const info = trackDetails(track);
const provider = weatherProvider(info);
---
<div class="race-track-info" data-race-track-info data-track={track || ''}>
  <dl class="race-track-facts" data-track-facts>
    {trackFacts(info).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
  </dl>
  <p class="race-track-note" data-track-note>{!info ? 'Track information will appear once the venue is confirmed.' : !info.length ? 'Layout specifications have not been confirmed.' : 'Venue reference · league layouts may vary.'}</p>
  <a class="race-track-source" data-track-source href={info?.source} hidden={!info?.source} target="_blank" rel="noopener noreferrer">Track reference ↗</a>
  <section class="race-track-weather" aria-label="Weather at the venue" data-track-weather hidden={!info}>
    <div class="race-track-weather__heading"><span>Track weather</span><button type="button" data-weather-retry hidden>Retry weather</button></div>
    <p class="race-track-weather__status" data-weather-status role="status">Loading venue weather…</p>
    <div data-weather-report hidden>
      <div class="race-track-weather__current"><span data-weather-current-icon></span><strong data-weather-temperature></strong><span data-weather-condition></span><span data-weather-wind></span></div>
      <p class="race-track-weather__valid" data-weather-valid></p>
      <div class="race-track-weather__forecast" data-weather-forecast></div>
      <p class="race-track-weather__issued" data-weather-issued></p>
    </div>
    <p class="race-track-weather__credit">Real-world forecast · simulator conditions may differ.<br/><a data-weather-provider href={provider.url} target="_blank" rel="noopener noreferrer">{provider.label} ↗</a></p>
    <noscript><p>Enable JavaScript to load the venue forecast.</p></noscript>
  </section>
</div>
<script>
  import { mountTrackInfo } from '../../lib/track-info-client.mjs';
  document.querySelectorAll('[data-race-track-info]').forEach(root => mountTrackInfo(root));
</script>
