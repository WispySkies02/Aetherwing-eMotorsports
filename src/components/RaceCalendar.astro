---
import { scheduleEvents, results } from '../lib/site-content.mjs';
import { eventSlug } from '../lib/schedule-events.mjs';
import '../styles/race-calendar.css';
const initial = scheduleEvents.map((event) => ({ ...event, url: `/event/${eventSlug(event)}/` }));
const initialResults = results;
---
<section class="aw-calendar section" id="race-calendar" aria-labelledby="calendar-title" data-race-calendar>
  <div class="shell">
    <div class="section-head"><div><p class="eyebrow">Aetherwing Race Control</p><h2 class="section-title" id="calendar-title">Race Calendar</h2></div><p class="lede">Where the team races next. Choose a program to see its own countdown and schedule.</p></div>
    <div class="aw-calendar__filters" role="group" aria-label="Choose racing program" data-calendar-filters></div>
    <div class="aw-calendar__layout">
      <article class="aw-calendar__hero" aria-live="polite" data-calendar-hero></article>
      <div class="aw-calendar__upcoming"><div class="aw-calendar__heading"><span data-calendar-heading>UPCOMING</span><button type="button" data-calendar-toggle aria-expanded="false" aria-controls="calendar-list">View full schedule</button></div><div id="calendar-list" data-calendar-list></div></div>
    </div>
    <div class="aw-calendar__recent" data-calendar-recent></div>
  </div>
</section>
<script define:vars={{ initial, initialResults }}>
(() => {
  const root=document.querySelector('[data-race-calendar]');if(!root)return;
  const readLocation=()=>{
    const match=location.pathname.match(/^\/schedule(?:\/([^/]+))?\/?$/);
    let league='all';
    try{if(match?.[1])league=decodeURIComponent(match[1]);}catch{}
    return {league,full:location.hash==='#full'};
  };
  let events=initial, raceResults=initialResults, selected=readLocation().league, showFull=readLocation().full, renderedList='';
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const labels=(rows)=>new Map(rows.map(e=>[e.league,e.leagueName||e.league.toUpperCase()]));
  const seriesVisual={
    all:{logo:'/images/brand/aetherwing-logo.png',label:'All Programs'},
    nrrs:{logo:'/images/schedule-logos/nrrs.png',label:'NRRS'},
    kmart:{logo:'/images/schedule-logos/kmart-regular.jpg',label:'Kmart Auto Parts Series'},
    sunoco:{logo:'/images/schedule-logos/sunoco.png',label:'Sunoco Truck Series'},
    'uarl-d1':{logo:'/images/schedule-logos/uarl-d1.png',label:'L.L. Bean Cup Series'},
    open:{logo:'/images/schedule-logos/open.png',label:'UARL Open'},
    iracing:{logo:'/images/schedule-logos/iracing.png',label:'iRacing Events'}
  };
  const filterMarkup=(key,names)=>{const visual=seriesVisual[key]||{};const label=visual.label||(key==='uarl-d1'?'UARL D1':names.get(key))||key;return `<button type="button" data-series="${esc(key)}" aria-pressed="${key===selected}" aria-label="${esc(label)}"><span class="aw-calendar__filter-logo">${visual.logo?`<img src="${esc(visual.logo)}" alt="" loading="lazy">`:`<b>${esc(label)}</b>`}</span><span class="aw-calendar__filter-meta"><strong>${esc(label)}</strong><small data-series-status></small></span></button>`;};
  const start=(e)=>{
    if(e.tbd)return new Date(NaN);
    if(e.startAt){const t=new Date(e.startAt);if(!isNaN(t))return t;}
    const m=String(e.time||'').match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
    let h=m?Number(m[1]):12;if(m&&m[3].toUpperCase()==='PM'&&h<12)h+=12;if(m&&m[3].toUpperCase()==='AM'&&h===12)h=0;
    const date=new Date(`${e.date}T12:00:00Z`);
    if(isNaN(date))return date;
    const zone=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',timeZoneName:'shortOffset'}).formatToParts(date).find(p=>p.type==='timeZoneName')?.value||'GMT-4';
    const match=zone.match(/GMT([+-])(\d{1,2})(?::(\d{2}))?/);
    const offset=match?`${match[1]}${match[2].padStart(2,'0')}:${match[3]||'00'}`:'-04:00';
    return new Date(`${e.date}T${String(h).padStart(2,'0')}:${m?m[2]:'00'}:00${offset}`);
  };
  const end=(e)=>{if(e.endAt){const t=new Date(e.endAt);if(!isNaN(t))return t;}return e.endDate?new Date(`${e.endDate}T23:59:59Z`):new Date(start(e).getTime()+(Number(e.durationMinutes)||90)*60000);};
  const resultId=(e)=>`${e.date||'tbd'}-${e.league||'event'}-${String(e.title||e.track||'scheduled-event').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/&/g,' and ').replace(/[’']/g,'').replace(/[^a-zA-Z0-9]+/g,'-').replace(/^-+|-+$/g,'').toLowerCase()}`;
  const resultFor=(e)=>raceResults.find(r=>r.league===e.league&&String(r.date||'').slice(0,4)===String(e.date||'').slice(0,4)&&String(e.round||'').match(/\d+/)&&Number(String(e.round).match(/\d+/)[0])===Number(String(r.round||'').match(/\d+/)?.[0]))||raceResults.find(r=>r.scheduleId===resultId(e))||raceResults.find(r=>r.league===e.league&&r.date===e.date&&(r.title===e.title||r.track===e.track));
  const unavailable=e=>e.cancelled===true||e.canceled===true||e.postponed===true||/\b(cancelled|canceled|postponed)\b/i.test(String(e.status||''));
  const completed=(e,now=new Date())=>e.completed===true||/\b(completed|finished)\b/i.test(String(e.status||''))||Boolean(resultFor(e))||end(e)<now;
  const dateLabel=(e,full=false)=>{const d=new Date(`${e.date}T12:00:00Z`);return e.tbd||isNaN(d)?'DATE TBD':full&&e.displayDate?`${e.displayDate} · ${d.getUTCFullYear()}`:d.toLocaleDateString('en-US',{month:'short',day:'numeric',...(full?{year:'numeric'}:{}),timeZone:'UTC'}).toUpperCase();};
  const chronological=(a,b)=>(Number.isFinite(+start(a))?+start(a):Infinity)-(Number.isFinite(+start(b))?+start(b):Infinity);
  const relative=(ms)=>!Number.isFinite(ms)?'DATE TBD':ms<=0?'LIVE':`${Math.max(1,Math.ceil(ms/86400000))}D`;
  const routeSlug=(e)=>{const slugify=v=>String(v||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/&/g,' and ').replace(/[’']/g,'').replace(/[^a-zA-Z0-9]+/g,'-').replace(/^-+|-+$/g,'').toLowerCase();const explicit=slugify(e.routeId||e.eventId||'');if(explicit)return explicit;const league=slugify(e.league||'event')||'event',round=String(e.round||'').match(/(\d+)/);if(round)return `${league}-round-${Number(round[1])}`;return `${league}-${slugify(e.date||'tbd')||'tbd'}`;};
  const url=(e)=>`/event/${routeSlug(e)}/`;
  const syncCanonical=()=>{
    const canonical=document.querySelector('link[rel="canonical"]');
    if(canonical)canonical.href=new URL(location.pathname,canonical.href).href;
  };
  const navigate=(league,full)=>{
    if(league===selected&&full===showFull)return;
    selected=league;showFull=full;
    const target=new URL(location.href);
    target.pathname=league==='all'?'/schedule/':`/schedule/${encodeURIComponent(league)}/`;
    target.hash=full?'full':'';
    if(target.href!==location.href)history.pushState(null,'',target);
    syncCanonical();tick();
  };
  const restoreLocation=()=>{const view=readLocation();selected=view.league;showFull=view.full;syncCanonical();tick();};
  window.addEventListener('popstate',restoreLocation);
  window.addEventListener('hashchange',restoreLocation);
  const toggle=root.querySelector('[data-calendar-toggle]');
  toggle.addEventListener('click',()=>navigate(selected,!showFull));
  root.addEventListener('click',(event)=>{
    if(!event.target.closest('[data-calendar-open-full]'))return;
    event.preventDefault();navigate(selected,true);toggle.focus({preventScroll:true});
  });
  function tick(){
    const now=new Date(), visible=events.filter(e=>!e.offWeek&&(selected==='all'||e.league===selected));
    const upcoming=visible.filter(e=>!unavailable(e)&&!completed(e,now)).sort(chronological);
    const current=upcoming.find(e=>start(e)<=now&&end(e)>=now) || upcoming[0];
    const filters=root.querySelector('[data-calendar-filters]'), list=root.querySelector('[data-calendar-list]'), hero=root.querySelector('[data-calendar-hero]');
    const names=labels(events), keys=['all',...names.keys()];
    if(filters.dataset.keys!==keys.join('|')){
      filters.dataset.keys=keys.join('|');
      filters.innerHTML=keys.map(k=>filterMarkup(k,names)).join('');
      filters.querySelectorAll('button').forEach(button=>button.addEventListener('click',()=>navigate(button.dataset.series,showFull)));
    }
    filters.querySelectorAll('button').forEach(button=>{
      const k=button.dataset.series, future=events.filter(e=>!e.offWeek&&(k==='all'||e.league===k)&&!unavailable(e)&&!completed(e,now)).sort(chronological)[0];
      button.setAttribute('aria-pressed',String(k===selected));button.querySelector('small').textContent=k==='all'?`${names.size} SERIES`:future?`NEXT · ${relative(start(future)-now)}`:'SEASON COMPLETE';
    });
    root.querySelector('[data-calendar-heading]').textContent=`${selected==='all'?'ALL SERIES':names.get(selected)||selected} · ${showFull?'FULL SCHEDULE':'UPCOMING'}`;
    toggle.textContent=showFull?'Show next 5':'View full schedule';toggle.setAttribute('aria-expanded',String(showFull));
    const rows=showFull?events.filter(e=>selected==='all'||e.league===selected).sort(chronological):upcoming.slice(0,5);
    const markup=rows.length?rows.map((scheduled,i)=>{
      const result=resultFor(scheduled);
      const e=result?.pointsSource==='official-recap'?{...scheduled,title:result.title,track:result.track,date:result.date}:scheduled;
      const tag=e.offWeek?'div':'a',link=e.offWeek?'':` href="${esc(url(e))}"`;
      const state=e.offWeek?'OFF WEEK':unavailable(e)?String(e.status|| (e.postponed?'POSTPONED':'CANCELLED')).toUpperCase():resultFor(e)?'RESULTS →':completed(e,now)?'COMPLETED':e.tbd||!Number.isFinite(+start(e))?'DATE TBD':start(e)<=now&&end(e)>=now?'LIVE →':e===current?'NEXT →':showFull?'UPCOMING':'↗';
      return `<${tag}${link} class="aw-calendar__event"><span>${dateLabel(e,showFull)}</span><div><small>${esc(e.leagueName||e.league)} · ${esc(e.round||e.status||'RACE')}</small><strong>${esc(e.offWeek?e.title||'Off week':e.track||e.title)}</strong><em>${esc(e.title)}${!e.offWeek&&e.time?' · '+esc(e.time):''}</em></div><b>${showFull?state:i===0?'NEXT →':'↗'}</b></${tag}>`;
    }).join(''):showFull?'<p class="aw-calendar__empty">No events have been published for this program.</p>':'<p class="aw-calendar__empty">No upcoming races. <a href="#calendar-list" data-calendar-open-full>View full schedule →</a></p>';
    // Include live track/time/status changes without replacing focused links on every clock tick.
    if(renderedList!==markup){renderedList=markup;list.innerHTML=markup;}
    if(!current){delete hero.dataset.event;hero.innerHTML=`<span class="eyebrow">${esc(names.get(selected)||'ALL SERIES')}</span><h3>SEASON COMPLETE</h3><p>No upcoming events in this program.</p><a href="#calendar-list" data-calendar-open-full>View full schedule →</a>`;}
    else if(!Number.isFinite(+start(current))){delete hero.dataset.event;hero.innerHTML=`<span class="eyebrow">${esc(names.get(selected)||'ALL SERIES')}</span><h3>DATE TBD</h3><p>${esc(current.title)}</p><a href="${esc(url(current))}">Race weekend →</a>`;}
    else{
      const id=JSON.stringify([selected,current]);
      if(hero.dataset.event!==id){hero.dataset.event=id;hero.innerHTML=`<div class="aw-calendar__hero-top"><span data-calendar-state>UPCOMING</span><small>${esc(current.leagueName||current.league)} · ${esc(current.round||current.status||'RACE')}</small></div><div><p>NEXT IN ${esc(selected==='all'?'AETHERWING':names.get(selected)||selected)}</p><h3>${esc(current.track||current.title)}</h3><h4>${esc(current.title)}</h4><strong data-calendar-clock>—</strong><small>${dateLabel(current)} · ${esc(current.time||'TIME TBD')}</small></div><a href="${esc(url(current))}">Race weekend →</a>`;}
      const diff=Math.max(0,start(current)-now),d=Math.floor(diff/86400000),h=Math.floor(diff%86400000/3600000),m=Math.floor(diff%3600000/60000),s=Math.floor(diff%60000/1000);
      hero.querySelector('[data-calendar-state]').textContent=diff===0?'RACE DAY / LIVE':'UPCOMING';hero.querySelector('[data-calendar-clock]').textContent=diff===0?'LIVE':`${String(d).padStart(2,'0')}D  ${String(h).padStart(2,'0')}H  ${String(m).padStart(2,'0')}M  ${String(s).padStart(2,'0')}S`;
    }
    const recent=visible.filter(e=>completed(e,now)).sort((a,b)=>start(b)-start(a))[0];
    const official=recent&&resultFor(recent),driver=official?.entries?.find(e=>e.featuredDriver)||official?.entries?.[0];
    root.querySelector('[data-calendar-recent]').innerHTML=recent?`<span>${official?'✓ RESULT':'✓ RECENT'}</span><b>${esc(recent.leagueName||recent.league)} · ${esc(official?.track||recent.track||recent.title)}</b><small>${dateLabel(recent)}${driver?` · #${esc(driver.number)} ${esc(driver.driver)} ${driver.finish?`P${esc(driver.finish)}`:'DNS'}`:''}</small><a href="${esc(url(recent))}">View event →</a>`:'';
  }
  const applyLiveCalendar=(d)=>{if(Array.isArray(d?.['schedule-events']))events=d['schedule-events'];if(Array.isArray(d?.results))raceResults=d.results;tick();};
  window.addEventListener('aetherwing:content',e=>applyLiveCalendar(e.detail));
  if(window.__AETHERWING_CONTENT__)applyLiveCalendar(window.__AETHERWING_CONTENT__);
  tick();setInterval(tick,1000);
})();
</script>
