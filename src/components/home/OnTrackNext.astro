---
// Broadcast lower-third for the mobile hero: the next Aetherwing session with a
// live countdown, both clocks, and a one-tap calendar file. Reads the shared
// published race feed, so live Admin schedule edits apply here too. Until the
// publication arrives (or if it fails) the card keeps its size and shows only
// a status line and the general Schedule link.
import { scheduleEvents, results } from '../../lib/site-content.mjs';
import { buildRaceFeed, nextRace, countdownParts, whenLabel, seriesLogo, seriesShort, pad } from '../../lib/race-clock.mjs';
const now = new Date();
const race = nextRace(buildRaceFeed(scheduleEvents, results, { from: new Date(now.getTime() - 3 * 86400000).toISOString().slice(0, 10) }), now);
const parts = race ? countdownParts(race, now) : null;
---
<article class="aw-next" data-on-track-next aria-labelledby="aw-next-track" data-schedule-state="loading" aria-busy="true">
  <header class="aw-next__bug">
    <span class="aw-next__state"><i aria-hidden="true"></i><b data-next-state>{parts?.pending?'START TIME PENDING':parts?.live ? 'LIVE NOW' : 'ON TRACK NEXT'}</b></span>
    <span data-next-series>{race ? `${seriesShort[race.league] || race.leagueName} · ${race.round}` : ''}</span>
  </header>
  <div class="aw-next__body">
    <div class="aw-next__copy">
      <h2 id="aw-next-track" data-next-track>{race?.track}</h2>
      <p data-next-title>{race?.title && race.title !== race.track ? race.title : race?.leagueName}</p>
    </div>
    <span class="aw-next__logo"><img src={race ? seriesLogo[race.league] : undefined} alt={race?.leagueName || ''} data-next-logo width="72" height="54" loading="eager" decoding="async" /></span>
  </div>
  <div class="aw-next__clock" role="timer" aria-live="off" data-next-clock>
    {[['d', 'Days'], ['h', 'Hrs'], ['m', 'Min'], ['s', 'Sec']].map(([key, label]) => (
      <span><b data-unit={key}>{parts && !parts.pending ? pad(parts[key]) : '--'}</b><small>{label}</small></span>
    ))}
    <strong class="aw-next__live" aria-hidden="true">Green flag</strong>
  </div>
  <p class="aw-next__when"><span data-next-when>{race ? whenLabel(race) : ''}</span><em data-next-local></em></p>
  <div class="aw-next__actions">
    <a href={race?.url || '/schedule/'} data-next-link>Race weekend <span aria-hidden="true">→</span></a>
    <button type="button" data-next-ics hidden={parts?.pending}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v14H4zM4 10h16M8 3v5M16 3v5M12 13v5M9.5 15.5h5" /></svg>
      Add to calendar
    </button>
  </div>
  <div class="aw-sched-status" data-schedule-status role="status">
    <p data-schedule-message>Loading published schedule…</p>
    <a class="ux-more" href="/schedule/" data-schedule-link hidden>Schedule</a>
  </div>
</article>

<script>
  import { subscribeFeed, nextRace, countdownParts, whenLabel, localTimeLabel, calendarFile, seriesLogo, seriesShort, pad, SCHEDULE_COPY } from '../../lib/race-clock.mjs';

  const card = document.querySelector('[data-on-track-next]');
  if (card instanceof HTMLElement) {
    let feed = [];
    let status = 'loading';
    let shown = '';
    const q = (selector) => card.querySelector(selector);
    const units = ['d', 'h', 'm', 's'].map((key) => [key, q(`[data-unit="${key}"]`)]);

    // Loading / unavailable: blank every event detail so nothing stale can
    // show, leave the general Schedule link only when loading failed.
    const showStatus = () => {
      card.hidden = false;
      // Hold the height the card had with content so nothing below it jumps.
      if (!card.style.minHeight && card.offsetHeight) card.style.minHeight = `${card.offsetHeight}px`;
      card.dataset.scheduleState = status;
      card.setAttribute('aria-busy', String(status === 'loading'));
      card.classList.remove('is-live');
      q('[data-schedule-message]').textContent = SCHEDULE_COPY[status];
      q('[data-schedule-link]').hidden = status !== 'unavailable';
      ['[data-next-series]', '[data-next-track]', '[data-next-title]', '[data-next-when]', '[data-next-local]'].forEach((selector) => { q(selector).textContent = ''; });
      units.forEach(([, node]) => { if (node) node.textContent = '--'; });
      q('[data-next-ics]').hidden = true;
      q('[data-next-logo]')?.removeAttribute('src');
      const link = q('[data-next-link]');
      if (link instanceof HTMLAnchorElement) link.href = '/schedule/';
      shown = '';
    };

    const render = () => {
      if (status !== 'ready') { showStatus(); return; }
      const now = new Date();
      const race = nextRace(feed, now);
      card.dataset.scheduleState = 'ready';
      card.setAttribute('aria-busy', 'false');
      card.style.minHeight = '';
      card.hidden = !race;
      if (!race) return;
      const parts = countdownParts(race, now);
      card.classList.toggle('is-live', parts.live);
      q('[data-next-state]').textContent = parts.pending?'START TIME PENDING':parts.live ? 'LIVE NOW' : 'ON TRACK NEXT';
      units.forEach(([key, node]) => { if (node) node.textContent = parts.pending?'--':pad(parts[key]); });
      const clock = q('[data-next-clock]');
      clock?.setAttribute('aria-label', parts.pending?'Start time pending':parts.live ? 'Session is live now' : `Starts in ${parts.d} days, ${parts.h} hours, ${parts.m} minutes`);
      q('[data-next-ics]').hidden=!!parts.pending;
      if (shown === race.url) return;
      shown = race.url;
      q('[data-next-series]').textContent = `${seriesShort[race.league] || race.leagueName} · ${race.round}`;
      q('[data-next-track]').textContent = race.track;
      q('[data-next-title]').textContent = race.title && race.title !== race.track ? race.title : race.leagueName;
      q('[data-next-when]').textContent = whenLabel(race);
      q('[data-next-local]').textContent = localTimeLabel(race);
      const logo = q('[data-next-logo]');
      if (logo instanceof HTMLImageElement) {
        if (seriesLogo[race.league]) logo.src = seriesLogo[race.league];
        logo.alt = race.leagueName;
      }
      const link = q('[data-next-link]');
      if (link instanceof HTMLAnchorElement) link.href = race.url;
    };

    q('[data-next-ics]')?.addEventListener('click', () => {
      const race = status === 'ready' ? nextRace(feed, new Date()) : null;
      if (!race || race.timePending) return;
      const blob = new Blob([calendarFile(race, location.origin)], { type: 'text/calendar;charset=utf-8' });
      const href = URL.createObjectURL(blob);
      const anchor = Object.assign(document.createElement('a'), { href, download: `aetherwing-${race.url.split('/').filter(Boolean).pop()}.ics` });
      document.body.append(anchor);
      anchor.click();
      anchor.remove();
      window.setTimeout(() => URL.revokeObjectURL(href), 4000);
    });

    subscribeFeed((next, state) => { feed = next; status = state; shown = ''; render(); });
    let timer = window.setInterval(render, 1000);
    document.addEventListener('visibilitychange', () => {
      window.clearInterval(timer);
      if (!document.hidden) { render(); timer = window.setInterval(render, 1000); }
    });
  }
</script>
