---
// The focus card and timing tower share one selected league/table snapshot.
import { standings, drivers } from '../../lib/site-content.mjs';
import { homeStandings } from '../../lib/home-standings.mjs';
import { timingTowerRows, homeTowerContext } from '../../lib/home-standings-client.mjs';
const { model = homeStandings(standings,drivers) } = Astro.props;
// Keep all assignment identities for partial feeds, but avoid duplicating every
// uploaded number image in the HTML. The API/cache supplies complete artwork.
const compactDrivers = drivers.map(assignment => ({competitionId:assignment.competitionId,league:assignment.league,displayName:assignment.displayName,profile:assignment.profile,handle:assignment.handle,number:assignment.number,active:assignment.active,
  ...(assignment === model.focusAssignment ? {numberImage:assignment.numberImage,numberImageBackup:assignment.numberImageBackup} : {})}));
---
<div class="aw-tower" data-timing-tower data-home-standings-id={model.board?.id || ''} data-home-standings-table={model.table} data-home-standings-league={model.league} data-team-numbers={model.teamNumbers.join(',')} data-team-keys={model.teamKeys.join(',')}>
  <header class="aw-tower__head">
    <span><b data-tower-status>{model.status}</b><small data-tower-title>{model.title}</small></span>
    <em data-tower-context>{homeTowerContext(model)}</em>
  </header>
  <ol class="aw-tower__rows" data-tower-rows set:html={timingTowerRows(model)}></ol>
  <p class="aw-tower__note" hidden={!model.cutoff && !model.teamKeys.length}><span class="aw-tower__key" aria-hidden="true" hidden={!model.teamKeys.length}></span><span data-tower-team-label hidden={!model.teamKeys.length}>{model.teamLabel}</span><span class="aw-tower__cut-key" aria-hidden="true" hidden={!model.cutoff}></span><span data-tower-cut hidden={!model.cutoff}>{model.cutoffLabel}</span></p>
</div>
<script is:inline type="application/json" data-home-standings-seed set:html={JSON.stringify({standings,drivers:compactDrivers}).replace(/</g,'\\u003c')}/>
<script>
  import { mountHomeStandings } from '../../lib/home-standings-client.mjs';
  mountHomeStandings(document);
</script>
