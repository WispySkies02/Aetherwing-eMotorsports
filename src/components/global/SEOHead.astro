---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = 'Aetherwing eMotorsports',
  description = 'Aetherwing eMotorsports — competition, drivers, schedule, paint booth, news, and team history.',
  canonical,
  image,
  type = 'website',
  noindex = false
} = Astro.props;

const siteName = 'Aetherwing eMotorsports';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const routeImages: Record<string, string> = {
  '/': '/images/social/home-social.png',
  '/drivers/': '/images/social/drivers-social.png',
  '/schedule/': '/images/social/schedule-social.png',
  '/paint-booth/': '/images/social/paint-booth-social.png',
  '/partners/': '/images/social/partners-social.png',
  '/news/': '/images/social/news-social.png',
  '/wins-history/': '/images/social/wins-history-social.png',
  '/mission-values/': '/images/social/mission-values-social.png',
  '/team-handbook/': '/images/social/team-handbook-social.png',
  '/contact/': '/images/social/contact-social.png'
};
const resolvedImage = image ?? routeImages[Astro.url.pathname] ?? '/images/social/default-social.png';
const imageUrl = new URL(resolvedImage, Astro.site);
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
