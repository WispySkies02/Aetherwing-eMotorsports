---
import { navigation, siteSettings } from '../../lib/site-content.mjs';
const pathname=Astro.url.pathname;
const section=pathname==='/'?'Home':pathname.startsWith('/drivers/')?'Drivers':pathname.startsWith('/news/')?'News':/\/(schedule|championships|history|event)\//.test(pathname)?'Racing':'Explore';
const label=pathname==='/'?'Race Headquarters':pathname.startsWith('/drivers/')?'Team Garage':pathname.startsWith('/news/')?'Team Wire':pathname.startsWith('/schedule/')?'Race Calendar':pathname.startsWith('/championships/')?'Championships':pathname.startsWith('/history/')?'Race History':pathname.startsWith('/event/')?'Race Weekend':pathname.startsWith('/programs/')?'Racing Programs':pathname.startsWith('/partners/')?'Team Partners':pathname.startsWith('/mission-values/')?'Our Mission':pathname.startsWith('/team-handbook/')?'Team Handbook':pathname.startsWith('/paint-booth/')?'Paint Booth':'Aetherwing';
const active=(name)=>section===name;
const racing=navigation.filter(item=>['Schedule','Championships','History'].includes(item.label));
const explore=navigation.filter(item=>!['Home','Drivers','News','Schedule','Championships','History'].includes(item.label));
---
<div class="aw-app" data-aw-app>
  <header class="aw-app__header" aria-label="Aetherwing mobile header">
    <a href="/" class="aw-app__logo" aria-label="Aetherwing home"><img src={siteSettings.logo} alt="Aetherwing eMotorsports"/></a>
    <div class="aw-app__page"><small>{section==='Home'?'AETHERWING eMOTORSPORTS':section.toUpperCase()+' / AETHERWING'}</small><strong>{label}</strong></div>
    <a href="/schedule/" class="aw-app__race" aria-label="View race schedule">🏁</a>
  </header>
  <div class="aw-app__scrim" data-aw-app-scrim hidden></div>
  <section class="aw-app__sheet" data-aw-app-sheet role="dialog" aria-modal="true" aria-label="Explore Aetherwing" aria-labelledby="aw-app-sheet-title" hidden>
    <div class="aw-app__sheet-grip" aria-hidden="true"></div>
    <div class="aw-app__sheet-head"><div><small>TEAM OPERATIONS</small><h2 id="aw-app-sheet-title" data-aw-app-sheet-title>Race Center</h2></div><button type="button" data-aw-app-close aria-label="Close navigation">×</button></div>
    <div class="aw-app__sheet-links" data-aw-app-links="race">
      {racing.map(item=><a href={item.href}><span>{item.label}</span><b aria-hidden="true">→</b></a>)}
      <a href="/news/"><span>Race Reports & News</span><b aria-hidden="true">→</b></a>
    </div>
    <div class="aw-app__sheet-links" data-aw-app-links="more" hidden>
      {explore.map(item=><a href={item.href} target={item.href.startsWith('http')?'_blank':undefined} rel={item.href.startsWith('http')?'noopener noreferrer':undefined}><span>{item.label}</span><b aria-hidden="true">↗</b></a>)}
      <a href="/admin/"><span>Team Admin</span><b aria-hidden="true">→</b></a>
    </div>
  </section>
  <nav class="aw-app__nav" aria-label="Aetherwing mobile app navigation">
    <a href="/" class:list={['aw-app__tab',{ 'is-active':active('Home') }]} aria-current={active('Home')?'page':undefined}><svg class="aw-app__tab-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 3l9 8"/><path d="M5 10v11h14V10M9 21v-7h6v7"/></svg><span>Home</span></a>
    <a href="/schedule/" data-aw-app-open="race" class:list={['aw-app__tab',{ 'is-active':active('Racing') }]} aria-current={active('Racing')?'page':undefined} aria-haspopup="dialog" aria-expanded="false"><svg class="aw-app__tab-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4m0 1c5-3 9 3 14 0v11c-5 3-9-3-14 0"/></svg><span>Racing</span></a>
    <a href="/drivers/" class:list={['aw-app__tab',{ 'is-active':active('Drivers') }]} aria-current={active('Drivers')?'page':undefined}><svg class="aw-app__tab-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M2 21v-2a7 7 0 0 1 14 0v2M16 5a3 3 0 0 1 0 6M18 14a6 6 0 0 1 4 6v1"/></svg><span>Drivers</span></a>
    <a href="/news/" class:list={['aw-app__tab',{ 'is-active':active('News') }]} aria-current={active('News')?'page':undefined}><svg class="aw-app__tab-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h5v5H7zM15 8h3M15 11h3M7 16h11"/></svg><span>News</span></a>
    <a href="/programs/" data-aw-app-open="more" class:list={['aw-app__tab',{ 'is-active':active('Explore') }]} aria-current={active('Explore')?'page':undefined} aria-haspopup="dialog" aria-expanded="false"><svg class="aw-app__tab-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>More</span></a>
  </nav>
</div>
<script>
  const shell=document.querySelector('[data-aw-app]');
  if(shell instanceof HTMLElement){
    const scrim=shell.querySelector('[data-aw-app-scrim]');
    const sheet=shell.querySelector('[data-aw-app-sheet]');
    const title=shell.querySelector('[data-aw-app-sheet-title]');
    const openers=Array.from(shell.querySelectorAll('[data-aw-app-open]'));
    const closers=shell.querySelectorAll('[data-aw-app-close]');
    let lastFocus=null;
    const close=()=>{
      if(!(sheet instanceof HTMLElement)||sheet.hidden)return;
      sheet.hidden=true;
      if(scrim instanceof HTMLElement)scrim.hidden=true;
      document.documentElement.classList.remove('aw-app-open');
      openers.forEach(link=>link.setAttribute('aria-expanded','false'));
      if(lastFocus instanceof HTMLElement)lastFocus.focus();
    };
    const open=(kind,trigger)=>{
      if(!(sheet instanceof HTMLElement))return;
      lastFocus=trigger;
      shell.querySelectorAll('[data-aw-app-links]').forEach(el=>{if(el instanceof HTMLElement)el.hidden=el.getAttribute('data-aw-app-links')!==kind});
      if(title)title.textContent=kind==='race'?'Race Center':'Explore Aetherwing';
      sheet.hidden=false;
      if(scrim instanceof HTMLElement)scrim.hidden=false;
      document.documentElement.classList.add('aw-app-open');
      openers.forEach(link=>link.setAttribute('aria-expanded',String(link===trigger)));
      sheet.querySelector('button')?.focus();
    };
    openers.forEach(link=>link.addEventListener('click',event=>{
      if(!matchMedia('(max-width: 980px)').matches)return;
      event.preventDefault();
      const kind=link.getAttribute('data-aw-app-open')||'more';
      if(sheet instanceof HTMLElement&&!sheet.hidden&&link.getAttribute('aria-expanded')==='true')close();
      else open(kind,link);
    }));
    closers.forEach(button=>button.addEventListener('click',close));
    scrim?.addEventListener('click',close);
    document.addEventListener('keydown',event=>{
      if(!(sheet instanceof HTMLElement)||sheet.hidden)return;
      if(event.key==='Escape'){event.preventDefault();close();}
      if(event.key==='Tab'){
        const focusable=Array.from(sheet.querySelectorAll('a:not([hidden]),button:not([disabled])')).filter(el=>el instanceof HTMLElement&&el.getClientRects().length>0);
        if(!focusable.length)return;
        if(event.shiftKey&&document.activeElement===focusable[0]){event.preventDefault();focusable[focusable.length-1].focus();}
        else if(!event.shiftKey&&document.activeElement===focusable[focusable.length-1]){event.preventDefault();focusable[0].focus();}
      }
    });
    window.addEventListener('resize',()=>{if(matchMedia('(min-width: 981px)').matches)close()});
    window.addEventListener('pagehide',close);
    window.addEventListener('aetherwing:content',event=>{
      const items=event.detail?.navigation;
      if(!Array.isArray(items))return;
      const safe=(href)=>typeof href==='string'&&(href.startsWith('/')||href.startsWith('https://'))&&!href.startsWith('//');
      for(const kind of ['race','more']){
        const list=shell.querySelector('[data-aw-app-links="'+kind+'"]');
        if(!(list instanceof HTMLElement))continue;
        const chosen=items.filter(item=>kind==='race'?['Schedule','Championships','History'].includes(item?.label):!['Home','Drivers','News','Schedule','Championships','History'].includes(item?.label));
        list.replaceChildren();
        for(const item of chosen){
          if(!safe(item?.href))continue;
          const a=document.createElement('a');a.href=item.href;
          if(item.href.startsWith('https://')){a.target='_blank';a.rel='noopener noreferrer'}
          const name=document.createElement('span');name.textContent=String(item.label||'Explore');
          const arrow=document.createElement('b');arrow.textContent='→';arrow.setAttribute('aria-hidden','true');
          a.append(name,arrow);list.append(a);
        }
        const extra=document.createElement('a');extra.href=kind==='race'?'/news/':'/admin/';
        const name=document.createElement('span');name.textContent=kind==='race'?'Race Reports & News':'Team Admin';
        const arrow=document.createElement('b');arrow.textContent='→';arrow.setAttribute('aria-hidden','true');
        extra.append(name,arrow);list.append(extra);
      }
    });
  }
</script>
