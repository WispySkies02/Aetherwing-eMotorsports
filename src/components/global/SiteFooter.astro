---
const year=new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-brand">
      <p class="eyebrow">Follow the flight</p>
      <img src="/images/brand/aetherwing-logo.png" alt="Aetherwing eMotorsports" />
      <p>Born to soar. Built to fight.</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/">Home</a><a href="/drivers/">Drivers</a><a href="/paint-booth/">Paint Booth</a><a href="/partners/">Partners</a><a href="/news/">News</a><a href="/schedule/">Schedule</a><a href="/wins-history/">Wins & History</a><a href="/mission-values/">Mission</a><a href="/team-handbook/">Handbook</a><a href="/contact/">Contact</a>
    </nav>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} Aetherwing eMotorsports. Born to soar. Built to fight.</span>
    <span>All trademarks, league names, partner names, vehicle references, and sponsor marks belong to their respective owners.</span>
  </div>
</footer>
<style>
.site-footer{position:relative;margin-top:5rem;padding:4.5rem 0 1.5rem;background:#000;border-top:4px solid #fff;overflow:hidden}.site-footer::before{content:'AETHERWING';position:absolute;right:-.05em;bottom:.08em;color:rgba(255,255,255,.035);font:400 clamp(6rem,18vw,14rem)/.7 var(--font-brush);transform:rotate(-3deg);pointer-events:none}.site-footer::after{content:'';position:absolute;top:-4px;left:0;width:min(32rem,70vw);height:8px;background:linear-gradient(90deg,var(--aw-red),var(--aw-gold) 68%,var(--aw-blue));clip-path:polygon(0 0,100% 15%,96% 100%,0 75%)}.footer-main{position:relative;z-index:1;display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);gap:clamp(2rem,6vw,6rem);align-items:end}.footer-brand img{width:min(430px,100%);max-height:130px;object-fit:contain;object-position:left center}.footer-brand>p:last-child{margin:.8rem 0 0;color:#777;font:800 .72rem/1 var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.footer-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0}.footer-links a{padding:.8rem .7rem;border-bottom:1px solid #272727;color:#aaa;text-decoration:none;font:900 .71rem/1 var(--font-mono);letter-spacing:.07em;text-transform:uppercase}.footer-links a:hover{color:#000;background:var(--aw-paper)}.footer-bottom{position:relative;z-index:1;margin-top:3rem;padding-top:1.1rem;border-top:1px solid #292929;display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;color:#5e5e5e;font:700 .61rem/1.55 var(--font-mono)}
@media(max-width:720px){.footer-main{grid-template-columns:1fr}.footer-links{grid-template-columns:repeat(2,1fr)}.footer-bottom{grid-template-columns:1fr}}
</style>
