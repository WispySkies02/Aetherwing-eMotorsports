---
const path=Astro.url.pathname;
const active=(href:string)=>href==='/'?path==='/':path.startsWith(href);
import { navigation, siteSettings } from '../../lib/site-content.mjs';
import MobileNav from './MobileNav.astro';
const homeLink=navigation.find((item)=>item.group==='Home')??{label:'Home',href:'/'};
const groups=['Team','Race','Connect'].map((label)=>({label,links:navigation.filter((item)=>item.group===label).map((item)=>[item.label,item.href])})).filter((group)=>group.links.length);
---
<header class="site-header" data-site-header>
  <div class="site-header__utility">
    <div class="shell site-header__utility-inner">
      <span>AETHERWING eMOTORSPORTS</span>
      <span>RACE CONTROL / 2026</span>
      <a href={siteSettings.discordUrl}>TEAM DISCORD ↗</a>
    </div>
  </div>
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="Aetherwing eMotorsports home">
      <img src={siteSettings.logo} alt={siteSettings.name} />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation" data-desktop-nav>
      <a class:list={[{active:active(homeLink.href)}]} href={homeLink.href}>{homeLink.label}</a>
      {groups.map((group)=>(
        <div class="nav-group">
          <button type="button" aria-haspopup="true" aria-expanded="false">{group.label}<span aria-hidden="true">▾</span></button>
          <div class="nav-group__menu">
            <small>{group.label} / AEM</small>
            {group.links.map(([label,href])=><a class:list={[{active:active(href)}]} href={href}>{label}</a>)}
          </div>
        </div>
      ))}
    </nav>
    <a class="header-race-link" href="/schedule/"><span>RACE CONTROL</span><b>VIEW SCHEDULE →</b></a>
    <a class="header-chip" href="/schedule/" data-race-chip hidden><i aria-hidden="true"></i><span><small data-chip-series>NEXT</small><b data-chip-clock></b></span></a>
  </div>
</header>
<MobileNav />
<script>
  const header=document.querySelector('[data-site-header]');
  if(header){
    const desktopNav=header.querySelector('[data-desktop-nav]');
    const esc=(value='')=>String(value).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    const currentPath=()=>location.pathname.replace(/\/+$/,'/')||'/';
    const isActive=(href='')=>href.startsWith('/')&&(href==='/'?currentPath()==='/':currentPath().startsWith(href));
    const bindDesktopGroups=()=>header.querySelectorAll('.nav-group').forEach(group=>{
      const btn=group.querySelector('button');
      if(!(btn instanceof HTMLButtonElement)||btn.dataset.bound==='1')return;
      btn.dataset.bound='1';
      group.addEventListener('mouseenter',()=>btn.setAttribute('aria-expanded','true'));
      group.addEventListener('mouseleave',()=>btn.setAttribute('aria-expanded','false'));
      group.addEventListener('focusin',()=>btn.setAttribute('aria-expanded','true'));
      group.addEventListener('focusout',e=>{if(e.relatedTarget instanceof Node&&!group.contains(e.relatedTarget))btn.setAttribute('aria-expanded','false')});
    });
    // Mobile navigation hydrates itself in MobileNav.astro.
    const renderNavigation=(items)=>{
      if(!Array.isArray(items)||!items.length)return;
      const publicItems=items.map(item=>item?.label==='Paint Booth'&&item?.href==='/paint-booth/'?{...item,href:'https://paint.aetherwing.net/'}:item);
      const home=publicItems.find(item=>item?.group==='Home')||{label:'Home',href:'/'};
      const groups=['Team','Race','Connect'].map(label=>({label,links:publicItems.filter(item=>item?.group===label)})).filter(group=>group.links.length);
      if(desktopNav instanceof HTMLElement){desktopNav.innerHTML=`<a class="${isActive(home.href)?'active':''}" href="${esc(home.href)}">${esc(home.label)}</a>`+groups.map(group=>`<div class="nav-group"><button type="button" aria-haspopup="true" aria-expanded="false">${esc(group.label)}<span aria-hidden="true">▾</span></button><div class="nav-group__menu"><small>${esc(group.label)} / AEM</small>${group.links.map(item=>`<a class="${isActive(item.href)?'active':''}" href="${esc(item.href)}">${esc(item.label)}</a>`).join('')}</div></div>`).join('');}
      bindDesktopGroups();
    };
    bindDesktopGroups();window.addEventListener('aetherwing:content',event=>renderNavigation(event.detail?.navigation));
    if(window.__AETHERWING_CONTENT__)renderNavigation(window.__AETHERWING_CONTENT__.navigation);
  }
</script>
<style is:global>
.site-header{position:sticky;top:0;z-index:300;background:rgba(7,8,10,.985);border-bottom:1px solid #474b50;box-shadow:0 14px 35px rgba(0,0,0,.42)}.site-header:after{content:'';position:absolute;left:0;right:0;bottom:-4px;height:4px;background:linear-gradient(90deg,#e10600 0 36%,#f3f3f3 36% 47%,#777d83 47% 55%,#e10600 55% 71%,#4a6fff 71% 100%)}.site-header__utility{border-bottom:1px solid #25282d;background:#030405}.site-header__utility-inner{height:27px;display:flex;align-items:center;gap:1.2rem;color:#737a81;font:800 .54rem/1 var(--font-mono);letter-spacing:.13em;text-transform:uppercase}.site-header__utility-inner span:nth-child(2){color:#aeb4b9}.site-header__utility-inner a{margin-left:auto;color:#c9cdd0;text-decoration:none}.site-header__utility-inner a:hover{color:#fff}.site-header__inner{height:86px;display:flex;align-items:center;gap:1.5rem}.brand{display:flex;align-items:center;flex:0 0 min(320px,27vw);height:74px;text-decoration:none}.brand img{width:100%;height:100%;object-fit:contain;object-position:left center;filter:drop-shadow(0 7px 7px rgba(0,0,0,.7))}.desktop-nav{align-self:stretch;display:flex;align-items:stretch;gap:.1rem;margin-left:auto}.desktop-nav>a,.nav-group>button{position:relative;display:flex;align-items:center;gap:.45rem;height:100%;padding:0 .82rem;border:0;background:transparent;color:#c3c6c8;text-decoration:none;font:900 .71rem/1 var(--font-condensed);font-style:italic;letter-spacing:.065em;text-transform:uppercase;cursor:pointer}.desktop-nav>a:after,.nav-group>button:after{content:'';position:absolute;left:.75rem;right:.75rem;bottom:0;height:3px;background:#e10600;transform:scaleX(0);transform-origin:left;transition:transform .18s}.desktop-nav>a:hover,.desktop-nav>a.active,.nav-group>button:hover{color:#fff;background:linear-gradient(180deg,transparent,rgba(255,255,255,.035))}.desktop-nav>a:hover:after,.desktop-nav>a.active:after,.nav-group>button:hover:after{transform:scaleX(1)}.nav-group{position:relative}.nav-group>button span{color:#e10600;font-size:.65rem}.nav-group__menu{position:absolute;right:0;top:100%;width:245px;padding:.65rem;background:linear-gradient(180deg,#17191d,#090a0c);border:1px solid #555b61;border-top:3px solid #e10600;box-shadow:0 18px 42px rgba(0,0,0,.62);display:none}.nav-group:hover .nav-group__menu,.nav-group:focus-within .nav-group__menu{display:grid}.nav-group__menu small{padding:.48rem .6rem;color:#9ea4a9;font:900 .57rem/1 var(--font-mono);letter-spacing:.13em;text-transform:uppercase}.nav-group__menu a{padding:.82rem .65rem;border-top:1px solid #292c30;color:#c8cbcd;text-decoration:none;font:800 .77rem/1.1 var(--font-condensed);font-style:italic;letter-spacing:.045em;text-transform:uppercase}.nav-group__menu a:hover,.nav-group__menu a.active{color:#fff;background:linear-gradient(90deg,rgba(225,6,0,.17),transparent);box-shadow:inset 3px 0 #e10600}.header-race-link{display:grid;min-width:150px;padding:.58rem .72rem .6rem;border-left:1px solid #454a4f;text-decoration:none}.header-race-link span{color:#8e9499;font:800 .48rem/1 var(--font-mono);letter-spacing:.13em}.header-race-link b{margin-top:.25rem;color:#fff;font:900 .68rem/1 var(--font-condensed);font-style:italic;letter-spacing:.06em}.header-race-link:hover b{color:#ff4a42}html.menu-open{overflow:hidden}
.header-chip{display:none;align-items:center;gap:.55rem;min-height:44px;padding:.35rem .7rem .35rem .6rem;border:1px solid #3d4247;background:linear-gradient(100deg,#15181c,#0b0c0f);color:#fff;text-decoration:none;clip-path:polygon(0 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%)}.header-chip i{flex:none;width:8px;height:8px;background:#5e656b;transform:rotate(45deg)}.header-chip span{display:grid;gap:.22rem;min-width:0}.header-chip small{color:#8e959b;font:700 .52rem/1 var(--font-mono);letter-spacing:.14em;white-space:nowrap}.header-chip b{max-width:38vw;overflow:hidden;font:400 .86rem/1 var(--font-mono);font-variant-numeric:tabular-nums;letter-spacing:.02em;text-overflow:ellipsis;white-space:nowrap}.header-chip.is-live{border-color:var(--season-primary,#e10600)}.header-chip.is-live i{background:var(--season-primary,#e10600);border-radius:50%;transform:none;animation:aw-chip-live 1.3s ease-in-out infinite}.header-chip.is-live small{color:var(--season-primary,#ff4a42)}@keyframes aw-chip-live{50%{opacity:.3}}
@media(max-width:1160px){.header-race-link{display:none}.brand{flex-basis:min(290px,27vw)}}
@media(max-width:1160px){.header-chip:not([hidden]){display:flex;margin-left:auto}}
@media(max-width:980px){.desktop-nav{display:none}.brand{flex-basis:240px}.site-header__utility-inner span:nth-child(2){display:none}.site-header{transition:transform .32s cubic-bezier(.2,.8,.2,1)}.site-header.is-tucked{transform:translateY(calc(-100% - 6px))}}
@media(max-width:760px){.site-header__utility{display:none}.site-header__inner{height:60px;gap:.75rem}.brand{height:44px;flex:0 1 168px;min-width:0}.site-header{box-shadow:0 10px 26px rgba(0,0,0,.4)}.site-header:after{height:3px;bottom:-3px}}
@media(max-width:340px){.header-chip small{display:none}}
@media(prefers-reduced-motion:reduce){.site-header{transition:none!important}.header-chip.is-live i{animation:none!important}}
</style>
