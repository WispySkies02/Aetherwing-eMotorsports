---
// Phone/tablet top bar (<1100px). Keeps the .site-header hook so the seasonal
// header treatments in site.css still apply; desktop uses AppRail instead.
import { siteSettings } from '../../lib/site-content.mjs';
import MobileNav from './MobileNav.astro';
---
<header class="site-header ux-topbar" data-site-header>
  <a class="ux-topbar__brand" href="/" aria-label={`${siteSettings.name} home`}><img src={siteSettings.logo} alt={siteSettings.name} width="170" height="42" /></a>
  <a class="header-chip" href="/schedule/" data-race-chip hidden><i aria-hidden="true"></i><span><small data-chip-series>NEXT</small><b data-chip-clock></b></span></a>
</header>
<MobileNav />
