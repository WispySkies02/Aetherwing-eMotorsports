---
// Page header for every interior page: kicker, title, lede, optional actions.
interface Props { eyebrow:string; title:string; description:string; }
const {eyebrow,title,description}=Astro.props;
---
<header class="ux-pagehead"><p class="ux-kicker"><b>AEM</b>{eyebrow}</p><h1 class="ux-title">{title}</h1><p class="ux-lede">{description}</p><slot/></header>
