---
import { drivers, rosterProfiles, charters, alliances } from '../lib/site-content.mjs';
import { allianceName } from '../lib/alliances.mjs';
import { plannedCharterNotes } from '../lib/charter-plans.mjs';
import '../styles/driver-lineup.css';
const entries = drivers;
const people = rosterProfiles;
const boards = charters;
const allianceRecords = alliances;
const alliedNames=[...new Set(entries.filter(row=>row.affiliation==='alliance').map(row=>allianceName(row,alliances)))];
const intro=alliedNames.length?`Aetherwing seats plus affiliated ${alliedNames.join(' / ')} rides. Number art leads each entry.`:'Aetherwing racing seats. Number art leads each entry.';
const profileSlugs = rosterProfiles.map(profile=>profile.slug);
const charterPlans = boards.map(({id,plannedSeasons})=>({id,plannedSeasons}));
const initialPlanNotes = plannedCharterNotes(charterPlans.find(board=>board.id==='nrrs'));
---
<section class="aw-lineup section" data-lineup aria-labelledby="lineup-title">
  <div class="shell">
    <div class="section-head"><div><p class="eyebrow">Aetherwing + Partner Teams</p><h2 class="section-title" id="lineup-title">Driver Lineup</h2></div><p class="lede" data-lineup-intro>{intro}</p></div>
    <div class="aw-lineup__filters" role="group" aria-label="Filter roster by racing program" data-lineup-filters></div>
    <div class="aw-lineup__program" data-lineup-program></div>
    <p class="mono muted" data-planned-charters hidden>{initialPlanNotes.join(' ')}{initialPlanNotes.length>0?' Current entries remain unchanged.':''}</p>
    <div class="aw-lineup__grid" data-lineup-grid></div>
  </div>
</section>
<script define:vars={{ entries, people, boards, profileSlugs, allianceRecords }}>
(() => {
  const root=document.querySelector('[data-lineup]');if(!root)return;
  let assignments=entries,profiles=people,charters=boards,series='all';
  // The fallback supports older embedded data; an explicitly empty list stays empty.
  let organizations=typeof allianceRecords==='undefined'?[{id:'starclutch-racing',name:'StarClutch Racing',shortName:'StarClutch Racing'}]:allianceRecords;
  const organizationName=(entry,short=false)=>{
    if(entry?.affiliation!=='alliance')return 'Aetherwing';
    const id=Object.hasOwn(entry,'allianceId')?String(entry.allianceId||''):'starclutch-racing';
    const organization=organizations.find(item=>item?.id===id);
    return organization?(short?(organization.shortName||organization.name):organization.name):'Alliance';
  };
  const organizationNames=rows=>[...new Set(rows.map(row=>organizationName(row,true)))].sort((a,b)=>a==='Aetherwing'?-1:b==='Aetherwing'?1:0);

  const publishedArtById=new Map(),publishedSignatureBySlug=new Map();
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const programOrder={kmart:1,sunoco:2,nrrs:3,'uarl-d1':4,'uarl-open':5,'iracing-factory':6};
  const artChoiceByDriver=new Map();
  const shuffle=(items)=>{const copy=[...items];for(let i=copy.length-1;i>0;i-=1){const j=Math.floor(Math.random()*(i+1));[copy[i],copy[j]]=[copy[j],copy[i]];}return copy;};
  const chooseDriverArt=(driverKey,items)=>{
    if(!items.length)return null;
    const itemKey=(item)=>`${item.number}::${item.src}`;
    const signature=items.map(itemKey).sort().join('||');
    const cached=artChoiceByDriver.get(driverKey);
    if(cached?.signature===signature){const match=items.find(item=>itemKey(item)===cached.itemKey);if(match)return match;}
    const storageKey=`aetherwing:driver-art-bag:${driverKey}`;
    let state={signature:'',queue:[],last:''};
    try{state={...state,...JSON.parse(sessionStorage.getItem(storageKey)||'{}')};}catch{}
    const validKeys=new Set(items.map(itemKey));
    let queue=Array.isArray(state.queue)?state.queue.filter(key=>validKeys.has(key)):[];
    if(state.signature!==signature||!queue.length){
      queue=shuffle(items.map(itemKey));
      if(queue.length>1&&queue[0]===state.last){const swap=1+Math.floor(Math.random()*(queue.length-1));[queue[0],queue[swap]]=[queue[swap],queue[0]];}
    }
    const chosenKey=queue.shift()||itemKey(items[0]);
    try{sessionStorage.setItem(storageKey,JSON.stringify({signature,queue,last:chosenKey}));}catch{}
    const chosen=items.find(item=>itemKey(item)===chosenKey)||items[0];
    artChoiceByDriver.set(driverKey,{signature,itemKey:itemKey(chosen)});
    return chosen;
  };
  const artCorrections={
    'rocky:46':{desktop:1.16,mobile:1.1},
    'jaxon:34':{desktop:.9,mobile:.9},
    'parker:43':{desktop:.96,mobile:.95},
    'burgertown2good:32':{desktop:1,mobile:1},
    'hailey:15':{desktop:.98,mobile:.95},
    'matty:29':{desktop:.96,mobile:.96}
  };
  const correctionFor=(profile,number)=>artCorrections[`${profile||''}:${number||''}`]||{desktop:1,mobile:1};
  const tightenSignature=(img)=>{if(!(img instanceof HTMLImageElement)||img.dataset.signatureTightened==='1')return;img.dataset.signatureTightened='1';try{const w=img.naturalWidth,h=img.naturalHeight;if(!w||!h||w*h>3000000)return;const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;const ctx=canvas.getContext('2d',{willReadFrequently:true});ctx.drawImage(img,0,0);const pixels=ctx.getImageData(0,0,w,h).data;let left=w,top=h,right=-1,bottom=-1;for(let y=0;y<h;y+=1){for(let x=0;x<w;x+=1){if(pixels[(y*w+x)*4+3]>14){if(x<left)left=x;if(x>right)right=x;if(y<top)top=y;if(y>bottom)bottom=y;}}}if(right<left||bottom<top)return;const visibleW=right-left+1,visibleH=bottom-top+1;if(visibleW/w>.93&&visibleH/h>.9)return;const padX=Math.max(2,Math.round(visibleW*.025)),padY=Math.max(2,Math.round(visibleH*.06)),sx=Math.max(0,left-padX),sy=Math.max(0,top-padY),ex=Math.min(w-1,right+padX),ey=Math.min(h-1,bottom+padY),out=document.createElement('canvas');out.width=ex-sx+1;out.height=ey-sy+1;out.getContext('2d').drawImage(canvas,sx,sy,out.width,out.height,0,0,out.width,out.height);img.src=out.toDataURL('image/webp',.95);}catch{}};
  const tightenNumber=(img)=>{if(!(img instanceof HTMLImageElement)||img.dataset.numberTightened==='1')return;img.dataset.numberTightened='1';try{const w=img.naturalWidth,h=img.naturalHeight;if(!w||!h||w*h>4000000)return;const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;const ctx=canvas.getContext('2d',{willReadFrequently:true});ctx.drawImage(img,0,0);const pixels=ctx.getImageData(0,0,w,h).data;let left=w,top=h,right=-1,bottom=-1;for(let y=0;y<h;y+=1){for(let x=0;x<w;x+=1){if(pixels[(y*w+x)*4+3]>14){if(x<left)left=x;if(x>right)right=x;if(y<top)top=y;if(y>bottom)bottom=y;}}}if(right<left||bottom<top)return;const visibleW=right-left+1,visibleH=bottom-top+1;if(visibleW/w>.95&&visibleH/h>.93)return;const padX=Math.max(2,Math.round(visibleW*.035)),padY=Math.max(2,Math.round(visibleH*.035)),sx=Math.max(0,left-padX),sy=Math.max(0,top-padY),ex=Math.min(w-1,right+padX),ey=Math.min(h-1,bottom+padY),out=document.createElement('canvas');out.width=ex-sx+1;out.height=ey-sy+1;out.getContext('2d').drawImage(canvas,sx,sy,out.width,out.height,0,0,out.width,out.height);img.src=out.toDataURL('image/webp',.98);}catch{}};
  const fitNumberVisual=(img)=>{
    if(!(img instanceof HTMLImageElement)||!img.naturalWidth||!img.naturalHeight||img.closest('.aw-lineup__dual-art'))return;
    const stage=img.closest('.aw-lineup__number');if(!(stage instanceof HTMLElement))return;
    const rect=stage.getBoundingClientRect();if(rect.width<40||rect.height<40)return;
    const styles=getComputedStyle(stage);
    const contentWidth=Math.max(1,rect.width-(parseFloat(styles.paddingLeft)||0)-(parseFloat(styles.paddingRight)||0));
    const contentHeight=Math.max(1,rect.height-(parseFloat(styles.paddingTop)||0)-(parseFloat(styles.paddingBottom)||0));
    const mobile=matchMedia('(max-width: 600px)').matches;
    const ratio=img.naturalWidth/Math.max(1,img.naturalHeight);
    const scaleAdjust=Math.max(.82,Math.min(1.2,Number(img.dataset[mobile?'scaleMobile':'scaleDesktop']||1)));
    const targetArea=contentWidth*contentHeight*(mobile?.255:.345)*scaleAdjust*scaleAdjust;
    const maxW=contentWidth*(mobile?.78:.82)*scaleAdjust;
    const maxH=contentHeight*(mobile?.72:.78)*scaleAdjust;
    let width=Math.sqrt(targetArea*ratio),height=width/ratio;
    const scale=Math.min(1,maxW/width,maxH/height);
    width*=scale;height*=scale;
    img.style.width=`${Math.round(width)}px`;
    img.style.height=`${Math.round(height)}px`;
    img.style.maxWidth='none';
    img.style.maxHeight='none';
  };
  root.addEventListener('load',event=>{const image=event.target;if(!(image instanceof HTMLImageElement))return;if(image.closest('.aw-lineup__signature'))tightenSignature(image);if(image.closest('.aw-lineup__number')){tightenNumber(image);if(matchMedia('(max-width: 600px)').matches)requestAnimationFrame(()=>fitNumberVisual(image));}},true);
  root.addEventListener('error',event=>{const image=event.target;if(!(image instanceof HTMLImageElement))return;if(image.closest('.aw-lineup__number')){const backup=image.dataset.backupSrc||'';if(backup&&image.dataset.backupTried!=='1'&&image.getAttribute('src')!==backup){image.dataset.backupTried='1';image.src=backup;return;}const fallback=document.createElement('b');fallback.className=image.closest('.aw-lineup__dual-slot')?'':'aw-lineup__number-fallback is-single';fallback.textContent=`#${image.alt.replace('Number ','')||image.closest('[data-number]')?.dataset.number||''}`;image.replaceWith(fallback);return;}if(image.closest('.aw-lineup__signature'))image.closest('.aw-lineup__signature')?.remove();},true);
  const label=e=>e.competitionId==='uarl-d1'?'UARL D1':e.competition||e.competitionId;
  const shortProgram=(id,name='')=>({nrrs:'NRRS','uarl-d1':'UARL D1','uarl-open':'UARL OPEN',kmart:'KMART',sunoco:'SUNOCO','iracing-factory':'IRACING'}[id]||name||id);
  const programLogo={
    all:'/images/brand/aetherwing-logo.png',
    nrrs:'/images/schedule-logos/nrrs.png',
    kmart:'/images/schedule-logos/kmart-regular.jpg',
    sunoco:'/images/schedule-logos/sunoco.png',
    'uarl-d1':'/images/schedule-logos/uarl-d1.png',
    'uarl-open':'/images/schedule-logos/open.png',
    'iracing-factory':'/images/schedule-logos/iracing.png'
  };
  const rememberPublishedArt=(driverRows=[],profileRows=[])=>{
    for(const row of Array.isArray(driverRows)?driverRows:[]){
      if(!row?.id)continue;
      const current=assignments.find(entry=>entry.id===row.id);
      if(current&&row.number!==undefined&&String(row.number)!==String(current.number))continue;
      // Older art-only replies cannot prove that a Matty bitmap belongs to #3.
      // Empty fields are safe removals; the current APIs always include number.
      if(current?.id==='matty-kmart'&&current.currentRosterRevision&&String(current.number)==='3'&&row.number===undefined&&(row.numberImage||row.numberImageBackup))continue;
      const cached=publishedArtById.get(row.id)||{};
      const number=String(row.number??current?.number??cached.number??'');
      const previous=cached.number===number?cached:(current&&String(current.number)===number?current:{});
      publishedArtById.set(row.id,{
        number,
        // An explicit empty value means Admin removed/replaced this source.
        // Preserve cached art only when a partial payload omits the field.
        numberImageBackup:Object.hasOwn(row,'numberImageBackup')?row.numberImageBackup||'':previous.numberImageBackup||'',
        numberImage:Object.hasOwn(row,'numberImage')?row.numberImage||'':previous.numberImage||''
      });
    }
    for(const profile of Array.isArray(profileRows)?profileRows:[]){
      if(profile?.slug&&profile.signatureLogo)publishedSignatureBySlug.set(profile.slug,profile.signatureLogo);
    }
  };
  const assignmentWithPublishedArt=(entry)=>{
    const art=publishedArtById.get(entry?.id);
    return art&&art.number===String(entry.number)?{...entry,...art}:entry;
  };
  const profileWithPublishedSignature=(profile)=>profile&&publishedSignatureBySlug.has(profile.slug)?{...profile,signatureLogo:publishedSignatureBySlug.get(profile.slug)}:profile;
  const programFilter=(key,labelText)=>{const logo=programLogo[key]||'';const label=key==='all'?'All Drivers':labelText||key;return `<button type="button" data-program="${esc(key)}" aria-pressed="${series===key}" aria-label="${esc(label)}"><span class="aw-lineup__filter-logo">${logo?`<img src="${esc(logo)}" alt="" loading="lazy">`:`<b>${esc(label)}</b>`}</span><span>${esc(label)}</span></button>`;};
  const entryKind=entry=>entry.flex?'flexible':/^unsigned$/i.test(String(entry.status||'').trim())||/open charter|^open$|^unsigned (?:entry|seat)$/i.test(entry.displayName||'')?'open':'assigned';
  function render(){
    const rawActive=assignments.filter(e=>e.competitionId!=='iracing-factory'||profiles.some(person=>person.slug===e.profile)).map(assignmentWithPublishedArt);
    const sharedKmart29=rawActive.find(e=>e.competitionId==='kmart'&&String(e.number)==='29'&&e.numberImageBackup)||rawActive.find(e=>e.competitionId==='kmart'&&String(e.number)==='29'&&e.numberImage);
    const sharedKmartUpload=sharedKmart29?.numberImageBackup||'';
    const sharedKmartSource=sharedKmart29?.numberImage||sharedKmartUpload;
    const active=rawActive.map(e=>e.competitionId==='kmart'&&String(e.number)==='29'?{...e,numberImage:e.numberImage||sharedKmartSource,numberImageBackup:e.numberImageBackup||sharedKmartUpload}:e);
    const programs=new Map(active.map(e=>[e.competitionId,label(e)]));
    const intro=root.querySelector('[data-lineup-intro]');
    if(intro){const names=[...new Set(active.filter(row=>row.affiliation==='alliance').map(row=>organizationName(row)))];intro.textContent=names.length?`Aetherwing seats plus affiliated ${names.join(' / ')} rides. Number art leads each entry.`:'Aetherwing racing seats. Number art leads each entry.';}

    for(const board of charters)if(!programs.has(board.id))programs.set(board.id,board.label||board.id);
    if(series!=='all'&&!programs.has(series))series='all';
    const filters=root.querySelector('[data-lineup-filters]');
    filters.innerHTML=['all',...programs.keys()].map(k=>programFilter(k,k==='all'?'All Drivers':programs.get(k))).join('');
    filters.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{series=b.dataset.program;render();}));
    const leagueShown=active.filter(e=>e.competitionId===series).sort((a,b)=>Number(a.number)-Number(b.number)||String(a.displayName).localeCompare(String(b.displayName)));
    const groupedDrivers=()=>{
      const groups=new Map();
      for(const entry of active){
        const key=entry.profile||`${entry.displayName||'driver'}::${entry.affiliation||''}`;
        if(!groups.has(key))groups.set(key,[]);
        groups.get(key).push(entry);
      }
      return [...groups.entries()].map(([key,rows])=>{
        const person=profileWithPublishedSignature(profiles.find(profile=>profile.slug===rows[0]?.profile));
        const ordered=[...rows].sort((a,b)=>(programOrder[a.competitionId]||99)-(programOrder[b.competitionId]||99)||Number(a.number)-Number(b.number));
        const primary=ordered.find(entry=>entry.numberImage||entry.numberImageBackup)||ordered[0];
        const rides=ordered.map(entry=>({competitionId:entry.competitionId,program:programs.get(entry.competitionId)||label(entry),number:String(entry.number||''),status:entry.status||'Active',numberImage:entry.numberImage||'',numberImageBackup:entry.numberImageBackup||''}));
        const numbers=[...new Set(rides.map(ride=>ride.number).filter(Boolean))];
        const organizations=organizationNames(ordered);
        return {...primary,summary:true,profile:rows[0]?.profile||'',displayName:person?.name||primary?.displayName||key,number:numbers.join(' / '),numberImages:[],rides,programCount:new Set(rides.map(ride=>ride.competitionId)).size,affiliation:person?.affiliation||primary?.affiliation||'aetherwing',organizations,mixedAffiliation:organizations.length>1};
      }).sort((a,b)=>String(a.displayName).localeCompare(String(b.displayName)));
    };
    const shown=series==='all'?groupedDrivers():leagueShown;
    const board=charters.find(c=>c.id===series);
    const extra=(series==='all'?[]:(board?.fullTime||[]).filter(slot=>!shown.some(entry=>entry.number===String(slot.number))).map(slot=>{const unsigned=/^unsigned$/i.test(String(slot.status||'').trim());return{number:String(slot.number),numberImage:slot.numberImage||'',displayName:slot.driver==='Open'?(unsigned?'Unsigned entry':'Open charter'):slot.driver,status:slot.status||(slot.driver==='Open'?'Open charter':'Full-Time'),competitionId:series,affiliation:'aetherwing'};}));
    const flex=(series==='all'?[]:(board?.openCharters||[]).filter(c=>c.active!==false).map(c=>{const uses=(c.uses||[]).filter(u=>u.active!==false);return{number:uses.map(u=>u.number).join(' / '),numberImages:uses.map(u=>({number:String(u.number),image:u.numberImage||''})),displayName:c.label||'Flexible entry',status:c.slotLabel||'Part-time / development',competitionId:series,affiliation:'aetherwing',flex:true};}));
    const all=[...shown,...extra,...flex];
    const counts=all.reduce((totals,entry)=>{totals[entryKind(entry)]+=1;return totals;},{assigned:0,open:0,flexible:0});
    root.querySelector('[data-lineup-program]').innerHTML=series==='all'?`<span>AETHERWING + PARTNER TEAM DRIVER DIRECTORY</span><strong>${shown.length} DRIVERS · ONE CARD EACH</strong>`:`<span>${esc(programs.get(series)||series)} PROGRAM</span><strong>${counts.assigned} ASSIGNED · ${counts.open} OPEN · ${counts.flexible} FLEXIBLE ${counts.flexible===1?'ENTRY':'ENTRIES'}</strong><a href="/schedule/">View program schedule →</a>`;
    root.querySelector('[data-lineup-grid]').innerHTML=all.map(e=>{
      const person=profileWithPublishedSignature(profiles.find(p=>p.slug===e.profile)),open=entryKind(e)!=='assigned',alliance=e.affiliation==='alliance';
      const rides=(e.rides||[]);
      const stacked=(e.numberImages||[]);
      const rideNumbers=[...new Set(rides.map(ride=>String(ride.number||'')).filter(Boolean))];
      const uploadedByNumber=[];
      const seenUploadedNumbers=new Set();
      for(const ride of rides){
        const number=String(ride.number||'');
        const src=ride.numberImageBackup||ride.numberImage||'';
        if(!number||!src||seenUploadedNumbers.has(number))continue;
        seenUploadedNumbers.add(number);
        const secondary=ride.numberImageBackup&&ride.numberImage&&ride.numberImage!==ride.numberImageBackup?ride.numberImage:'';
        uploadedByNumber.push({number,src,backup:secondary});
      }
      const randomKey=e.profile||`${e.displayName||'driver'}::${e.affiliation||''}`;
      const chosenArt=e.summary?chooseDriverArt(randomKey,uploadedByNumber):null;
      const primaryNumber=String(e.summary?(chosenArt?.number||rideNumbers[0]||''):(e.number||'')).split(' / ')[0]||'';
      const correction=correctionFor(e.profile,primaryNumber);
      const artAttrs=` data-scale-desktop="${esc(correction.desktop??1)}" data-scale-mobile="${esc(correction.mobile??correction.desktop??1)}"`;
      const artSrc=e.summary?(chosenArt?.src||''):(e.numberImageBackup||e.numberImage||'');
      const backupSrc=e.summary?(chosenArt?.backup||''):(e.numberImageBackup?e.numberImage||'':'');
      const image=stacked.length
        ? `<div class="aw-lineup__number-stack">${stacked.map(item=>item.image?`<img src="${esc(item.image)}" alt="Number ${esc(item.number)}" decoding="async" fetchpriority="high"${artAttrs}>`:`<b class="aw-lineup__number-fallback is-single">#${esc(item.number)}</b>`).join('')}</div>`
        : artSrc
          ? `<img src="${esc(artSrc)}" alt="Number ${esc(primaryNumber||e.number)}" decoding="async" fetchpriority="high"${artAttrs}${backupSrc?` data-backup-src="${esc(backupSrc)}"`:''}>`
          : `<b class="aw-lineup__number-fallback is-single">#${esc(primaryNumber||e.number)}</b>`;
      const signature=person?.signatureLogo&&!open?`<div class="aw-lineup__signature" data-signature-driver="${esc(person.slug||'')}" aria-hidden="true"><img src="${esc(person.signatureLogo)}" alt="" decoding="async" fetchpriority="high"></div>`:'';
      const profile=person&&!open&&profileSlugs.includes(person.slug)?`<a href="/drivers/${encodeURIComponent(person.slug)}/" aria-label="View ${esc(person.name||e.displayName)} profile">View profile ↗</a>`:`<span>${open?'Program entry':'Driver profile coming soon'}</span>`;
      const summary=e.summary?`<div class="aw-lineup__summary-rides" aria-label="Current racing programs">${(rides||[]).map(ride=>`<span><b data-short="${esc(shortProgram(ride.competitionId,ride.program))}">${esc(ride.program)}</b>${ride.number?` <em>#${esc(ride.number)}</em>`:''}</span>`).join('')}</div>`:'';
      const topLine=e.summary?`${e.programCount||0} ACTIVE PROGRAM${e.programCount===1?'':'S'}${e.programCount===1&&rides[0]?.status?` · ${rides[0].status}`:''}`:`${programs.get(e.competitionId)||label(e)} · ${e.status||'ACTIVE'}`;
      const teamLabel=(e.summary?e.organizations:[organizationName(e,true)]).map(name=>name.toUpperCase()).join(' + ');
      const artMode=stacked.length?'stack':(artSrc?'single':'fallback');
      return `<article class="aw-lineup__poster ${open?'is-charter':''} ${alliance?'is-alliance':''} ${signature?'has-signature':''} ${e.summary?'is-driver-summary':''}" data-number="${esc(primaryNumber||e.number)}" data-primary-number="${esc(primaryNumber)}" data-art-pool="${esc(uploadedByNumber.map(item=>item.number).join(','))}" data-team-label="${esc(teamLabel)}"><div class="aw-lineup__number" data-art-mode="${artMode}">${image}</div><div class="aw-lineup__plate">${signature}<small>${esc(topLine)}</small><h3>${esc(open?e.displayName:(person?.name||e.displayName))}</h3><p>${esc(person?.handle&&!open?person.handle:(alliance?'AFFILIATED TEAM':'AETHERWING eMOTORSPORTS'))}</p>${summary}${profile}</div></article>`;
    }).join('')||'<p class="aw-lineup__empty">No roster entries have been published for this program.</p>';
    queueMicrotask(()=>root.querySelectorAll('.aw-lineup__number img').forEach(img=>{if(img.complete&&img.naturalWidth){tightenNumber(img);if(matchMedia('(max-width: 600px)').matches)requestAnimationFrame(()=>fitNumberVisual(img));}}));
  }
  const applyLineup=d=>{if(Array.isArray(d.drivers)){assignments=d.drivers;rememberPublishedArt(d.drivers,[]);}if(Array.isArray(d['roster-profiles'])){profiles=d['roster-profiles'];rememberPublishedArt([],d['roster-profiles']);}if(Array.isArray(d.charters))charters=d.charters;if(Array.isArray(d.alliances))organizations=d.alliances;render();};
  window.addEventListener('aetherwing:content',e=>applyLineup(e.detail||{}));
  const applyArtPayload=(payload)=>{
    if(!payload)return false;
    const driverRows=Array.isArray(payload.drivers)?payload.drivers:Array.isArray(payload.datasets?.drivers)?payload.datasets.drivers:[];
    const profileRows=Array.isArray(payload.profiles)?payload.profiles:Array.isArray(payload.datasets?.['roster-profiles'])?payload.datasets['roster-profiles']:[];
    if(!driverRows.length&&!profileRows.length)return false;
    rememberPublishedArt(driverRows,profileRows);
    render();
    return driverRows.some(row=>row?.numberImageBackup||row?.numberImage)||profileRows.some(profile=>profile?.signatureLogo);
  };
  const fetchJson=async(url)=>{const response=await fetch(url,{cache:'no-store',headers:{Accept:'application/json'}});if(!response.ok)throw new Error(`HTTP ${response.status}`);return response.json();};
  const hydrateDriverArtwork=async(attempt=0)=>{
    try{
      const payload=await fetchJson(`/api/driver-art?v=${Date.now()}`);
      if(applyArtPayload(payload))return true;
    }catch{}
    try{
      const payload=await fetchJson(`/api/site-content?v=${Date.now()}`);
      if(applyArtPayload(payload))return true;
    }catch{}
    if(attempt<3){setTimeout(()=>hydrateDriverArtwork(attempt+1),[700,1600,3200,5200][attempt]||5200);}
    return false;
  };
  window.addEventListener('pageshow',()=>hydrateDriverArtwork(0));
  document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')hydrateDriverArtwork(0);});
  let resizeFrame=0;window.addEventListener('resize',()=>{cancelAnimationFrame(resizeFrame);resizeFrame=requestAnimationFrame(()=>{if(matchMedia('(max-width: 600px)').matches)root.querySelectorAll('.aw-lineup__number img').forEach(fitNumberVisual);});},{passive:true});
  render();
  if(window.__AETHERWING_CONTENT__)applyLineup(window.__AETHERWING_CONTENT__);
  hydrateDriverArtwork(0);
})();
</script>

<script is:inline type="application/json" data-planned-charters-seed set:html={JSON.stringify(charterPlans).replace(/</g,'\\u003c')}/>
<script>
  import { plannedCharterNotes, reconcileCharterPlans } from '../lib/charter-plans.mjs';
  const root=document.querySelector('[data-lineup]');
  const note=root?.querySelector('[data-planned-charters]');
  if(root&&note){
    const seed=JSON.parse(document.querySelector('[data-planned-charters-seed]').textContent);
    let plans=seed;
    const renderPlanNote=()=>{
      const selected=root.querySelector('[data-program][aria-pressed="true"]')?.getAttribute('data-program');
      const notes=selected==='nrrs'?plannedCharterNotes(plans.find(board=>board?.id==='nrrs')):[];
      note.hidden=!notes.length;
      note.textContent=notes.length?`${notes.join(' ')} Current entries remain unchanged.`:'';
    };
    const applyPlans=(datasets)=>{
      if(Array.isArray(datasets?.charters))plans=reconcileCharterPlans(datasets.charters,seed);
      renderPlanNote();
    };
    root.addEventListener('click',renderPlanNote);
    window.addEventListener('aetherwing:content',({detail})=>applyPlans(detail));
    applyPlans(window.__AETHERWING_CONTENT__);
  }
</script>
